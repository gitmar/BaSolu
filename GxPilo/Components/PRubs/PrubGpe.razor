     private async ValueTask OnLocationChangingAsync(LocationChangingContext context)
    {
        Console.WriteLine($"🌐 Intercepted: {context.TargetLocation}");

        if (!_guard.HasPendingChanges())
        {
            Console.WriteLine("✅ Clean - allowing navigation");
            return;
        }

        context.PreventNavigation();  // BLOCK navigation
        Console.WriteLine($"🚫 Showing confirm dialog {context.TargetLocation}");

        try
        {
            var save = await _JsRUN.InvokeAsync<bool>("confirm", "Save changes before leaving?");

            if (save)
            {
                // 🔥 YES: SaveAllChanges() → Navigate away
                await SaveAllChanges();
                Console.WriteLine("💾 Saved - navigating away");
                _messageService.Show("✅ Saved successfully", ToastType.Success);
                _navManager.NavigateTo(context.TargetLocation, forceLoad: false);
            }
            else
            {
                // 🔥 NO: STAY on page - NO CancelAllChanges()
                Console.WriteLine("❌ User chose NO - staying on page");
                // User stays - sees SaveAllChanges() / CancelAllChanges() buttons ENABLED
                // They can now manually: SaveAllChanges() OR CancelAllChanges()
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error: {ex.Message}");
            // Safety: stay on page
        }
    }
    protected override void OnLocalCollectionMutated(EntityLevel level, CollectionMutation mutation, object entity)
    {
        switch (level)
        {
            case EntityLevel.Gtb when entity is GstablDto gtb:
                SyncList(orgTbls, gtb, mutation);
                break;
            case EntityLevel.Gt2 when entity is GstablDto gt2 && curGtb is not null:
                SyncList(orgTbls, gt2, mutation);
                break;
        }
    }

    private static void SyncList<T>(List<T> list, T entity, CollectionMutation mutation) where T : class
    {
        var rowguid = MLEntityKeyHelper.GetRowguidAsGuid(entity);
        switch (mutation)
        {
            case CollectionMutation.Added:
            case CollectionMutation.Replaced:
                var idx = list.FindIndex(x => MLEntityKeyHelper.GetRowguidAsGuid(x) == rowguid);
                if (idx >= 0) list[idx] = entity; else list.Add(entity);
                break;
            case CollectionMutation.Removed:
                list.RemoveAll(x => MLEntityKeyHelper.GetRowguidAsGuid(x) == rowguid);
                break;
        }
    }
    bool AreRowsEqual(GstablDto row1, GstablDto row2) =>
        row1.Liba == row2.Liba && row1.Abg == row2.Abg;
    private int NextSeq<T>(IEnumerable<T> source, Func<T, int?> selector)
    {
        int maxSeq = source.Any() ? source.Max(selector) ?? 0 : 0;
        return maxSeq + 1;
    }
