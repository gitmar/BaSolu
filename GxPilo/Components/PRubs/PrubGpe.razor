<!-- InscTiewComponent.razor -->
<PageTitle>Table.Tables</PageTitle>

@if (!isAuthenticated)
{
    <Button Color="ButtonColor.Warning" Size="ButtonSize.Small"
            @onclick="() => SeReConnecter()">
        se Reconnecter
    </Button>
}
@if (isLoading)
{
    <div class="text-center">
        <Spinner Color="SpinnerColor.Primary" Size="SpinnerSize.Medium" />
        <p>Table.Tables Loading...</p>
    </div>
}
else
{
    <div class="d-flex flex-column">
        <div class="my-container">
            @if (toChild != null)
            {
                @ChildContent
            }
        </div>
    </div>
    <AuthorizeView>
        <Authorized Context="AuthContext">
            <div class="row">
                <div class="col-md-12 input-group align-middle">
                    &nbsp;&nbsp;
                    @if (!String.IsNullOrEmpty(Imessage))
                    {
                        <span class="bg-info bg-opacity-10" style="font-style:italic;color:red">&nbsp;--> @Imessage</span>
                    }
                </div>
            </div>
            <span>@curPlan.Liba</span>
            <div class="container-fluid-fixed-top">
                @if (gIdorg == 0)
                {
                    <p style="color:red;">Warning: current Institution is unexpectedly null.</p>
                }
                else
                {
                    <EditForm Context="invform" Model="@curPlan">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <div class="row">
                            @if (!String.IsNullOrEmpty(Kmessage))
                            {
                                <span class="bg-info bg-opacity-10" style="font-style:italic;color:red">&nbsp;--> @Jmessage</span>
                            }
                        </div>
                        <div class="row">
                                @*//Gvars = 4, Itb = 4, Gtyp = IMyGtbl, //2optionnel1integre
                                //.Where(ti => ti.Gtyp == IMyGtbl && ti.Ktyp == IMyBas)" *@
                                <!--Contenu des tables-->

                                <Grid TItem="GstablDto"
                                      Data="@MyDaGtbs"
                                      @key="GetRenderKey(EntityLevel.Gtb)"
                                      AllowRowClick="true"
                                      OnRowClick="OnGtbRowClick"
                                      AllowDetailView="true"
                                      AllowPaging="true"
                                      RowClass="@((item) => GetGtbRowClass(item))"
                                      Responsive="true">
                                    <GridColumns>
                                        <GridColumn TItem="GstablDto" HeaderText="No" Class="xcol1">
                                            <ChildContent Context="item">
                                                @if (item.Xadd1 == -1)
                                                {
                                                    <span>@item?.Iui</span>
                                                }
                                                else
                                                {
                                                    <span>@(item.Xedt1 == -1 ? item?.Iui : (item?.Iui == 0 ? item?.Iele : item?.Iui))</span>
                                                }
                                            </ChildContent>
                                        </GridColumn>
                                        <GridColumn TItem="GstablDto" HeaderText="Designation" Class="xcol3">
                                            <ChildContent Context="item">
                                                @if (GetRowState(EntityLevel.Gtb, item.Rowguid) is RowState.AddPending or RowState.EditPending)
                                                {

                                                    <InputText @bind-Value="draftGtb.Liba" />
                                                }
                                                else
                                                {
                                                    @item.Liba
                                                }
                                            </ChildContent>
                                        </GridColumn>
                                        <GridColumn TItem="GstablDto" HeaderText="abrege" Class="xcol2">
                                            <ChildContent Context="item">
                                                @if (GetRowState(EntityLevel.Gtb, item.Rowguid) is RowState.AddPending or RowState.EditPending)
                                                {

                                                    <InputText @bind-Value="draftGtb.Abg" />
                                                }
                                                else
                                                {
                                                    @item.Abg
                                                }
                                            </ChildContent>
                                        </GridColumn>
                                        <GridColumn TItem="GstablDto" HeaderText="Eta" Class="xcol1">
                                            <HeaderContent>
                                                <button class="btn btn-primary btn-sm @(IsLevelBusy(EntityLevel.Gtb) ? "disabled-action" : "")"
                                                       @onclick="() => StartGtbNew()">
                                                   <span style="display:inline-flex; align-items:center; gap:2px;">
                                                        <span>➕</span>
                                                        <span>Add</span>
                                                    </span>
                                                </button>
                                            </HeaderContent>
                                            <ChildContent Context="item">
                                                @if (GetRowState(EntityLevel.Gtb, item.Rowguid) is RowState.AddPending or RowState.EditPending)
                                                {
                                                    <InputSelect @bind-Value="draftGtb.Eta">
                                                        <option class="jchx" value=0>?choisir</option>
                                                        @foreach (var tob in LsFixes.Where(ut => ut.Gvars == 32 && ut.Itb == 1 && ut.Elea != 0))
                                                        {
                                                            <option value=@tob.Elea>@tob.Liba</option>
                                                        }
                                                    </InputSelect>
                                                }
                                                else
                                                {
                                                    <InputSelect @bind-Value="item.Eta" disabled="true">
                                                        <option class="jchx" value=0>?choisir</option>
                                                        @foreach (var tob in LsFixes.Where(ut => ut.Gvars == 32 && ut.Itb == 1 && ut.Elea != 0))
                                                        {
                                                            <option value=@tob.Elea>@tob.Liba</option>
                                                        }
                                                    </InputSelect>
                                                }
                                            </ChildContent> 
                                        </GridColumn>
                                        <GridColumn TItem="GstablDto" HeaderText="Actions" Filterable="false" Class="xcol2 actions-col">
                                            <ChildContent Context="item">
                                                @switch (GetRowState(EntityLevel.Gtb, item.Rowguid))
                                                {
                                                    case RowState.Locked:
                                                        <span class="text-muted">—</span>
                                                        break;
                                                    case RowState.AddPending:
                                                        <Button Color="ButtonColor.Success" Size="ButtonSize.Small"
                                                                @onclick="() => ConfirmAdd(EntityLevel.Gtb, draftGtb, true)">
                                                            ✅ Confirm
                                                        </Button>
                                                        <Button Color="ButtonColor.Success" Size="ButtonSize.Small"
                                                                @onclick="() => StartCancelAdd(EntityLevel.Gtb, draftGtb)">
                                                            ❌ Cancel
                                                        </Button>
                                                        break;

                                                    case RowState.DeletePending:
                                                        <Button Color="ButtonColor.Danger" Size="ButtonSize.Small"
                                                                @onclick="() => ConfirmDelete(EntityLevel.Gt2, item, true)">
                                                            ⚠️ Confirm
                                                        </Button>
                                                        <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small"
                                                                @onclick="() => CancelDelete(EntityLevel.Gt2, item)">
                                                            ❎ Cancel
                                                        </Button>
                                                        break;
                                                    case RowState.EditPending:
                                                        @if (draftGtb != null)
                                                        {
                                                            <Button Color="ButtonColor.Success" Size="ButtonSize.Small"
                                                            @onclick="() => ConfirmEdit(EntityLevel.Gtb, draftGtb, true)">
                                                                ✅ Confirm
                                                            </Button>
                                                            <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small"
                                                            @onclick="() => CancelEdit(EntityLevel.Gtb, item)">
                                                                ❌ Cancel
                                                            </Button>
                                                        }
                                                        break;
                                                    default:
                                                        <Button Color="ButtonColor.Warning" Size="ButtonSize.Small"
                                                                @onclick="() => StartGtbEdit(item)">
                                                            ✏️ Edit
                                                        </Button>
                                                        @if (item.Eaut != 9)
                                                        {
                                                            <Button Color="ButtonColor.Danger" Size="ButtonSize.Small"
                                                                    @onclick="() => StartRowDelete(EntityLevel.Gtb, item.Rowguid)">
                                                                🗑 Delete
                                                            </Button>
                                                        }
                                                        break;
                                                }
                                            </ChildContent>
                                        </GridColumn>
                                    </GridColumns>
                                    <GridDetailView TItem="GstablDto" Context="selectedGtb">
                                        <Grid TItem="GstablDto"
                                              Data="@MyDaGt2s.ToList()"
                                              
                                              AllowPaging="true"
                                              Responsive="true">
                                            <GridColumns>
                                                <GridColumn TItem="GstablDto" HeaderText="No" Class="xcol1">
                                                    <ChildContent Context="item">
                                                        @if (item.Xadd1 == -1)
                                                        {
                                                            <span>?@item?.Iui</span>
                                                        }
                                                        else
                                                        {
                                                            <span>
                                                                @(item.Xedt1 == -1 ? item?.Iui : item?.Iele)
                                                            </span>
                                                        }
                                                    </ChildContent>
                                                </GridColumn>
                                                <GridColumn TItem="GstablDto" HeaderText="Designation" Class="xcol2">
                                                    <ChildContent Context="item">
                                                        @if (GetRowState(EntityLevel.Gt2, item.Rowguid) is RowState.AddPending or RowState.EditPending)
                                                    {
                                                        <InputSelect @bind-Value="draftGt2.Ftcol" class="me-3" style="width:auto">
                                                            <option value="">?choisir</option>
                                                            @foreach (var ur in curPlan.Rubvars)
                                                            {
                                                                <option value="@ur.Scdrub">@ur.Liba</option>
                                                            }
                                                        </InputSelect>
                                                    }
                                                    else
                                                    {
                                                        <InputSelect @bind-Value="item.Ftcol" class="me-3" style="width:auto" disabled>
                                                            <option value="">?choisir</option>
                                                            @foreach (var ur in curPlan.Rubvars)
                                                            {
                                                                <option value="@ur.Scdrub">@ur.Liba</option>
                                                            }
                                                        </InputSelect>
                                                    }
                                                    </ChildContent>
                                                </GridColumn>
                                                <GridColumn TItem="GstablDto" HeaderText="Code" Class="xcol1">
                                                    <ChildContent Context="item">
                                                        @if (GetRowState(EntityLevel.Gt2, item.Rowguid) is RowState.AddPending or RowState.EditPending)
                                                    {
                                                        <InputSelect @bind-Value="draftGt2.Ftcol" class="me-3" style="width:auto">
                                                            <option value="">?choisir</option>
                                                            @foreach (var ur in curPlan.Rubvars)
                                                            {
                                                                <option value="@ur.Scdrub">@ur.Scdrub</option>
                                                            }
                                                        </InputSelect>
                                                    }
                                                    else
                                                    {
                                                        <InputSelect @bind-Value="item.Ftcol" class="me-3" style="width:auto" disabled>
                                                            <option value="">?choisir</option>
                                                            @foreach (var ur in curPlan.Rubvars)
                                                            {
                                                                <option value="@ur.Scdrub">@ur.Scdrub</option>
                                                            }
                                                        </InputSelect>
                                                    }
                                                    </ChildContent>
                                                </GridColumn>
                                                <GridColumn TItem="GstablDto" HeaderText="Eta" Class="xcol2">
                                                    <HeaderContent>
                                                        @if (selectedGtb != null)
                                                        {
                                                           <button class="btn btn-primary btn-sm @(AllowMultipleEdits || !IsLevelBusy(EntityLevel.Gt2) ? "" : "disabled-action")"
                                                                disabled="@(!AllowMultipleEdits && IsLevelBusy(EntityLevel.Gt2))"
                                                                @onclick="() => StartGt2New(selectedGtb)">
                                                            ➕ Add
                                                            </button>
                                                        }
                                                    </HeaderContent>
                                                    <ChildContent Context="item">
                                                        @if (GetRowState(EntityLevel.Gt2, item.Rowguid) is RowState.AddPending or RowState.EditPending)
                                                        { // show draftGtb inputs
                                                          <InputSelect @bind-Value="draftGt2.Eta" class="col-md-1" style="width:auto">
                                                              <option class="jchx" value=0>?etat</option>
                                                                @foreach (var tob in LsFixes.Where(ut => ut.Gvars == 32 && ut.Itb == 1 && ut.Elea != 0))
                                                                {
                                                                    <option value=@tob.Elea>@tob.Liba</option>
                                                                }
                                                            </InputSelect>
                                                        }
                                                        else
                                                        { // show item as read-only
                                                          <InputSelect @bind-Value="item.Eta" class="col-md-1" style="width:auto" disabled>
                                                              <option class="jchx" value=0>?etat</option>
                                                                @foreach (var tob in LsFixes.Where(ut => ut.Gvars == 32 && ut.Itb == 1 && ut.Elea != 0))
                                                                {
                                                                    <option value=@tob.Elea>@tob.Liba</option>
                                                                }
                                                            </InputSelect>
                                                        }
                                                    </ChildContent>
                                                </GridColumn>
                                                <GridColumn TItem="GstablDto" HeaderText="Actions" Filterable="false" Class="xcol2 actions-col">
                                                    <HeaderContent>
                                                        @if (!isFiltre)
                                                        {
                                                            @* <button class="btn btn-info btn-sm" @onclick="ToggleRubFiltering">
                                                                @(isRubFilteringEnabled ? "🚫 Out Filter" : "🔍 In Filter")
                                                            </button> *@
                                                        }
                                                    </HeaderContent>
                                                    <ChildContent Context="item">
                                                        @switch (GetRowState(EntityLevel.Gt2, item.Rowguid))
                                                        {
                                                            case RowState.Locked:
                                                                <span class="text-muted">—</span>
                                                                break;
                                                            case RowState.AddPending:
                                                                <Button Color="ButtonColor.Success" Size="ButtonSize.Small"
                                                                        @onclick="() => ConfirmAdd(EntityLevel.Gt2, draftGt2, true)">
                                                                    ✅ Confirm
                                                                </Button>
                                                                <Button Color="ButtonColor.Success" Size="ButtonSize.Small"
                                                                    @onclick="() => StartCancelAdd(EntityLevel.Gt2, draftGt2)">
                                                                ❌ Cancel
                                                                </Button>
                                                                break;
                                                            case RowState.DeletePending:
                                                                <Button Color="ButtonColor.Danger" Size="ButtonSize.Small"
                                                                        @onclick="() => ConfirmDelete(EntityLevel.Gt2, item, true)">
                                                                    ⚠️ Confirm
                                                                </Button>
                                                                <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small"
                                                                        @onclick="() => CancelDelete(EntityLevel.Gt2, item)">
                                                                    ❎ Cancel
                                                                </Button>
                                                                break;
                                                            case RowState.EditPending:
                                                                @if (draftGt2 != null)
                                                                {
                                                                    <Button Color="ButtonColor.Success" Size="ButtonSize.Small"
                                                                    @onclick="() => ConfirmEdit(EntityLevel.Gt2, draftGt2, true)">
                                                                        ✅ Confirm
                                                                    </Button>
                                                                    <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small"
                                                                    @onclick="() => CancelEdit(EntityLevel.Gt2, item)">
                                                                        ❌ Cancel
                                                                    </Button>
                                                                }
                                                                break;
                                                            default:
                                                                <Button Color="ButtonColor.Warning" Size="ButtonSize.Small"
                                                                        @onclick="() => StartGt2Edit(item)">
                                                                    ✏️ Edit
                                                                </Button>
                                                                <Button Color="ButtonColor.Danger" Size="ButtonSize.Small"
                                                                        @onclick="() => StartRowDelete(EntityLevel.Gt2, item.Rowguid)">
                                                                    🗑 Delete
                                                                </Button>
                                                                break;
                                                        }
                                                    </ChildContent>
                                                </GridColumn>
                                            </GridColumns>
                                        </Grid>
                                    </GridDetailView>
                                </Grid>
                        </div>
                    </EditForm>
                }
            </div>
        </Authorized>
    </AuthorizeView>
}
<style>
    .modal-wide .modal-dialog {
        max-width: 50vw;
        width: auto;
        margin: auto;
    }

    .rubModal-wide .modal-dialog {
        max-width: 65vw;
        width: auto;
        margin: auto;
    }

    .disabled-action {
        pointer-events: none;
        opacity: 0.5;
    }

