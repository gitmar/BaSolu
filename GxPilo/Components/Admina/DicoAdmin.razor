@page "/dicoadmin"
@layout ExadMenu

@using System.Net.Http.Json
@* @using GxDicto.DModels
@using GxDicto.Components *@
@using GxShared.GxDtos
@using GxShared.InDtos
@using GxShared.Sess
@using GxShared.Helpers

@inject IHttpClientFactory _httpClientFactory

@* <h3>Localized Admin</h3> *@

<div class="row mb-3 align-items-end">
    <div class="col-auto">
        <label class="form-label me-2">Language</label>
    </div>
    <div class="col-auto">
        <InputSelect class="form-select" @bind-Value="selectedLanguage">
            <option value="">?choisir</option>
            @foreach (var lang in languages.ToList())
            {
                <option value="@lang.Abg">@lang.Liba</option>
            }
        </InputSelect>
    </div>
</div>
 @* LsVars.Where(gv => gv.Gvars == 3 && gv.Itb == 11 && gv.Elea != 0) *@
<div class="d-flex align-items-center mb-2 gap-2">
    <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="AddNewRow">Add Row</Button>
    <Button Color="ButtonColor.Success" Size="ButtonSize.Small" @onclick="SaveAll" disabled="@(changedRows.Count == 0)">
        Save Changes
    </Button>
    <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="AllEdit">ToutEditer</Button>
    @if (isallEdit)
    {
        <Button Color="ButtonColor.Warning" Size="ButtonSize.Small" @onclick="AllCancelEdit">ToutRefuser</Button>
        <Button Color="ButtonColor.Success" Size="ButtonSize.Small" @onclick="AllUpdateEdit">ToutAccepter</Button>
    }
    <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small" @onclick="LoadEntries">Refresh</Button>
</div>

@if (Entries == null)
{
    <p>Loading...</p>
}
else if (!Entries.Any())
{
    <p>No entries found.</p>
}
else
{
    <span class="text-muted">Showing @filteredEntries.Count of @Entries.Count entries for language '@selectedLanguage'</span>
    <div class="row align-items-center">
    <Grid @ref="locgrid" TItem="LocalizedDto"
          Data="@filteredEntries"
          AllowPaging="true"
          AllowSorting="true"
          Responsive="true">
        <GridColumns>
            <GridColumn TItem="LocalizedDto" HeaderText="No" Class="xcol1">
                <ChildContent Context="item">
                    @item.Iele
                </ChildContent>
            </GridColumn>
            <GridColumn TItem="LocalizedDto" HeaderText="Original" Class="xcol4">
                <ChildContent Context="item">
                    @if (changedRows.Contains(item))
                    {
                            if (item.Id == 0)
                            { //new row
                              <InputText class="form-control" @bind-Value="item.BaseValue" />
                            }
                            else
                            {
                                @item.BaseValue
                            }
                    }
                    else
                    {
                        @item.BaseValue
                    }
                </ChildContent>
            </GridColumn>
            <GridColumn TItem="LocalizedDto" HeaderText="Personalise" Class="xcol4">
                <ChildContent Context="item">
                    @if (changedRows.Contains(item))
                    {
                        <InputText class="form-control" @bind-Value="item.Value" />
                    }
                    else
                    {
                        @item.Value
                    }
                </ChildContent>
            </GridColumn>
            <GridColumn TItem="LocalizedDto" HeaderText="Actions" Class="xcol3">
                <ChildContent Context="item">
                    @* 1. Pending delete mode *@
                        <div class="d-flex align-items-center gap-1">
                    @if (pendingDeletes.Contains(item))
                    {
                        <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => CancelDelete(item)">Cancel</button>
                        <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => ConfirmDelete(item)">Confirm</button>
                    }
                    else if (changedRows.Contains(item))
                    {
                        @* 2. Row in edit mode *@
                        @if (item.Id == 0 && pendingNewRows.Contains(item))
                        {
                            @* Newly added row, not yet confirmed: Remove / Confirm *@
                            <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => RemoveNewRow(item)">Remove</button>
                            <button class="btn btn-sm btn-outline-success ms-1" @onclick="() => ConfirmNewRow(item)">Confirm</button>
                        }
                        else
                        {
                            @* Existing row in edit mode: Cancel / Update *@
                            <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => CancelEdit(item)">Cancel</button>
                            <button class="btn btn-sm btn-outline-success ms-1" @onclick="() => UpdateRow(item)">Update</button>
                        }
                    }
                    else
                    {
                        @* 3. Standard read-only row: Edit / Delete *@
                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => BeginEdit(item)">Edit</button>
                        if (item.SiuAdd == 1)
                        { //si added by user
                            <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => MarkForDelete(item)">Delete</button>
                        }
                    }
                    </div>
                </ChildContent>
            </GridColumn>
        </GridColumns>
    </Grid>
    </div>
}
<style>
    .xcolx {
        width: 40px !important;
    }

    .xcol1 {
        width: 60px;
    }

    .xcol2 {
        width: 120px;
    }

    .xcol3 {
        width: 180px;
    }

    .xcol4 {
        width: 240px;
    }
        /* Ensure inputs inside these columns fill the width */
        .xcol1 input,
        .xcol2 input,
        .xcol3 input,
        .xcol4 input {
            width: 100%;
            box-sizing: border-box; /* prevents overflow due to padding/border */
        }
</style>
@code {
    [Parameter]
    public int IdcOrg { get; set; } = 0;
    [Parameter]
    public List<Gpvar> LsVars { get; set; }

    private List<LocalizedDto> Entries = new();
    private List<LocalizedDto> filteredEntries = new();

    private HashSet<LocalizedDto> changedRows = new();        // in edit mode
    private HashSet<LocalizedDto> pendingDeletes = new();     // rows marked for deletion
    private HashSet<LocalizedDto> pendingNewRows = new();     // newly added, not yet confirmed

    private Dictionary<int, LocalizedDto> originalValues = new();
    private HttpClient _apiClient = default!;
    private List<Gpvar> languages = new();
    private string _selectedLanguage = "fr";

    private Grid<LocalizedDto>? locgrid;
    private int firstAdding = 1;
    private bool isallEdit = false;

    private string selectedLanguage
    {
        get => _selectedLanguage;
        set
        {
            if (_selectedLanguage == value)
                return;

            _selectedLanguage = value;
            OnLanguageChanged();
        }
    }
    List<LocalizedDto> sqEntries => Entries.Where(ue => ue.Idorg == IdcOrg && ue.Language == selectedLanguage).ToList();

    protected override async Task OnInitializedAsync()
    {
        _apiClient = _httpClientFactory.CreateClient("LocalClient");
        //test
        ////languages.Add("fr");
        ////languages.Add("en");
        //end test
        await LoadLanguages();
        await LoadEntries();
    }

    private async Task LoadLanguages()
    {
        languages = LsVars.Where(uv => uv.Gvars == 3 && uv.Itb == 11).ToList();
        if (!languages.Any())
            selectedLanguage = "fr";
    }
    private void AllEdit()
    {
        if (isallEdit) 
        { 
            isallEdit = false;
            foreach (var ety in Entries)
            {
                CancelEdit(ety);
            }
            StateHasChanged();
        } 
        else
        {
            isallEdit = true;
            foreach (var ety in Entries)
            {
                BeginEdit(ety);
            }
        }
    }
    private async Task LoadEntries()
    {
        changedRows.Clear();
        pendingDeletes.Clear();
        pendingNewRows.Clear();
        originalValues.Clear();

        Entries = await _apiClient.GetFromJsonAsync<List<LocalizedDto>>(
              $"localization/{IdcOrg}/admin/entries")
          ?? new List<LocalizedDto>();

        ApplyFilter();

        Entries = Entries.ToList();
        StateHasChanged();
    }

    private void ApplyFilter()
    {
        filteredEntries = Entries
            .Where(e => e.Language == selectedLanguage)
            .ToList();

        Console.WriteLine(
            $"ApplyFilter: selectedLanguage={selectedLanguage}, " +
            $"Entries.Count={Entries.Count}, filteredEntries.Count={filteredEntries.Count}");
    }

    private void OnLanguageChanged()
    {
        ApplyFilter();
        StateHasChanged();
    }

    private async Task AddNewRow()
    {
        var lnb = await NextSeq(sqEntries, p => p.Iele);

        var newEntry = new LocalizedDto
        {
            ClientRowId = Guid.NewGuid(),
            Language = selectedLanguage,
            Idorg = IdcOrg,
            SiuAdd = 1, //added by user
            Iele = lnb
        };

        Entries.Insert(0, newEntry);

        changedRows.Add(newEntry);
        pendingNewRows.Add(newEntry);

        ApplyFilter();

        if (locgrid is not null && firstAdding == 1)
            await locgrid.RefreshDataAsync();
        firstAdding = firstAdding + 1;
        StateHasChanged();
    }

    private void BeginEdit(LocalizedDto entry)
    {
        if (changedRows.Contains(entry) || pendingDeletes.Contains(entry))
            return;

        changedRows.Add(entry);

        if (entry.Id != 0)
        {
            originalValues[entry.Id] = new LocalizedDto
            {
                Id = entry.Id,
                Idorg = entry.Idorg,
                Key = entry.Key,
                Language = entry.Language,
                Value = entry.Value,
                BaseValue = entry.BaseValue,
                SiuAdd = entry.SiuAdd,
                Iele = entry.Iele
            };
        }

        if (!isallEdit) StateHasChanged();
    }

    private void CancelEdit(LocalizedDto entry)
    {
        Console.WriteLine($"CancelEdit called for Id={entry.Id}, Key={entry.Key}");

        if (pendingDeletes.Contains(entry))
        {
            Console.WriteLine("CancelEdit: exiting because row is in pendingDeletes");
            return;
        }

        if (!changedRows.Contains(entry))
        {
            Console.WriteLine("CancelEdit: exiting because row is NOT in changedRows");
            return;
        }

        if (entry.Id == 0)
        {
            // New row: just remove it (same as RemoveNewRow)
            Console.WriteLine("CancelEdit: removing new row (Id=0)");

            Entries.Remove(entry);
            pendingNewRows.Remove(entry);
            changedRows.Remove(entry);
            originalValues.Remove(entry.Id);
            Entries = Entries.ToList();
            StateHasChanged();
            return;
        }

        // Existing row: restore original values
        if (originalValues.TryGetValue(entry.Id, out var original))
        {
            Console.WriteLine($"CancelEdit: restoring original -> Key={original.Key}, Language={original.Language}, Value={original.Value}");

            entry.Key = original.Key;
            entry.Idorg = original.Idorg;
            entry.Language = original.Language;
            entry.Value = original.Value;
            entry.BaseValue = original.BaseValue;
            entry.SiuAdd = original.SiuAdd;
            entry.Iele = original.Iele;
        }
        else
        {
            Console.WriteLine($"CancelEdit: no original stored (Id={entry.Id})");
        }

        changedRows.Remove(entry);
        originalValues.Remove(entry.Id);

        Entries = Entries.ToList();
        if (!isallEdit) StateHasChanged();

        Console.WriteLine("CancelEdit: finished");
    }
    private void AllCancelEdit()
    {
        isallEdit = false;
        foreach(var ety in Entries)
        {
            CancelEdit(ety);
        }
        StateHasChanged();
    }
    private void AllUpdateEdit()
    {
        isallEdit = false;
        foreach(var ety in Entries)
        {
            UpdateRow(ety);
        }
        StateHasChanged();
    }
    private void UpdateRow(LocalizedDto entry)
    {
        // Just exit edit mode; actual save is done by SaveAll.
        changedRows.Remove(entry);
        originalValues.Remove(entry.Id);

        if (!isallEdit) StateHasChanged();
    }

    private void MarkForDelete(LocalizedDto entry)
    {
        if (pendingDeletes.Contains(entry))
            return;

        pendingDeletes.Add(entry);

        // If it was in edit mode, leave edit mode
        changedRows.Remove(entry);
        originalValues.Remove(entry.Id);

        StateHasChanged();
    }

    private void CancelDelete(LocalizedDto entry)
    {
        if (!pendingDeletes.Contains(entry))
            return;

        pendingDeletes.Remove(entry);

        StateHasChanged();
    }

    private async Task ConfirmDelete(LocalizedDto entry)
    {
        if (entry.Id == 0)
        {
            // New row: just remove from list
            Entries.Remove(entry);
            pendingNewRows.Remove(entry);
            changedRows.Remove(entry);

            Entries = Entries.ToList();
            StateHasChanged();
            return;
        }

        var response = await _apiClient.DeleteAsync(
            $"localization/{IdcOrg}/admin/entries/{entry.Id}");
        response.EnsureSuccessStatusCode();

        Entries.Remove(entry);
        pendingDeletes.Remove(entry);
        originalValues.Remove(entry.Id);

        Entries = Entries.ToList();
        StateHasChanged();
    }

    private void RemoveNewRow(LocalizedDto entry)
    {
        if (entry is null || entry.Id != 0)
            return;

        var clientRowId = entry.ClientRowId;

        var isPending = pendingNewRows.Any(x =>
            x.ClientRowId == clientRowId);

        if (!isPending)
            return;

        Entries.RemoveAll(x =>
            x.ClientRowId == clientRowId);

        pendingNewRows.RemoveWhere(x =>
            x.ClientRowId == clientRowId);

        changedRows.RemoveWhere(x =>
            x.ClientRowId == clientRowId);

        ApplyFilter();

        StateHasChanged();
    }

    private void ConfirmNewRow(LocalizedDto entry)
    {
        if (entry.Id != 0 || !pendingNewRows.Contains(entry))
            return;

        // Row becomes a normal (unsaved) row: leave edit mode and pending-new state
        pendingNewRows.Remove(entry);
        changedRows.Remove(entry);
        originalValues.Remove(entry.Id);

        Entries = Entries.ToList();
        StateHasChanged();
    }

    private async Task SaveAll()
    {
        if (changedRows.Count == 0)
            return;

        // Insert new rows (Id == 0 and in changedRows)
        var toInsert = changedRows.Where(e => e.Id == 0).ToList();

        // Update existing edited rows (Id != 0 and in changedRows)
        var toUpdate = changedRows.Where(e => e.Id != 0).ToList();

        foreach (var entry in toInsert)
        {
            var response = await _apiClient.PostAsJsonAsync(
                $"localization/{IdcOrg}/admin/entries", entry);
            response.EnsureSuccessStatusCode();

            var saved = await response.Content.ReadFromJsonAsync<LocalizedDto>();
            if (saved != null && saved.Id != 0)
            {
                entry.Id = saved.Id;
            }
        }

        foreach (var entry in toUpdate)
        {
            var response = await _apiClient.PutAsJsonAsync(
                $"localization/{IdcOrg}/admin/entries/{entry.Id}", entry);
            response.EnsureSuccessStatusCode();
        }

        changedRows.Clear();
        originalValues.Clear();
        pendingNewRows.Clear();
        firstAdding = 1;
        await LoadEntries();
    }
    private async Task<int> NextSeq<T>(IEnumerable<T> source, Func<T, int?> selector)
    {
        var maxSeq = source.Any()? source.Max(selector) ?? 0 : 0;
        return maxSeq + 1;
    }

}