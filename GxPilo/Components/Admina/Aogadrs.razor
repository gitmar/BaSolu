<h3>Aogadrs</h3>

@using GxPilo.Components.Admina
@using GxShared.GxDtos
@using GxShared.Sess
@using GxShared.Interfaces
@using Simple.OData.Client

@inherits ComponentBase

<div class="address-form">
    <EditForm Model="@Address" OnValidSubmit="@OnAdrSaved">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="form-group">
            <div class="btn-toolbar" role="toolbar">
                <label class="me-2">Adrtype :</label>
                <InputSelect @bind-Value="ITypAdr"
                             @bind-Value:after="OuvreMGrid"
                             class="me-3"
                             style="width:auto">
                    <option value="0">?Tyadr</option>
                    @foreach (var tob in LsFixes)
                    {
                        <option value=@tob.Elea>@tob.Liba</option>
                    }
                </InputSelect>
                <label class="me-2">Adrtype :</label>
                <InputSelect @bind-Value="IMyAdr"
                             @bind-Value:after="OuvreMGrid"
                             class="me-3"
                             style="width:auto">
                    <option value="0">?adr</option>
                    @foreach (var tob in LsAdrs)
                    {
                        <option value=@tob.Id>@tob.Adr</option>
                    }
                </InputSelect>
            </div>
        </div>
        @if (CanOpenMGrid)
        {
            <div class="form-group">
                <label>Street</label>
                <InputText @bind-Value="Address.Npays" class="form-control" />
            </div>

            <div class="form-group">
                <label>City</label>
                <InputText @bind-Value="Address.Scity" class="form-control" />
            </div>

            <div class="form-group">
                <label>Postal Code</label>
                <InputText @bind-Value="Address.Adr" class="form-control" />
            </div>
            <div class="form-group">
                <label>Country</label>
                <InputText @bind-Value="Address.Natio" class="form-control" />
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
            <button type="button" class="btn btn-secondary" @onclick="OnCancel">Cancel</button>
            @if (CanDelete)
            {
                <button type="button" class="btn btn-danger" @onclick="OnDelete">Delete</button>
            }
        }
    </EditForm>
</div>

