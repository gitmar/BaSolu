<h3>Aogadrs</h3>

@using GxPilo.Components.Admina
@using GxShared.GxDtos
@using GxShared.Sess
@using GxShared.Interfaces
@using Simple.OData.Client

<div class="btn-toolbar" role="toolbar">
    <label class="me-2">Adrtype :</label>
    <InputSelect @bind-Value="ITypAdr"
                 class="me-3"
                 style="width:auto">
        <option value="0">?Tyadr</option>
        <option value="1">De base</option>
        <option value="2">Livraison</option>
        <option value="3">Paiement</option>
    </InputSelect>
    @if (ITypAdr > 0 && !CanAjoutAdr)
    {
        <Button Color="ButtonColor.Primary" Size="ButtonSize.Small"
        @onclick="() => StartAdrNew()">
            <span style="display:inline-flex; align-items:center; gap:2px;">
                <span>➕</span>
                <span>Add</span>
            </span>
        </Button>
    }
</div>

<div class="address-form">
    <EditForm Model="@MyDaAdres">
        <DataAnnotationsValidator />
        <ValidationSummary />
        
        @if (CanAjoutAdr)
        {
            <div class="address-form">
                    <div class="form-group">
                        <label>Principale</label>
                        <InputText @bind-Value="draftAdr.Adr" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Secondaire</label>
                        <InputText @bind-Value="draftAdr.Adr2" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Pays</label>
                        <InputText @bind-Value="draftAdr.Rpays" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Region</label>
                        <InputText @bind-Value="draftAdr.Sregio" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Ville</label>
                        <InputText @bind-Value="draftAdr.Scity" class="form-control" />
                    </div>

                    <button type="button" class="btn btn-primary" @onclick="() => ConfAdrAdd(draftAdr)">Confirm</button>
                    <button type="button" class="btn btn-secondary" @onclick="CancAdrAdd">Cancel</button>
            </div>
        }
        <div class="mt-2">
                    <Grid TItem="GsadrDto"
                    Data="@MyDaAdres"
                    @key="AdrRenderKey"
                    AllowDetailView="true"
                    AllowPaging="true"
                    RowClass="@((item) => GetAdrRowClass(item))"
                    Responsive="true">
                        <GridColumns>
                            <GridColumn TItem="GsadrDto" HeaderText="No" Class="xcol1">
                                <ChildContent Context="item">
                                    <span>@item?.Iui</span>
                                </ChildContent>
                            </GridColumn>
                            <GridColumn TItem="GsadrDto" HeaderText="Principale" Class="xcol2">
                                <ChildContent Context="item">
                                    @if (EdAdrRowguid == item.Rowguid)
                                    {
                                        <InputText @bind-Value="draftAdr.Adr" class="form-control" />
                                    } 
                                    else 
                                    {
                                        @item.Adr
                                    }
                                </ChildContent>
                            </GridColumn>
                            <GridColumn TItem="GsadrDto" HeaderText="Secondaire" Class="xcol2">
                                <ChildContent Context="item">
                            @if (EdAdrRowguid == item.Rowguid)
                            {
                                <InputText @bind-Value="draftAdr.Adr2" class="form-control" />
                            }
                            else
                            {
                                @item.Adr2
                            }
                                </ChildContent>
                            </GridColumn>
                            <GridColumn TItem="GsadrDto" HeaderText="Pays" Class="xcol2">
                                <ChildContent Context="item">
                            @if (EdAdrRowguid == item.Rowguid)
                            {
                                <InputText @bind-Value="draftAdr.Rpays" class="form-control" />
                            }
                            else
                            {
                                @item.Rpays
                            }
                                    @item.Rpays
                                </ChildContent>
                            </GridColumn>
                            <GridColumn TItem="GsadrDto" HeaderText="Region" Class="xcol2">
                                <ChildContent Context="item">
                            @if (EdAdrRowguid == item.Rowguid)
                            {
                                <InputText @bind-Value="draftAdr.Sregio" class="form-control" />
                            }
                            else
                            {
                                @item.Sregio
                            }
                                </ChildContent>
                            </GridColumn>
                            <GridColumn TItem="GsadrDto" HeaderText="City" Class="xcol1">
                                <ChildContent Context="item">
                            @if (EdAdrRowguid == item.Rowguid)
                            {
                                <InputText @bind-Value="draftAdr.Scity" class="form-control" />
                            }
                            else
                            {
                                @item.Scity
                            }
                                </ChildContent>
                            </GridColumn>
                    <GridColumn TItem="GsadrDto" HeaderText="Actions" Filterable="false" Class="xcol2 actions-col">
                        <ChildContent Context="item">
                            @switch (GetRowState(item.Rowguid))
                            {
                                case RowState.Locked:
                                    <span class="text-muted">—</span>
                                    break;

                                @* case RowState.AddPending:
                                            <Button Color="ButtonColor.Success" Size="ButtonSize.Small"
                                                    @onclick="() => ConfAdrAdd(EntityLevel.Adr, draftAdr)">
                                                ✅ Confirm
                                            </Button>
                                            <Button Color="ButtonColor.Success" Size="ButtonSize.Small"
                                                    @onclick="() => StartAdrAdd(draftAdr)">
                                                ❌ Cancel
                                            </Button>
                                            break; *@

                                case RowState.DeletePending:
                                    <Button Color="ButtonColor.Danger" Size="ButtonSize.Small"
                                            @onclick="() => ConfAdrDelete(EntityLevel.Adr, item)">
                                        ⚠️ Confirm
                                    </Button>
                                    <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small"
                                            @onclick="() => CancAdrDelete(EntityLevel.Adr, item)">
                                        ❎ Cancel
                                    </Button>
                                    break;
                                case RowState.EditPending:
                                    @if (draftAdr != null)
                                    {
                                        <Button Color="ButtonColor.Success" Size="ButtonSize.Small"
                                                @onclick="() => ConfAdrEdit(draftAdr)">
                                            ✅ Confirm
                                        </Button>
                                        <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small"
                                                @onclick="() => CancAdrEdit(EntityLevel.Adr, draftAdr)">
                                            ❌ Cancel
                                        </Button>
                                    }
                                    break;
                                default:
                                    @if (item.Id > 0)
                                    {
                                        <Button Color="ButtonColor.Warning" Size="ButtonSize.Small"
                                                @onclick="() => StartAdrEdit(item)">
                                            ✏️ Edit
                                        </Button>
                                        @if (item.Eaut != 9)
                                        {
                                            <Button Color="ButtonColor.Danger" Size="ButtonSize.Small"
                                                    @onclick="() => StartAdrDelete(item)">
                                                🗑 Delete
                                            </Button>
                                        }
                                    }
                                    break;
                            }
                        </ChildContent>
                    </GridColumn>
                        </GridColumns>
                    </Grid>
                </div>
    </EditForm>
</div>
<style>
    .xcolx {
        width: 40px !important;
    }

    .xcol1 {
        width: 60px;
    }

    .xcol2 {
        width: 120px;
    }

    .xcol3 {
        width: 180px;
    }

    .xcol4 {
        width: 240px;
    }
        /* Ensure inputs inside these columns fill the width */
        .xcol1 input,
        .xcol2 input,
        .xcol3 input,
        .xcol4 input {
            width: 100%;
            box-sizing: border-box; /* prevents overflow due to padding/border */
        }
    /* Make the whole cell a flex container so buttons line up horizontally */
    .actions-col {
        display: flex;
        flex-direction: row;
        gap: 6px; /* spacing between buttons */
        align-items: center; /* vertical alignment */
        justify-content: flex-start;
    }
        /* Apply to all buttons in your grid (or globally if you prefer) */
        .actions-col .btn {
            display: inline-flex; /* flex container */
            flex-direction: row; /* horizontal layout */
            align-items: center; /* vertical centering */
            gap: 4px; /* spacing between emoji and text */
            white-space: nowrap; /* prevent wrapping onto two lines */
            line-height: 1.2; /* normalize baseline */
        }
</style>
