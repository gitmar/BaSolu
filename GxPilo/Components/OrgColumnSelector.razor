@using GxPilo.Services.Cols
@using GxShared.Cols.Models
@using GxShared.Sess
@using GxPilo.Services

@inject ColumnPreferencesClient PrefClient
@inject RendBOlne _rendBOlne

<div class="d-flex align-items-end gap-3 flex-wrap mb-3">
    <div>
        <label class="fw-bold">Catégorie :</label>
        <InputSelect @bind-Value="selTotyp"
                     @bind-Value:after="OnSelectionChanged">
            <option value="1">Cible</option>
            <option value="2">Opérateur</option>
            <option value="3">Client</option>
            <option value="4">Fournisseur</option>
            <option value="5">Partenaire</option>
            <option value="6">Produit</option>
        </InputSelect>
    </div>

    @if (selTotyp == 1)
    {
        <div>
            <label class="fw-bold">Formulaire :</label>
            <InputSelect @bind-Value="selEfrm"
                         @bind-Value:after="OnSelectionChanged">
                <option value="1">Tiewel (accueil)</option>
                <option value="2">Tiersp (validation)</option>
            </InputSelect>
        </div>

        <div>
            <label class="fw-bold">Affilié :</label>
            <InputSelect @bind-Value="selStyp"
                         @bind-Value:after="OnSelectionChanged">
                <option value="1">Lui-même</option>
                @foreach (var tgpe in LsGAfls)
                {
                    <option value=@tgpe.Elea>@tgpe.Liba</option>
                }
            </InputSelect>
        </div>
    }
    else if (selTotyp == 6)
    {
        <div>
            <label class="fw-bold">Formulaire :</label>
            <InputSelect @bind-Value="selEfrm"
                         @bind-Value:after="OnSelectionChanged">
                <option value="1">Stkun (Livraison)</option>
                <option value="2">Validation (Entree)</option>
            </InputSelect>
        </div>
    }
</div>

<div class="d-flex align-items-end gap-3 flex-wrap mb-3">
    <button type="button"
            class="btn btn-outline-primary btn-sm"
            @onclick="PreviewSynchronization"
            disabled="@isBusy">
        Vérifier les colonnes
    </button>

    <button type="button"
            class="btn btn-primary btn-sm"
            @onclick="SaveSelection"
            disabled="@isBusy">
        @(isSaving ? "..." : "Enregistrer")
    </button>

    <button type="button"
            class="btn btn-secondary btn-sm"
            @onclick="CancelChanges"
            disabled="@isBusy">
        Annuler
    </button>
</div>

@if (awaitingResetConfirmation)
{
    <div class="alert alert-warning d-flex align-items-center gap-3">
        <span>
            Réinitialiser la configuration des colonnes pour ce formulaire ?
        </span>

        <button type="button"
                class="btn btn-danger btn-sm"
                @onclick="ConfirmReset"
                disabled="@isBusy">
            Confirmer
        </button>

        <button type="button"
                class="btn btn-secondary btn-sm"
                @onclick="CancelReset"
                disabled="@isBusy">
            Annuler
        </button>
    </div>
}

@if (statusMessage is not null)
{
    <div class="alert @(statusOk ? "alert-success" : "alert-danger") py-2">
        @statusMessage
    </div>
}

@if (syncPreview is not null)
{
    <div class="alert alert-info">
        <strong>Synchronisation :</strong>
        @syncPreview.MissingColumns.Count colonne(s) à ajouter,
        @syncPreview.StaleColumns.Count colonne(s) obsolète(s).

        @if (syncPreview.MissingColumns.Count > 0
             || syncPreview.StaleColumns.Count > 0)
        {
            <div class="mt-2 d-flex gap-2">
                <button type="button"
                        class="btn btn-sm btn-primary"
                        @onclick="ApplySynchronization"
                        disabled="@isBusy">
                    Appliquer la synchronisation
                </button>

                <button type="button"
                        class="btn btn-sm btn-secondary"
                        @onclick="CloseSyncPreview"
                        disabled="@isBusy">
                    Fermer
                </button>
            </div>
        }
    </div>
}

<div class="row mb-3">
    @if (isLoading)
    {
        <p><em>Chargement...</em></p>
    }
    else if (_workingCols.Count == 0)
    {
        <p><em>Aucune colonne configurée pour ce formulaire.</em></p>
    }
    else
    {
        <Tabs>
    <Tab Title="Configuration (ordre naturel)" IsActive="true">
        <Content>
            <Grid TItem="LSelCol" Data="@_workingCols" Class="table table-sm table-striped" AllowPaging="true">
                <GridColumns>
                    <GridColumn TItem="LSelCol" HeaderText="No" Class="xcol1">@context.ColNo</GridColumn>
                    <GridColumn TItem="LSelCol" HeaderText="Original" Class="xcol2">@context.ColName</GridColumn>
                    <GridColumn TItem="LSelCol" HeaderText="Rang" Class="xcol1">
                        <InputNumber @bind-Value="@context.CustNo" min="1" style="width:80px;" />
                    </GridColumn>
                    <GridColumn TItem="LSelCol" HeaderText="Personnalisé" Class="xcol3">
                        <InputText @bind-Value="@context.Ulabel" placeholder="Libellé" />
                    </GridColumn>
                    <GridColumn TItem="LSelCol" HeaderText="Visible" Class="xcol1">
                        <input type="checkbox" checked="@context.IsVisible"
                                 @onchange="@(e => { context.IsVisible = (bool)e.Value!; if (!context.IsVisible) context.IsRequired = false; })" />
                    </GridColumn>
                    <GridColumn TItem="LSelCol" HeaderText="Obligatoire" Class="xcol1">
                        <input type="checkbox" checked="@context.IsRequired" disabled="@(!context.IsVisible)"
                            @onchange="@(e => context.IsRequired = (bool)e.Value!)" />
                    </GridColumn>
                    <GridColumn TItem="LSelCol" HeaderText="Type" Class="xcol2">
                        <span class="text-muted">@AtypLabel(context.Atyp)</span>
                    </GridColumn>
                    @* "Liste" and "Parent" columns: unchanged from your version *@
                    <GridColumn TItem="LSelCol" HeaderText="Table" Class="xcol2">
                        @if (context.Atyp == ColAtyp.Text || context.Atyp == ColAtyp.Number)
                        {
                            <InputSelect @bind-Value="@context.Tref">
                                <option value=0>aucun</option>
                                @foreach (var tob in EnsTbls.Where(ut => ut.Tenr == 1))
                                {
                                    <option value=@tob.Tref>@tob.Liba</option>
                                }
                            </InputSelect>
                        }
                        else
                        {
                            <span>N/A</span>
                        }
                    </GridColumn>
                    <GridColumn TItem="LSelCol" HeaderText="Parent" Class="xcol2">
                        @if (context.Tref > 0)
                        {
                            <InputSelect @bind-Value="@context.Pref">
                                <option value="0">aucun (racine)</option>
                                @foreach (var tob in EnsTbls.Where(ut => ut.Tenr == 1 && ut.Tref != context.Tref))
                                {
                                    <option value=@tob.Tref>@tob.Liba</option>
                                }
                            </InputSelect>
                        }
                    </GridColumn>
                </GridColumns>
            </Grid>
        </Content>
    </Tab>

    <Tab Title="Aperçu du formulaire">
        <Content>
            <p class="text-muted">
                Ordre des champs dans les formulaires (lecture seule, inclut les modifications non enregistrées).
            </p>

            @if (DuplicateRanks.Any())
            {
                <div class="alert alert-warning py-1">
                    Rangs en double (@string.Join(", ", DuplicateRanks)) : l'ordre naturel (No) les départage.
                </div>
            }

            <table class="table table-sm table-striped">
                <thead>
                    <tr><th>#</th><th>Libellé</th><th>Champ</th><th>Rang</th><th>No</th></tr>
                </thead>
                <tbody>
                    @foreach (var (col, pos) in PreviewColumns.Select((c, i) => (c, i + 1)))
                    {
                        <tr>
                            <td>@pos</td>
                            <td>@(string.IsNullOrWhiteSpace(col.Ulabel) ? col.ColName : col.Ulabel)</td>
                            <td class="text-muted">@col.ColName</td>
                            <td>@col.CustNo</td>
                            <td>@col.ColNo</td>
                        </tr>
                    }
                </tbody>
            </table>
        </Content>
    </Tab>
</Tabs>
}
</div>

<style>
    .xcol1 {
        width: 70px;
    }

    .xcol2 {
        width: 130px;
    }

    .xcol3 {
        width: 190px;
    }

    .xcol1 input,
    .xcol2 input,
    .xcol3 input,
    .xcol2 select,
    .xcol3 select {
        width: 100%;
        box-sizing: border-box;
    }
</style>

@code {
    [Parameter] public int Idorg { get; set; }

    [Parameter] public List<Gtabl> EnsTbls { get; set; } = new();

    private int selTotyp = 1;
    private int selEfrm = 1;
    private int selStyp = 1;
    private string? statusMessage;
    private bool statusOk;

    private List<LSelCol> _workingCols = new();

    private ColumnSyncPreviewDto? syncPreview;

    private bool awaitingResetConfirmation;

    private bool isLoading;
    private bool isSaving;
    private bool isResetting;
    private bool isSynchronizing;

    private List<Gpvar> LsGAfls = new();
    private List<Gpvar> LsEnrVars = new();

    private bool isBusy =>
        isLoading || isSaving || isResetting || isSynchronizing;

    // Only visible columns appear in forms, in custom order
private IEnumerable<LSelCol> PreviewColumns =>
    _workingCols.Where(c => c.IsVisible).InDisplayOrder();

private IEnumerable<int?> DuplicateRanks =>
    _workingCols.Where(c => c.IsVisible && c.CustNo is > 0)
                .GroupBy(c => c.CustNo)
                .Where(g => g.Count() > 1)
                .Select(g => g.Key);

private static string AtypLabel(ColAtyp atyp) => atyp switch
{
    ColAtyp.Text     => "Texte",
    ColAtyp.Number   => "Nombre",
    ColAtyp.Date     => "Date",
    ColAtyp.Checkbox => "Case à cocher",
    ColAtyp.Dropdown => "Liste",
    _                => "—"
};
    protected override async Task OnInitializedAsync()
    {
        //Ityp:options Oui/Non
        LsEnrVars = await _rendBOlne.LoadOrgaVariabs(Idorg);
        Console.WriteLine("✅ LoadOrgaVariabs done");
        LsGAfls = LsEnrVars.Where(uv => uv.Gvars == 3 && uv.Itb == 6 && uv.Ityp == 1 && uv.Elea != 0).ToList();
        await LoadColumnsAsync();
    }

    private ColPrefContext BuildContext() => new()
    {
        Totyp = selTotyp,
        Efrm = selTotyp is 1 or 6 ? selEfrm : 1,
        Styp = selTotyp == 1 ? selStyp : 1
    };
    private async Task LoadColumnsAsync()
{
    isLoading = true;
    statusMessage = null;
    try
    {
        // Server returns custom order; Tab 1 shows the natural order.
        _workingCols = (await PrefClient.LoadAsync(Idorg, BuildContext()))
            .OrderBy(c => c.ColNo)
            .ToList();
    }
    catch (HttpRequestException ex)
    {
        _workingCols = new();
        statusOk = false;
        statusMessage = $"Chargement impossible ({(int?)ex.StatusCode}).";
    }
    finally
    {
        isLoading = false;
    }
}
    private async Task OnSelectionChanged()
    {
        if (selTotyp != 1 && selTotyp != 6)
        {
            selEfrm = 1;
        }

        if (selTotyp != 1)
        {
            selStyp = 1;
        }

        await LoadColumnsAsync();
    }

    private static bool CanHaveLookup(LSelCol column)
        => column.Atyp is ColAtyp.Text or ColAtyp.Number;

    private static bool HasLookup(LSelCol column)
        => column.Tref.HasValue && column.Tref.Value > 0;

    // private async Task OnAtypChangedAsync(LSelCol column)
    // {
    //     if (!CanHaveLookup(column))
    //     {
    //         column.Tref = null;
    //         column.Pref = null;
    //     }

    //     await Task.CompletedTask;
    // }

    private async Task OnLookupChangedAsync(LSelCol column)
    {
        if (!CanHaveLookup(column) || !HasLookup(column))
        {
            column.Pref = null;
        }

        await Task.CompletedTask;
    }

    private async Task SaveSelection()
    {
        if (!ValidateBeforeSave(out var errorMessage))
        {
            statusOk = false;
            statusMessage = errorMessage;
            return;
        }

        isSaving = true;
        statusMessage = null;

        try
        {
            // The API derives the final order from the submitted list order.
            for (var i = 0; i < _workingCols.Count; i++)
            {
                _workingCols[i].ColNo = i + 1;
            }

            var saved = await PrefClient.SaveAsync(
                Idorg,
                BuildContext(),
                _workingCols);

            statusOk = saved;
            statusMessage = saved
                ? "Colonnes enregistrées."
                : "Échec de l'enregistrement.";

            if (saved)
            {
                await LoadColumnsAsync();
            }
        }
        catch (Exception ex)
        {
            statusOk = false;
            statusMessage = "Erreur lors de l'enregistrement.";

            Console.Error.WriteLine(ex);
        }
        finally
        {
            isSaving = false;
        }
    }

    private bool ValidateBeforeSave(out string errorMessage)
    {
        var duplicateNames = _workingCols
            .GroupBy(c => c.ColName, StringComparer.OrdinalIgnoreCase)
            .Where(g => g.Count() > 1)
            .Select(g => g.Key)
            .ToList();

        if (duplicateNames.Count > 0)
        {
            errorMessage =
                "Colonne dupliquée : " +
                string.Join(", ", duplicateNames) + ".";

            return false;
        }

        var invalidLookupColumns = _workingCols
            .Where(c => !CanHaveLookup(c) && c.Tref is not null)
            .Select(c => c.ColName)
            .ToList();

        if (invalidLookupColumns.Count > 0)
        {
            errorMessage =
                "Une table de liste ne peut être définie que pour une " +
                "colonne de type Texte ou Nombre : " +
                string.Join(", ", invalidLookupColumns) + ".";

            return false;
        }

        var missingLookupTables = _workingCols
            .Where(c => CanHaveLookup(c)
                     && c.Tref is not null
                     && c.Tref <= 0)
            .Select(c => c.ColName)
            .ToList();

        if (missingLookupTables.Count > 0)
        {
            errorMessage =
                "Choisissez une table valide pour les colonnes de liste : " +
                string.Join(", ", missingLookupTables) + ".";

            return false;
        }

        errorMessage = string.Empty;
        return true;
    }

    private async Task CancelChanges()
    {
        statusMessage = null;
        syncPreview = null;

        await LoadColumnsAsync();
    }

    // private void AskResetConfirmation()
    // {
    //     awaitingResetConfirmation = true;
    //     statusMessage = null;
    //     syncPreview = null;
    // }

    private void CancelReset()
    {
        awaitingResetConfirmation = false;
    }

    private async Task ConfirmReset()
    {
        isResetting = true;
        statusMessage = null;

        try
        {
            await PrefClient.ResetAsync(Idorg, BuildContext());

            statusOk = true;
            statusMessage = "Configuration réinitialisée.";
            awaitingResetConfirmation = false;

            await LoadColumnsAsync();
        }
        catch (Exception ex)
        {
            statusOk = false;
            statusMessage = "Échec de la réinitialisation.";

            Console.Error.WriteLine(ex);
        }
        finally
        {
            isResetting = false;
        }
    }

    private async Task PreviewSynchronization()
    {
        isSynchronizing = true;
        statusMessage = null;

        try
        {
            syncPreview = await PrefClient.PreviewSynchronizationAsync(
                Idorg,
                BuildContext());

            if (syncPreview.MissingColumns.Count == 0
                && syncPreview.StaleColumns.Count == 0)
            {
                statusOk = true;
                statusMessage = "La configuration est déjà synchronisée.";
                syncPreview = null;
            }
        }
        catch (Exception ex)
        {
            statusOk = false;
            statusMessage = "Impossible de vérifier la synchronisation.";

            Console.Error.WriteLine(ex);
        }
        finally
        {
            isSynchronizing = false;
        }
    }

    private async Task ApplySynchronization()
{
    isSynchronizing = true;
    statusMessage = null;

    var synchronized = false;

    try
    {
        var result = await PrefClient.SynchronizeAsync(Idorg, BuildContext());

        synchronized = true;
        statusOk = true;
        statusMessage =
            $"{result.AddedCount} colonne(s) ajoutée(s), " +
            $"{result.MarkedStaleCount} colonne(s) obsolète(s).";
        syncPreview = null;
    }
    catch (HttpRequestException ex)
    {
        statusOk = false;
        statusMessage = $"Échec de la synchronisation ({(int?)ex.StatusCode}).";
        Console.Error.WriteLine(ex);
    }
    catch (Exception ex)
    {
        statusOk = false;
        statusMessage = "Échec de la synchronisation.";
        Console.Error.WriteLine(ex);
    }
    finally
    {
        isSynchronizing = false;
    }

    // Reload outside the try: a reload problem must not hide a successful sync.
    if (synchronized)
        await LoadColumnsAsync();
}
    private void CloseSyncPreview()
    {
        syncPreview = null;
    }

// Restore the natural order
private void ClearCustomOrder()
{
    foreach (var c in _workingCols) c.CustNo = c.ColNo;
}

}