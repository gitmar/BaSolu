@page "/resetpassword"

@inject NavigationManager _navManager
@inject IHttpClientFactory _httpClientFactory

@code {
    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? Token { get; set; }
    private bool isLoading = false;
    private string newPassword = "";
    private string? error;
    private HttpClient _dftClient;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        _dftClient = _httpClientFactory.CreateClient("AuthClient");
    }

    private async Task Submit()
    {
        var resp = await _dftClient.PostAsJsonAsync("api/Password/reset",
            new { Email, Token, NewPassword = newPassword });

        if (resp.IsSuccessStatusCode) _navManager.NavigateTo("/login");
        else error = "Reset failed. The link may have expired.";
    }
}