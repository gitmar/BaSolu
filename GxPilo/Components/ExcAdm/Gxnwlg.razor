<h3>Gxnwlg</h3>
@if (_currentIdorg == 0)
{
    <div class="alert alert-warning">
        No organization is selected.
    </div>
}
else
{
    <div class="card mb-3">
        <div class="card-header">
            Organization: @_currentIdorg
        </div>
        <div class="card-body">
            <div class="row g-2">
                <div class="col-md-4">
                    <div class="col-md-8">
                        <Button Color="ButtonColor.Warning"
                            Size="ButtonSize.Small"
                            Disabled="@_isBusy"
                            @onclick="SynchronizeDictionaryAsync">
                                Synchronize dictionary
                        </Button>
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">New language code</label>
                    <input class="form-control" @bind="_newLanguage" />

                    <label class="form-label">Display name</label>
                    <input class="form-control" @bind="_newLanguageDisplay" />

                    <label class="form-label">Order (Elea)</label>
                    <input type="number" class="form-control" @bind="_newLanguageOrder" disabled />

                    <Button Color="ButtonColor.Primary"
                        Size="ButtonSize.Small"
                        Disabled="@(_isBusy)"
                        @onclick="AddNewLanguageAsync">
                            Add New Language
                    </Button>
                </div>
            </div>
        </div>
    </div>
}
@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <div class="alert @(_isSuccess ? "alert-success" : "alert-danger")">
        @_statusMessage
    </div>
}
