private async Task AddNewLanguageAsync()
{
    if (string.IsNullOrWhiteSpace(_newLanguage) || _newLanguage.Length != 2 || !_newLanguage.All(char.IsAsciiLetter))
    {
        ShowResult(false, "Language code must contain exactly two letters (e.g., en, fr, es).");
        return;
    }

    _newLanguage = _newLanguage.ToLowerInvariant();

    var nextElea = await GetNextEleaAsync(_currentIdorg);

    var request = new AddLanguageRequest
    {
        Abg = _newLanguage,
        Liba = _newLanguageDisplay,
        Elea = nextElea
    };

    await RunAdminOperationAsync(() => AdminClient.AddNewLanguageAsync(_currentIdorg, request));

    if (_isSuccess)
    {
        _newLanguage = string.Empty;
        _newLanguageDisplay = string.Empty;
    }
}


    private async Task SynchronizeDictionaryAsync()
    {
        await RunAdminOperationAsync(
            () => AdminClient.SynchronizeDictionaryAsync(
                _currentIdorg,
                null));
    }
    private async Task RunAdminOperationAsync(
        Func<Task<AdminOperationResultDto>> operation)
    {
        _isBusy = true;
        _statusMessage = string.Empty;

        try
        {
            var result = await operation();

            ShowResult(result.Success, result.Message);
        }
        catch (Exception ex)
        {
            ShowResult(false, ex.Message);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task<int> GetNextEleaAsync(int idorg)
{
    // If none exist, start at 1
    if (languages == null || !languages.Any())
        return 1;

    // Otherwise, take max Elea + 1
    return languages.Max(l => l.Elea) + 1;
}


    private void ShowResult(bool success, string message)
    {
        _isSuccess = success;
        _statusMessage = message;
    }
}