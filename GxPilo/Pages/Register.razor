@page "/register"
@using System.ComponentModel.DataAnnotations
@using GxShared.ShdServices
@using GxShared.Sess
@using GxShared.Helpers
@using System.Net.Http.Json
@using System.Text.RegularExpressions

@inject IHttpClientFactory _httpClientFactory
@inject NavigationManager _navManager

<h2>ENREGISTREMENT SUR GX-SOLUTIONS</h2> 

@* <style>
    .readonly-form {
        pointer-events: none;
        opacity: 0.7;
    }
</style> *@

@if (!string.IsNullOrEmpty(Imessage))
{
    <div class="alert @(isSuccess ? "alert-success" : "alert-danger")">
        @Imessage
    </div>
}

@if (!isLoaded)
{
    <p>Loading...</p>
}
else
{
    <EditForm Model="@MyRegisDto" OnValidSubmit="HandleRegister">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <!-- Organisation info -->
        <div class="d-flex flex-row align-items-center g-2">
            <label class="fw-bold">@OgSigle</label>
            <label>-</label>
            <label class="fw-bold">@OgRaison</label>
        </div>
        <div class="d-flex flex-row align-items-center g-2">
            <label class="fw-bold">@ResNom</label>
            <label>..</label>
            <label class="fw-bold">@ResPnom</label>
        </div>

        <!-- Email (readonly) -->
        <div class="row g-3">
            <label>Email</label>
            <div class="col-md-4">
                <InputText class="form-control" @bind-Value="MyRegisDto.Email" disabled />
            </div>
        </div>
        <!-- Phone (readonly) -->
        <div class="row g-3">
            <label>Telephone</label>
            <div class="col-md-4">
                <InputText class="form-control" @bind-Value="MyRegisDto.PhoneNumber" disabled />
            </div>
            <div class="col-md-5">
                <label>Si WhatsApp?:</label>
                <InputCheckbox @bind-Value="MyRegisDto.IsWhatsappEnabled" class="form-check-input checkbox-bordered" />
            </div>
        </div>
        @if (!isSuccess)
        {
            <div class="row g-3">
                <label>Pseudo <span class="fw-bold text-danger">(7–15 chars, no space/accent)</span></label>
                <div class="col-md-4">
                    <input class="form-control"
                           @bind="MyRegisDto.Username"
                           @bind:event="oninput" />
                    <ValidationMessage For="@(() => MyRegisDto.Username)" />
                </div>
            </div>

            <div class="row g-3">
                <label>
                    Password
                    <span class="fw-bold text-danger">
                        (≥1 capital, ≥1 number, ≥1 special character)
                    </span>
                </label>
                <div class="col-md-4 input-group">
                    <input type="@passwordInputType"
                           class="form-control"
                           @bind="MyRegisDto.Password"
                           @bind:event="oninput" />
                    <button type="button" class="btn btn-outline-secondary" @onclick="TogglePassword">
                        @(passwordInputType == "password" ? "Show" : "Hide")
                    </button>
                </div>
                <ValidationMessage For="@(() => MyRegisDto.Password)" />
            </div>

            <div class="row g-3 mb-3">
                <label>
                    Confirm Password
                    <span class="fw-bold text-danger">
                        (idem password)
                    </span>
                </label>
                <div class="col-md-4 input-group">
                    <input type="@confirmPasswordInputType"
                           class="form-control"
                           @bind="MyRegisDto.ConfirmPassword"
                           @bind:event="oninput" />
                    <button type="button" class="btn btn-outline-secondary" @onclick="ToggleConfirmPassword">
                        @(confirmPasswordInputType == "password" ? "Show" : "Hide")
                    </button>
                </div>
                <ValidationMessage For="@(() => MyRegisDto.ConfirmPassword)" />
            </div>
            <button type="submit" class="btn btn-primary" disabled="@(isSubmitting || !CanSubmit)">
                @(isSubmitting ? "Registering..." : "Register")
            </button>
        }
    </EditForm>
}

<p class="mt-3 text-info">@Imessage</p>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "cdlink")]
    public string? CdLink { get; set; }

    private HttpClient _apiClient;
    private RegisterDto MyRegisDto = new();
    private InviteLinkData? InviteData;

    private bool isLoaded = false, isSuccess = false;
    private bool isSubmitting = false;
    private string? Imessage = "";

    // UI fields
    private string OgRaison = "";
    private string OgSigle = "";
    private string OgWeb = "";
    private string OgDom = "";
    private string OgSDom = "";
    private string OgNatio = "";
    private string ResNom = "";
    private string ResPnom = "";

    // Password visibility toggles
    private string passwordInputType = "password";
    private string confirmPasswordInputType = "password";

    private void TogglePassword()
    {
        passwordInputType = passwordInputType == "password" ? "text" : "password";
    }

    private void ToggleConfirmPassword()
    {
        confirmPasswordInputType = confirmPasswordInputType == "password" ? "text" : "password";
    }

    // Enable submit only when rules are satisfied
    private bool CanSubmit =>
        !string.IsNullOrWhiteSpace(MyRegisDto.Username) &&
        MyRegisDto.Username.Length >= 7 &&
        !string.IsNullOrWhiteSpace(MyRegisDto.Password) &&
        Regex.IsMatch(MyRegisDto.Password, @"^(?=.*[A-Z])(?=.*\d)(?=.*[^a-zA-Z0-9]).+$") &&
        !string.IsNullOrWhiteSpace(MyRegisDto.ConfirmPassword) &&
        MyRegisDto.Password == MyRegisDto.ConfirmPassword;


    protected override async Task OnInitializedAsync()
    {
        _apiClient = _httpClientFactory.CreateClient("AuthClient");

        if (string.IsNullOrEmpty(CdLink))
        {
            isLoaded = true;
            return;
        }

        try
        {
            var response = await _apiClient.GetFromJsonAsync<InviteLinkData>(
                $"regis/decode?cdlink={CdLink}");

            if (response == null) return;

            InviteData = response;
            var usrorg = await _apiClient.GetFromJsonAsync<Gporga>($"lgauth/tetorga/{InviteData.Idorg}");
            if (usrorg == null) return;

            MyRegisDto.Email = InviteData.Email;
            MyRegisDto.Username = "";
            MyRegisDto.SiPhone = InviteData.SiPhone;
            MyRegisDto.IsWhatsappEnabled = InviteData.IsWhatsappEnabled;
            MyRegisDto.Nom = InviteData.Nom;
            MyRegisDto.Pnom = InviteData.Pnom;
            MyRegisDto.PhoneNumber = InviteData.PhoneNumber;
            MyRegisDto.Idorg = InviteData.Idorg;

            OgRaison = usrorg.Raison;
            OgSigle = usrorg.Sigle;
            OgWeb = usrorg.Weburl;
            OgDom = usrorg.Sidom;
            OgSDom = usrorg.Sjdom;
            OgNatio = usrorg.Natio;
            ResNom = usrorg.Rnom;
            ResPnom = usrorg.Rpnom;
        }
        catch
        {
            Imessage = "Failed to load invite data.";
        }

        isLoaded = true;
    }

    private async Task HandleRegister()
    {

        if (!JwtHelper.IsValidEmail(MyRegisDto.Email))
        {
            Imessage = $"Email incorrect: {MyRegisDto.Email}";
            isSuccess = false;
            return;
        }
        isSubmitting = true;
        Imessage = "Enregistrement en cours...";
        await InvokeAsync(StateHasChanged);

        try
        {
            MyRegisDto.Idorg = InviteData.Idorg;
            MyRegisDto.Ivrole = InviteData.Ivrole;
            MyRegisDto.Itoken = InviteData.Itoken;
            MyRegisDto.SendEmail = InviteData.SendEmail;
            MyRegisDto.FbackUrl = _navManager.Uri;
            var response = await _apiClient.PostAsJsonAsync("regis/register", MyRegisDto);

            if (response.IsSuccessStatusCode)
            {
                Imessage = "Registration successful! Please check your email for confirmation.";
                isSuccess = true;
            }
            else
            {
                // Read the error message returned by the API
                var errorContent = await response.Content.ReadAsStringAsync();

                // You can decide how to display it:
                // - show raw message
                // - or parse JSON if your API returns structured error
                Imessage = $"Registration failed: {errorContent}";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            Imessage = $"Registration failed: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isSubmitting = false;
            await InvokeAsync(StateHasChanged);
        }
    }
    // private bool IsValidEmail(string email)  // ✅ Instance method
    // {
    //     if (string.IsNullOrWhiteSpace(email)) return false;
    //     return System.Text.RegularExpressions.Regex.IsMatch(email, @"^[^@\s]+@[^@\s]+\.[^@\s]+$");
    // }
}