@if (isLoading)
{
    <div class="text-center">
        <Spinner Color="SpinnerColor.Primary" Size="SpinnerSize.Large" />
        <p>OPERA/CALCULS Loading...</p>
    </div>
}
<div>
    @* test : @froMenu.Usite *@
</div>
@if (!isLoading)
{
    <div class="gx-screen-layout">
        <div class="container gx-parent-container" style="height: 100vh;">
            <div class="d-flex flex-column" style="height: 100%;">
                <GxNavMenu BrandText="A24soft Gx-Solutions"
                           MenuItems="@MenuItems"
                           YaGroup="true"
                           Groups="@Groupes"
                           MenuSelected="@_chxMenu"
                           MenuSelectedChanged="@SelMenu"
                           GroupSelected="@Ugpe"
                           GroupSelectedChanged="@SelGpe"
                           OnBack="@NavigateBack" />
               
                <!-- Top Menu Info -->
                <div class="row mb-2">
                    <div class="d-flex align-items-center gap-2">
                        <label>Exercice:</label>
                        <InputText @bind-Value="strExo" disabled />
                        <label>Session:</label>
                        <InputText @bind-Value="strSes" disabled />
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="d-flex align-items-center gap-2">
                        <label>Programme :</label>
                        <div class="text-center">
                            <InputSelect id="pgrId" @bind-Value="ImyProg">
                                <option value=0></option>
                                @foreach (var pgr in LsProgs)
                                {
                                    <option value=@pgr.Id @onclick="() => GetSelectedProg(pgr)">@pgr.Liba</option>
                                }
                            </InputSelect>
                        </div>

                        <label for="TypDiv">Service :</label>
                        <div>
                            <InputSelect id="TypDiv" @bind-Value="ImyDiv" @onclick="@trierTiers">
                                <option value=0></option>
                                <option value=-1>Tous</option>
                                @foreach (var divo in LsDivs)
                                {
                                    <option value=@divo.Ihie>@divo.Abg-@divo.Liba</option>
                                }
                            </InputSelect>
                        </div>

                    </div>
                    @if (!string.IsNullOrEmpty(Imessage))
                    {
                        <span class="bg-info bg-opacity-10 text-danger px-2" style="font-style: italic;">
                            &nbsp;--> @Imessage
                        </span>
                    }
                </div>
                @* <div class="row mb-2">
                    <div class="d-flex align-items-center gap-2">
                        <label>Session des variables :</label>
                        <div class="text-center">
                            <InputSelect id="pgrId" @bind-Value="ImyVSes">
                                <option value=0>session?</option>
                                @foreach (var sess in EnsSess)
                                {
                                    <option value=@sess.Elea>@sess.Liba</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                </div> *@
                <!-- Main Content //a integer froMenu -->
                @if (_chxMenu != 0 && curOrga != null && toChild != null)
                {
                    @if (_chxMenu == 1)
                    {
                        <Calcpart @ref="myfcalc"
                                  CurOrga="@curOrga"
                                  @bind-NbChanges="_nbChanges"
                                  ToChild="@toChild"
                                  ImyDiv="@ImyDiv"
                                  curProg="@curProg"
                                  ChxGpe="@Ugpe"
                                  _guard="_guard"
                                  PreTiers="@PreTiers"
                                  SessOpen="@SessOpen"
                                  CalcSession="@CurrentCalcSession"
                                  CalcContext="@CurrentCalcContext"
                                  _MyODaClient="@_MyODaClient">
                            <ChildContent>

                            </ChildContent>
                        </Calcpart>
                    }
                    else if (_chxMenu == 2)
                    {
                        @* <OrdaLoad>
                                    <ChildContent>
                                        <h2 class="child-box">Hello VALIDATIONS</h2>
                                    </ChildContent>
                                </OrdaLoad> *@
                    }
                }
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-12">
            @if (_guard.HasPendingChanges())
            {
                <div class="alert alert-warning">
                    <strong>@pendingCount changes pending across all tabs</strong>
                </div>
            }
            <div class="d-flex gap-2 justify-content-end">
                <Button Color="ButtonColor.Primary"
                        @onclick="SaveAllChanges"
                        Enabled="@_guard.HasPendingChanges()">
                    Save All (@pendingCount changes)
                </Button>
                <Button Color="ButtonColor.Secondary"
                        @onclick="CancelAllChanges">
                    Cancel All Changes
                </Button>
            </div>
        </div>
    </div>
}
<ErrorBoundary>
    <ErrorContent>
        An unexpected error occured. Please try again later.
    </ErrorContent>
</ErrorBoundary>
