    protected override bool TrackOnItsOwn(EntityLevel level, object entity)
    {
        if (level != EntityLevel.Wfl || entity is not TiwaflDto w) return true;
        var parent = TiwItems.FirstOrDefault(t => t.Rowguid == w.Prowguid) ?? curTiw;
        return parent.Id > 0;
    }

