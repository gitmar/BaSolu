        };
        GaflMode = GridMode.AflsAdding;
        await StartRowAdd(EntityLevel.Wfl, newWfl, WflItems, d => SetDraft(EntityLevel.Wfl, d));
        // no curTiw.Tiwafls.Add here: the hook adds it when the affiliate is confirmed
    }

