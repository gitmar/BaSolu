            Prowguid = parent.Rowguid,
            Itiw = parent.Id,                                         // 0 while the person is new
            Tyafl = selectedGroup,
            Zmatri = ChldMatri,
            Irang = NextSeq(WflItems.Where(w => w.Prowguid == parent.Rowguid), p => p.Iui),
            Nom = "",
