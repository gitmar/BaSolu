    private async Task ConfirmPerson(TiewelDto person)
    {
        if (ChildBusy)
        {
            Imessage = "Terminez ou annulez l'affilié en cours avant de valider la personne.";
            return;
        }
        if (GetEditState(EntityLevel.Tiw).IsAdd) 
        { 
            await ConfirmAdd(EntityLevel.Tiw, person, true);
            ConfState = AddEdtMode.AddPConfirmed;
        }
        else 
        { 
            await ConfirmEdit(EntityLevel.Tiw, person, true);
            ConfState = AddEdtMode.EdtPConfirmed;
        }

        GtieMode = GaflMode = GridMode.None;
    }

    private async Task CancelPerson(TiewelDto person)
    {
        if (ChildBusy && GetDraft(EntityLevel.Wfl) is TiwaflDto d
            && WflItems.FirstOrDefault(w => w.Rowguid == d.Rowguid) is { } open)
            await CancelWfl(open);                                   // its draft belongs to this person

        var wasAdd = GetEditState(EntityLevel.Tiw).IsAdd;
        if (wasAdd) await CancelAdd(EntityLevel.Tiw, person);
        else await CancelEdit(EntityLevel.Tiw, person);

        if (wasAdd) WflItems.RemoveAll(w => w.Prowguid == person.Rowguid && w.Id == 0);   // children of a person that never existed
        GtieMode = GaflMode = GridMode.None;
    }

