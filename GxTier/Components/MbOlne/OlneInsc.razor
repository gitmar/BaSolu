@page "/olneinsc"
@layout OlneLayout

@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]

@inherits CompUICrudBase

@using System.Linq.Expressions
@using GxShared.GxDtos
@using GxShared.Others
@using GxShared.Sess
@using GxShared.Helpers
@using GxShared.Helpers.CrudHelpers
@using GxShared.Cols.Models
@using GxShared.Interfaces
@using GxShared.ShdServices
@using GxTie.Components.Paccu
@using GxTie.Components.Paccu.RtPer
@using GxTie.Components.Uifrags
@using GxTie.Components.PfrmHelper
@using GxTie.Components.Cols
@using GxTie.Services
@using Simple.OData.Client
@using GxTie.Components.Apcomp

@inject IHttpClientFactory _httpClientFactory
@inject IODataClient _InODaClient
@inject IClientMatriculeOrdreService _mordService
@inject LinkSerialiser _linkSerialiser
@inject IPendingChangesGuard _guard
@inject IMessageService _messageService
@inject PublicColumnFormValidator _colValidator
@inject PublicColumnPreferencesClient _prefReader

<PageTitle>Online.Candidature</PageTitle>
<h3>Appel Candidature</h3>
<div>@Imessage</div>

<p> @olnOrga?.Sigle - @olnOrga?.Raison </p>
@if (curTiw != null && InIdorg != 0 && isModalVisible)
{
    <GlobModal IsVisible="@isModalVisible"
               IsVisibleChanged="@OnModalVisibilityChanged"
               Title="Chargement des documents"
               UploadCtx="@uploadCtx"
               Idorg="@InIdorg"
               EntyTiw="@curTiw"
               EntyTie="null"
               LsmVars="@EnsVars"
               Oparent="2">
    </GlobModal>
}
@if (!IsTiwLoaded)
{
    <div class="text-center">
        <Spinner Color="SpinnerColor.Primary" Size="SpinnerSize.Medium" />
        <p>ONLINE/formulaire Loading...</p>
    </div>
}
else
{
    <!-- Brand with Back -->
    @* (@_guard.GetPendingChangesCount() changes) *@
    <div class="d-flex align-items-center gap-2">
        <Button Color="ButtonColor.Warning"
                Size="ButtonSize.Small"
                Class="px-2 py-1 small-btn"
                @onclick="() => ConfirmPerson(curTiw)">
            ✅ Confirmer
        </Button>
        <Button Color="ButtonColor.Secondary"
                Size="ButtonSize.Small"
                Class="px-2 py-1 small-btn"
                @onclick="() => CancelPerson(curTiw)">
            ❌ Abandonner
        </Button>
        <Button Color="ButtonColor.Info"
                Size="ButtonSize.Small"
                Class="px-2 py-1 small-btn"
                @onclick="ShowModal">
            piece(s)
        </Button>
        <Button Class="w-auto flex-grow-0 flex-shrink-0" Color="ButtonColor.Info" Size="ButtonSize.Small"
            @onclick="SaveAllChanges"
                Enabled="@_guard.HasPendingChanges()">
            Save All (@_guard.GetPendingChangesCount() changes)
        </Button>
        <Button class="w-auto flex-grow-0 flex-shrink-0" Color="ButtonColor.Secondary" Size="ButtonSize.Small" 
            @onclick="CancelAllChanges"
                Enabled="@_guard.HasPendingChanges()">
            Cancel All
        </Button>
    </div>
    <div class="container mx-0">
        <Tabs @ref="olnetabs">
            <Tab Title="Candidat" Name="Tiw1Tab" onClick="() => OnTabChanged(1)">
                <Content>
                    @if (IsTiwLoaded)
                    {
                        <EditForm Context="invform" Model="curTiw">
                            <DataAnnotationsValidator />
                            <ValidationSummary />
                            <!-- Generated matricule -->
                            <div class="matricule-row">
                                <span class="fw-bold text-nowrap">
                                    PV-@Sorga-@Sgpe-
                                </span>
                                <input class="form-control matricule-input"
                                       value="@OrdreOnly"
                                       readonly />

                                <span class="fw-bold text-nowrap">
                                    @Saffilia
                                </span>
                            </div>

                            <PTiwGdHelper Idorg="@InIdorg" Entity="@curTiw"
                                          Draft="@(GetDraft(EntityLevel.Tiw) as TiewelDto)"
                                          PrefReader="@_prefReader"
                                          EnsTbls="@EnsTbls"
                                          EnsAtrs="@EnsAtrs"
                                          Ugpe="@Ugpe"
                                          OnConfirm="@ConfirmPerson"  
                                          OnCancel="@CancelPerson"
                                          WflItems="@WflItems"
                                          ChildBusy="@ChildBusy"
                                          IsEditingFn="@(a => IsWflEditing(a))"
                                          GetDraftFn="@(() => GetDraft(EntityLevel.Wfl) as TiwaflDto)"
                                          IsEditing="@IsTiwEditing(curTiw)"
                                          ConfState="@ConfState"
                                          OnStartEditWfl="@StartEditWfl"
                                          OnConfirmWfl="@ConfirmWfl"
                                          OnCancelWfl="@CancelWfl"
                                          OnDeleteWfl="@(a => StartRowDelete(EntityLevel.Wfl, a.Rowguid))"
                                          GroupOptions="@ChldAfls.Where(af => af.Atyp == Ugpe && af.Elea is >= 2 and <= 6).ToList()"
                                          SelectedGroup="@IMyGAfl"
                                          ChldMatri="@ChldMatri"
                                          SelectedGroupChanged="@(v => IMyGAfl = v)"
                                          OnAddChild="@AddChild" />
                        </EditForm>
                    }
                </Content>
            </Tab>
            <Tab Title="Adresses" Name="Tiw2Tab" onClick="() => OnTabChanged(2)">
                <Content>
                    @if (genOrga != null && canOpenAdres && !string.IsNullOrEmpty(curTiw?.Zmatri))
                    { 
                        <Gstadr @bind-NbChanges="_nbChanges" curOrga="@genOrga" _guard="@Guard"
                             EnsTbls="@EnsTbls" Actx="@Actx" />
                    }
                </Content>
            </Tab>
            <Tab Title="Récépissé" Name="Tiw3Tab" onClick="() => OnTabChanged(4)">
                <Content>
                    <span>Recepisse</span>
                    <RtW11Fic olnOrga="@olnOrga"
                              _InODaClient="@_InODaClient"
                              toChild="@toChild"
                              curTiw="@curTiw">
                    </RtW11Fic>
                </Content>
            </Tab>
        </Tabs>
    </div>
}

<style>
    .my-container { background-color: yellow; }
    .small-btn { font-size: 0.75rem; line-height: 1.2; }

    .matricule-row {
        display: flex;
        align-items: center;
        gap: .5rem;
        flex-wrap: nowrap;
    }

    .matricule-input {
        width: 130px;
        min-width: 130px;
        max-width: 130px;
        text-align: center;
    }

    .matricule-row .btn {
        width: auto;
        white-space: nowrap;
    }
</style>

