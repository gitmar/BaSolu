    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;

        try
        {
            // Check invitation link
            if (string.IsNullOrEmpty(cdLink))
            {
                _messageService.Show("autorisation refusée", ToastType.Warning);
                return;
            }

            _InviteData = _linkSerialiser.DecodeAndDeserialize<InviteLinkData>(cdLink);

            if (_InviteData == null)
            {
                _messageService.Show("Autorisation refusée", ToastType.Warning);
                return;
            }

            // Check expiration
            ExpDate = _InviteData.Expires;

            if (ExpDate < DateTime.Today)
            {
                _messageService.Show("Délai expiré", ToastType.Warning);
                return;
            }

            _chxOlne = _InviteData.ChxOlne;
            Ugpe = _InviteData.Utyp;
            Sorga = _InviteData.Idorg.ToString();
            InIdorg = _InviteData.Idorg;
            Saffilia = "T";

            Sgpe = Ugpe switch
            {
                1 => "1CB",
                2 => "2OP",
                3 => "3CL",
                4 => "4FN",
                5 => "5PA",
                _ => "1CB"
            };

            // Load organization data
            await RendsOlneBags(InIdorg);
            //Console.WriteLine("[OlneInsc] BEFORE RENDER");

            //Console.WriteLine($"Organization: {InIdorg}");
            //Console.WriteLine($"Tables: {EnsTbls?.Count}");
            //Console.WriteLine($"Attributes: {EnsAtrs?.Count}");
            //Console.WriteLine($"Categories: {EnsCats?.Count}");
            //Console.WriteLine($"Variables: {EnsVars?.Count}");
            //Console.WriteLine($"TiwItems: {TiwItems?.Count}");
            //Console.WriteLine($"curTiw null: {curTiw == null}");

            //Console.WriteLine("[OlneInsc] AFTER DATA CHECK");
            IsTiwLoaded = true;
            isLoading = false;

        }
        catch (Exception ex)
        {
            Console.WriteLine($"OlneInsc error: {ex.Message}");
            Console.WriteLine(ex.StackTrace);

            //Imessage = $"Erreur chargement: {ex.Message}";
            _messageService.Show("probleme serveur", ToastType.Warning);
        }
        finally
        {
            isLoading = false;
        }
    }
    private async Task RendsOlneBags(int myIdorg)
    {
        olnOrga = new();
        EnsTbls = new();
        EnsAtrs = new();
        EnsCats = new();
        EnsVars = new();
        ChldAfls = new();
        var bgresponse = await _dftClient.GetFromJsonAsync<Olnebag>($"olines/olnebag/{myIdorg}", default);
        if (bgresponse != null)
        {
            _olneBag = bgresponse;
            genOrga = _olneBag.GenOrga;
            olnOrga = _olneBag.Norga;
            EnsTbls = _olneBag.Ntabls;
            EnsAtrs = _olneBag.Natrs;
            EnsCats = _olneBag.Ncats;
            EnsVars = _olneBag.Nvars;
            //Ityp - Oui/Non
            ChldAfls = EnsVars.Where(uv => uv.Gvars == 3 && uv.Itb == 6 && uv.Ityp == 1 && uv.Elea != 0).ToList();
            _lgcdu = olnOrga?.Lftrub ?? 3;
            _lgfmt = olnOrga?.Ftrub ?? "";
            await StartTiwNew();
        } 
        else
        {
            _olneBag = new();
            IsTiwLoaded = false;
        }
        Console.WriteLine($"FINAL {curTiw?.Zmatri}");
    }

