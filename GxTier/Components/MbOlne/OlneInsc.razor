    public async Task<List<string>> ValidateForSaveAsync()
    {
        static string Who(string? nom, string? pnom, string fallback)
            => string.IsNullOrWhiteSpace($"{nom} {pnom}") ? fallback : $"{nom} {pnom}".Trim();

        // Only inserts and updates need checking; a pending delete must not be blocked.
        bool NeedsCheck(EntityLevel level, Guid rowguid)
            => GetOpInfo(level, rowguid)?.OpType is PendingOpType.Insert or PendingOpType.Update;

        var items = new List<(EntityLevel Level, ColPrefContext Ctx, object Model, string Title)>();

        foreach (var tiw in TiwItems.Where(t => NeedsCheck(EntityLevel.Tiw, t.Rowguid)))
            items.Add((EntityLevel.Tiw, ColumnContexts.Person(Ugpe), tiw,
                       Who(tiw.Nom, tiw.Pnom, "Personne")));

        foreach (var wfl in WflItems.Where(w => NeedsCheck(EntityLevel.Wfl, w.Rowguid)))
            items.Add((EntityLevel.Wfl, ColumnContexts.Affiliate(wfl.Tyafl), wfl,
                       "Affilié " + Who(wfl.Nom, wfl.Pnom, "")));

        var problems = await _colValidator.ValidateManyAsync(_prefReader,
            InIdorg, items.Select(i => (i.Ctx, i.Model, i.Title)));

        // Business rules (minimum lengths...). Skipped if you don't override Validate(level, entity).
        foreach (var (level, _, model, title) in items)
            if (!Validate(level, model))
                problems.Add($"{title} : {Imessage}");

        return problems;
    }
    private async Task ConfirmWfl(TiwaflDto item)
    {
        var es = GetEditState(EntityLevel.Wfl);
        if (es.IsAdd) await ConfirmAdd(EntityLevel.Wfl, item, true);
        else await ConfirmEdit(EntityLevel.Wfl, item, true);
    }

    private async Task CancelWfl(TiwaflDto item)
    {
        var es = GetEditState(EntityLevel.Wfl);
        if (es.IsAdd) await CancelAdd(EntityLevel.Wfl, item);
        else await CancelEdit(EntityLevel.Wfl, item);
    }
    private async Task ConfirmDeleteWfl(TiwaflDto a)
    {
        if (a.Id == 0)   // never saved: nothing to delete on the server
        {
            RemoveByRowguid(EntityLevel.Wfl, a.Rowguid);
            ResetRowState(EntityLevel.Wfl, a.Rowguid);
            return;
        }
        await ConfirmDelete(EntityLevel.Wfl, a, true);
    }
    private string OrdreOnly
    {
        get
        {
            if (string.IsNullOrWhiteSpace(curTiw?.Zmatri))
                return "";
            var parts = curTiw.Zmatri.Split('-');
            var last = parts.LastOrDefault() ?? "";
            return last.Length > 1
                ? last[..^1]
                : "";
        }
    }
