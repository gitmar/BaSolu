    private string GetLabel(LSelCol column)
        => string.IsNullOrWhiteSpace(column.Ulabel)
            ? (string.IsNullOrWhiteSpace(column.Olabel)
                ? column.ColName
                : column.Olabel)
            : column.Ulabel;
  
    private static bool CanHaveLookup(LSelCol column)
        => column.Atyp is ColAtyp.Text or ColAtyp.Number;

    private static bool IsDropdown(LSelCol column)
        => CanHaveLookup(column)
           && column.Tref.HasValue
           && column.Tref.Value > 0;

    private Gtabl? GetLookupTable(LSelCol column)
        => EnsTbls.FirstOrDefault(t =>
            t.Tenr == 1
            && column.Tref.HasValue
            && t.Tref == column.Tref.Value);

    private List<Gtvar> GetLookupItems(LSelCol column)
        => GetLookupTable(column)?.TbItems ?? [];

    private static string GetOptionValue(Gtvar option)
        => option.Aval ?? string.Empty;

    private string GetDropdownValue(LSelCol column)
    {
        var value = GetValue(column.ColName);

        return value?.ToString() ?? string.Empty;
    }

    private void SetDropdownValue(LSelCol column, string value)
    {
        SetValue(
            column.ColName,
            string.IsNullOrWhiteSpace(value) ? null : value);
    }

    private string GetDropdownDisplayText(LSelCol column)
    {
        var currentValue = GetDropdownValue(column);

        var matchingItem = GetLookupItems(column)
            .FirstOrDefault(item =>
                string.Equals(
                    GetOptionValue(item),
                    currentValue,
                    StringComparison.OrdinalIgnoreCase));

        return matchingItem?.Liba ?? currentValue;
    }

    private string GetTextValue(LSelCol column)
        => GetPropertyValue(column.ColName)?.ToString() ?? string.Empty;

    private string GetDisplayValue(LSelCol column)
        => GetPropertyValue(column.ColName)?.ToString() ?? string.Empty;

    private string GetDateInputValue(LSelCol column)
    {
        var value = GetPropertyValue(column.ColName);

        return value is DateTime date
            ? date.ToString("yyyy-MM-dd")
            : string.Empty;
    }

    private bool GetBoolValue(LSelCol column)
        => GetPropertyValue(column.ColName) is true;

    private void SetConvertedValue(LSelCol column, object? rawValue)
    {
        SetPropertyValue(column.ColName, rawValue);
    }

    private IEnumerable<LSelCol> RenderColumns => _columns.Where(c => ModelProps.Has(Model, c.ColName));
private IEnumerable<string> IgnoredColumns =>
    _columns.Where(c => c.IsVisible && !ModelProps.Has(Model, c.ColName)).Select(c => c.ColName);
   

    private static object? ConvertValue(object? rawValue, Type targetType)
    {
        var isNullableTarget =
            Nullable.GetUnderlyingType(targetType) is not null;

        if (rawValue is null
            || rawValue is string textValue && string.IsNullOrWhiteSpace(textValue))
        {
            return isNullableTarget ? null : GetDefault(targetType);
        }

        var underlyingType =
            Nullable.GetUnderlyingType(targetType) ?? targetType;

        if (underlyingType.IsInstanceOfType(rawValue))
        {
            return rawValue;
        }

        if (underlyingType == typeof(DateTime)
            && rawValue is string dateString
            && DateTime.TryParse(dateString, out var parsedDate))
        {
            return parsedDate;
        }

        if (underlyingType == typeof(bool)
            && rawValue is bool boolValue)
        {
            return boolValue;
        }

        return Convert.ChangeType(rawValue, underlyingType);
    }

    private static object? GetDefault(Type type)
    {
        return type.IsValueType ? Activator.CreateInstance(type) : null;
    }
    public bool Validate()
{
    _missing.Clear();
    foreach (var c in ColumnRules.GetMissing(Model, _columns))
        _missing.Add(c.ColName);

    StateHasChanged();
    return _missing.Count == 0;
}

    private bool IsEmpty(LSelCol col)
    {
        var value = GetValue(Model, col.ColName);

        if (col.Tref is > 0 && col.CanHaveLookup())
            return value is null || value.ToString() is "" or "0";   // "0" = "Choisir..."

        return col.Atyp switch
        {
            ColAtyp.Text => string.IsNullOrWhiteSpace(value?.ToString()),
            ColAtyp.Date => value is null || value is DateTime d && d == default,
            ColAtyp.Checkbox => value is not true,                   // required = must be ticked
            _ => value is null                        // 0 is a legitimate number
        };
    } 
