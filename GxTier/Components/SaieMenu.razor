    private (DateTime Eddat, DateTime Efdat) ComputeGroupDefaultPeriod(int periodType, int eyear, int currentMonth, int currentDay)
    {
        switch (periodType)
        {
            case 1: // exercice year
            case 2: // année
                return (new DateTime(eyear, 1, 1), new DateTime(eyear, 12, 31));

            case 3: // semestre
                return currentMonth < 7
                    ? (new DateTime(eyear, 1, 1), new DateTime(eyear, 6, 30))
                    : (new DateTime(eyear, 6, 1), new DateTime(eyear, 12, 31));

            case 4: // trimestre
                {
                    var q = (currentMonth - 1) / 3;
                    var startMonth = q * 3 + 1;
                    var endMonth = startMonth + 2;
                    return (new DateTime(eyear, startMonth, 1),
                            new DateTime(eyear, endMonth, DateTime.DaysInMonth(eyear, endMonth)));
                }

            case 5: // mensuel — default
                return (new DateTime(eyear, currentMonth, 1),
                        new DateTime(eyear, currentMonth, DateTime.DaysInMonth(eyear, currentMonth)));

            case 6: // quinzaine (15 jours)
                return currentDay <= 15
                    ? (new DateTime(eyear, currentMonth, 1), new DateTime(eyear, currentMonth, 15))
                    : (new DateTime(eyear, currentMonth, 16), new DateTime(eyear, currentMonth, DateTime.DaysInMonth(eyear, currentMonth)));

            case 7: // dizaine (10 jours)
                {
                    var daysInMonth = DateTime.DaysInMonth(eyear, currentMonth);
                    if (currentDay <= 10)
                        return (new DateTime(eyear, currentMonth, 1), new DateTime(eyear, currentMonth, 10));
                    if (currentDay <= 20)
                        return (new DateTime(eyear, currentMonth, 11), new DateTime(eyear, currentMonth, 20));
                    return (new DateTime(eyear, currentMonth, 21), new DateTime(eyear, currentMonth, daysInMonth));
                }

            case 8: // semaine — ASSUMPTION: Monday-start week containing the current date
                {
                    var today = new DateTime(eyear, currentMonth, currentDay);
                    var diff = (7 + (today.DayOfWeek - DayOfWeek.Monday)) % 7;
                    var weekStart = today.AddDays(-diff);
                    return (weekStart, weekStart.AddDays(6));
                }

            case 9: // jour
                var day = Math.Min(currentDay, DateTime.DaysInMonth(eyear, currentMonth));
                var d = new DateTime(eyear, currentMonth, day);
                return (d, d);
      
            default: // fallback -> mensuel
                return (new DateTime(eyear, currentMonth, 1),
                        new DateTime(eyear, currentMonth, DateTime.DaysInMonth(eyear, currentMonth)));
        }
    }
