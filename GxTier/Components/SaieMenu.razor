    private async Task GetSelectedProg(Gplan bropln)
    {
        //Console.WriteLine($"ICI PROGRAMMES : {EnsProgs.Count()}");
        curProg = new();
        PreRubs = new();
        curProg = curOrga.Plngens.Where(pl => pl.Id == bropln.Id).FirstOrDefault();
