    private (DateTime Eddat, DateTime Efdat) ResolveRangeForCurrentGroup()
    {
        if (GroupOverrideEddat.HasValue && GroupOverrideEfdat.HasValue)
            return (GroupOverrideEddat.Value, GroupOverrideEfdat.Value);

        var group = SelectedGroup;
        var periodType = group?.Tcol ?? 5;

        var today = DateTime.Today;
        var eyear = SessionDate.Year;
        return ComputeGroupDefaultPeriod(periodType, eyear, today.Month, today.Day);
    }
    private void RebuildFilteredRubvars()
    {
        var group = SelectedGroup;

        SelectedRubvars = (group is null || group.TbItems is null || group.TbItems.Count == 0)
            ? curProg.Rubvars.ToList()                    // no group selected -> everything, new list instance
            : curProg.Rubvars
                .Where(rv => group.TbItems.Any(m =>
                    string.Equals(m.Ftcol, rv.Scdrub, StringComparison.Ordinal)))
                .ToList();
        var eyear = SessionDate.Year;
        var currentMonth = SessionDate.Month;
        var currentDay = SessionDate.Day;
        var periodType = group?.Tcol ?? 0;
        var datcalc = ComputeGroupDefaultPeriod
            (periodType, eyear, currentMonth, currentDay);
        GroupOverrideEddat = datcalc.Eddat;
        GroupOverrideEfdat = datcalc.Efdat; 
    }
