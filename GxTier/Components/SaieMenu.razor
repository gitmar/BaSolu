                            </InputSelect>
                        </div>

                        <label for="TypDiv">Service :</label>
                        <div>
                            <InputSelect id="TypDiv"
                                @bind-Value="ImyDiv"
                                @bind-Value:after="OnDivChanged">
                                <option value="0"></option>
                                <option value="-1">Tous</option>
                                @foreach (var divo in LsDivs)
                                {
                                    <option value="@divo.Ihie">@divo.Abg-@divo.Liba</option>
                                }
                                </InputSelect>
                        </div>

                        <div class="d-flex align-items-center gap-2 mb-2">
                            <div class="col-auto">
                                <label>Rubriques :</label>
                             </div>
                             <div class="col-auto">
                                <InputSelect Value="@SelectedGroupId"
                                    ValueChanged="@((int v) => OnGroupSelected(v))"
                                    ValueExpression="@(() => SelectedGroupId)">
                                    <option value=0>Tous</option>
                                    @foreach (var g in AvailableGroups)
                                    {
                                        <option value="@g.Id">@g.Liba</option>
                                    }
                                    <option value=-1>?choisir</option>
                                </InputSelect>
                            </div>
                        </div>
                    </div>
                        @if (!string.IsNullOrEmpty(Imessage))
                        {
                            <span class="bg-info bg-opacity-10 text-danger px-2" style="font-style: italic;">
                                &nbsp;--> @Imessage
                            </span>
                        }
                </div>

                <!-- Main Content Section -->
                <div class="flex-fill overflow-auto">
                    @if (_chxMenu != 0 && curOrga?.Idorg != 0 && curProg?.Id != 0 && toChild != null)
                    {
                        @if (_chxMenu == 1 && CanOpenSaiepart)
                        {
                                <Saiepart @ref="myfsaie"
                                          CurOrga="@curOrga"
                                          @bind-NbChanges="_nbChanges"
                                          ToChild="@toChild"
                                          ImyDiv="@ImyDiv"
                                          curProg="@curProg"
                                          ChxGpe="@Ugpe" 
                                          _guard="@_guard"
                                          PreTiers="@PreTiers"
                                          InsGpdata="_inGldata"
                                          SessOpen="@CanOpenSaiepart"
                                          _sessionDate="@SessionDate"
                                          _saieSession="@_saieSession"
                                          GroupOverrideEddat="@GroupOverrideEddat"
                                          GroupOverrideEfdat="@GroupOverrideEfdat"
                                          SelectedRubvars="@SelectedRubvars"
                                          _MyODaClient="_MyODaClient">
                                    <ChildContent></ChildContent>
                                </Saiepart>
                            }
                            else if (_chxMenu == 2)
                            {
                                @* 
                                <OrdaLoad>
                                    <ChildContent>
                                        <h2 class="child-box">Hello VALIDATIONS</h2>
                                    </ChildContent>
                                </OrdaLoad> 
                                *@
                            }
                            else if (_chxMenu == 5)
                            {
                                @*
                                <EdtSaie11 @ref="gedt11"
                                           curOrga="@curOrga"
                                           toChild="@toChild"
                                           curODContext="@_MyODaClient"
                                           enstiers="@EnsTiers">
                                    <ChildContent>
                                        <h2 class="child-box">Liste du Personnel</h2>
                                    </ChildContent>
                                </EdtSaie11>
                                *@
                            }
                        }
                    }
