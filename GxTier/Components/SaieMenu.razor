                        <label>Session:</label>
                        <InputText @bind-Value="strSes" disabled />
                        <label>/</label>
                        <InputDate @bind-Value="SessionDate" /> @* bind-Value:after="OnDayDateChanged" /> *@
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="d-flex align-items-center gap-2">
                        <label>Programme :</label>
                        <div class="text-center">
                            <InputSelect id="pgrId"
                                @bind-Value="ImyProg"
                                @bind-Value:after="OnProgChanged">
