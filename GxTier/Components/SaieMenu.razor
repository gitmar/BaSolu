    protected override async Task OnInitializedAsync()
    {
        if (_isInitialized)
            return;

        _isInitialized = true;
        isLoading = true;

        try
        {
            var authState = await _authProvider.GetAuthenticationStateAsync();
            isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;
            authUser = authState.User;

            if (!isAuthenticated)
            {
                Console.WriteLine("Authentication SaieMenu ECHEC");
                return;
            }

            _usrBag = await _sessionContext.GetUserbagAsync();
            if (_usrBag?.Usorga == null)
            {
                Console.WriteLine("User bag or Usorga is null");
                return;
            }
            LsVars = _usrBag.Usorga.Uvars?.ToList() ?? new();
            LsFixes = _usrBag.Ufixes?.ToList() ?? new();
            LsPlans = _usrBag.Usorga.Uplns?.ToList() ?? new();

            //LsVars = _usrBag.Usorga.Uvars?.ToList() ?? new List<YourVarDto>();
            //LsFixes = _usrBag.Ufixes?.ToList() ?? new List<YourFixDto>();
            //LsPlans = _usrBag.Usorga.Uplns?.ToList() ?? new List<YourPlnDto>();
            LsProgs = LsPlans.Where(pl => pl.Ptyp == 5 && pl.Todom == 1).ToList();
            LsTabls = LsVars.Where(tb => tb.Gvars == 5).ToList();

            Console.WriteLine($"Programmes en cours : {LsProgs.Count}");

            int xdom = 6;
            LsGties = LsFixes
                .Where(ut => ut.Gvars == 36 && ut.Itb == xdom && ut.Elea != 0 && ut.Elea != 9)
                .ToList();

            Groupes.Clear();
            foreach (var gr in LsGties.Where(gr => gr.Itb == 6))
            {
                Groupes.Add(new GxGroupe
                {
                    Itb = gr.Itb,
                    Elea = gr.Elea,
                    Liba = gr.Liba
                });
            }

            _invRoles = await _rendAgres.LoadOrgaRoles();
            Console.WriteLine($"inv roles : {_invRoles?.Count() ?? 0}");

            Ugpe = 1;
            Console.WriteLine("Authentication ENTREE");

            if (toChild != null)
            {
                toChild.authUser = authUser;
                toChild.isAuthenticated = isAuthenticated;
                toChild.Ugpe = Ugpe;
                toChild.curOrga = curOrga;
                toChild.LsVars = LsVars;
                toChild.LsFixes = LsFixes;
                toChild.LsPlans = LsPlans;
                toChild.LsTabls = LsTabls;
                toChild.inExo = LsVars.LastOrDefault(v => v.Gvars == 11 && v.Itb == 1 && v.Eta == 1);
            }

            strExo = toChild?.inExo?.Liba ?? string.Empty;

            var lsSes = await _rendAgres.LoadOrgaSessios();
            curSes = lsSes?.FirstOrDefault(su => su.Eta == 1 && su.Igpe == 3);

            if (curSes?.Ddat == null)
            {
                Console.WriteLine("No active session or Ddat is null");
                return;
            }

            strSes = curSes.Liba;
            if (toChild != null)
                toChild.inSes = curSes;

            await LoadSaieOrgaAsync(_usrBag.Idorg, curSes.Ddat.Value.Year, curSes.Ddat.Value.Month);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"OnInitializedAsync error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
    //CRUD
    private async Task LoadSaieOrgaAsync(int key, int year, int month)
    {
        int pisa = 2;   
        try
        {
            Console.WriteLine($"key : {key}");
            curOrga = await _MyODaClient
                .For<GxorgaDto>("Gxorgas")
                .Expand("Plngens($expand=Rubvars)")
                .Key(key)
                .FindEntryAsync();

            var msgsie = await _MyODaClient
                .For<TierspDto>("Tiersps")
                .Filter(f => f.Idorg == key)
                .Expand("Tieafls")
                .Expand("Tiejatrs")
                .Expand("Tiegcats")
                .FindEntriesAsync();
            orgTiers = msgsie.ToList();

            var msgact = await _MyODaClient
                .For<ActsaieDto>("Actsaies")
                .Filter(a => a.Idorg == key &&
                             (
                                 (a.Isset == 1 &&
                                  a.Dtent <= new DateTime(year, month, 1) &&
                                  a.Dtent >= new DateTime(year, month, 1))
                                 || a.Isset == 2
                             ))
                .Expand(a => a.Actdets)
                .FindEntriesAsync();
            orgActs = msgact.ToList();
            Console.WriteLine($"loadOrgaAsync completed : {curOrga?.Raison}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Load error: {ex.Message}");
        }
        if (curOrga == null)
        {
            Console.WriteLine("curOrga is null after LoadSaieOrgaAsync");
            return;
        }

        Console.WriteLine($"orga recu {curOrga.Raison}");

        EnsTiers = orgTiers?.ToList() ?? new List<TierspDto>();
        Console.WriteLine($"orga recu {curOrga.Raison}");
        var mytier = EnsTiers.FirstOrDefault();
        if (mytier != null)
        {
            Console.WriteLine($"nom selected tiers : {mytier.Nom} et {mytier.Pnom}");
            Console.WriteLine($"selected actsaies : {orgActs.Count()}");
        }
        else
        {
            Console.WriteLine($"probleme chargement Tiers");
        }
    }
