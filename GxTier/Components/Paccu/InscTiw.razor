    //build hierarchy
    private void BuildHierarchy()
    {
        var lookup = EnsCats.ToDictionary(c => c.Id);

        foreach (var cat in EnsCats)
        {
            if (cat.Pid != null && lookup.TryGetValue(cat.Pid.Value, out var parent))
            {
                cat.Parent = parent;
                parent.Children.Add(cat);
            }
        }
    }

