    // Affiliates of a saved person are tracked on their own; those of a new person ride in its insert.
    protected override bool TrackOnItsOwn(EntityLevel level, object entity)
    {
        if (level != EntityLevel.Wfl || entity is not TiwaflDto w) return true;
        var parent = TiwItems.FirstOrDefault(t => t.Rowguid == w.Prowguid) ?? curTiw;
        return parent.Id > 0;
    }
    // OlneInsc only:  protected override bool TrackOnItsOwn(EntityLevel l, object e) => false;

    // Keep curTiw.Tiwafls in step, but only for a new person (the payload needs it; display uses WflItems)
    protected override void OnLocalCollectionMutated(EntityLevel level, CollectionMutation mutation, object entity)
    {
        if (level != EntityLevel.Wfl || entity is not TiwaflDto wfl) return;
        var parent = TiwItems.FirstOrDefault(t => t.Rowguid == wfl.Prowguid) ?? curTiw;
        if (parent.Id > 0) return;

        if (mutation == CollectionMutation.Added && !parent.Tiwafls.Any(x => x.Rowguid == wfl.Rowguid))
            parent.Tiwafls.Add(wfl);
        else if (mutation == CollectionMutation.Removed)
            parent.Tiwafls.RemoveAll(x => x.Rowguid == wfl.Rowguid);
    }

    private async Task ConfirmPerson(TiewelDto person)
    {
        if (ChildBusy)
        {
            Imessage = "Terminez ou annulez l'affilié en cours avant de valider la personne.";
            return;
        }
        if (GetEditState(EntityLevel.Tiw).IsAdd)
        {
            await ConfirmAdd(EntityLevel.Tiw, person, true);
            ConfState = AddEdtMode.AddPConfirmed;
        }
        else
        {
            await ConfirmEdit(EntityLevel.Tiw, person, true);
            ConfState = AddEdtMode.EdtPConfirmed;
        }
        GtieMode = GaflMode = GridMode.None;
    }

    private async Task CancelPerson(TiewelDto person)
    {
        if (ChildBusy && GetDraft(EntityLevel.Wfl) is TiwaflDto d
            && WflItems.FirstOrDefault(w => w.Rowguid == d.Rowguid) is { } open)
            await CancelWfl(open);                                   // its draft belongs to this person

        var wasAdd = GetEditState(EntityLevel.Tiw).IsAdd;
        if (wasAdd) await CancelAdd(EntityLevel.Tiw, person);
        else await CancelEdit(EntityLevel.Tiw, person);

        if (wasAdd) WflItems.RemoveAll(w => w.Prowguid == person.Rowguid && w.Id == 0);   // children of a person that never existed
        GtieMode = GaflMode = GridMode.None;
    }

