            Idorg = curOrga.Idorg,
            Utyp = Ugpe,
            Nom = "", Pnom = "", Datc = DateTime.Now, Eta = 1
        };
        await StartRowAdd(EntityLevel.Tiw, newTiw, TiwItems, d => SetDraft(EntityLevel.Tiw, d));
        curTiw = newTiw;
    }

    private async Task StartEditTiw(TiewelDto item)
        => await StartRowEdit(EntityLevel.Tiw, item, _edTiwOriginals, d => SetDraft(EntityLevel.Tiw, d));

    private async Task StartEditWfl(TiwaflDto item)
        => await StartRowEdit(EntityLevel.Wfl, item, _edWflOriginals, d => SetDraft(EntityLevel.Wfl, d));

    private async Task AddChild(int selectedGroup)
    {
        if (curTiw.Id <= 0) { Imessage = "🚫 Save the main record first."; return; }

        var newWfl = new TiwaflDto
        {
            Rowguid = Guid.NewGuid(),
            Prowguid = curTiw.Rowguid,
            Itiw = curTiw.Id,
            Tyafl = selectedGroup,
            Irang = NextSeq(WflItems.Where(w => w.Itiw == curTiw.Id), p => p.Iui),
            Nom = "", Pnom = "", Datc = DateTime.Now, Eta = 1
        };
        await StartRowAdd(EntityLevel.Wfl, newWfl, WflItems, d => SetDraft(EntityLevel.Wfl, d));
    }

    private async Task ConfirmWfl(TiwaflDto item)
    {
        var es = GetEditState(EntityLevel.Wfl);
        if (es.IsAdd) await ConfirmAdd(EntityLevel.Wfl, item, true);
        else await ConfirmEdit(EntityLevel.Wfl, item, true);
    }

    private async Task CancelWfl(TiwaflDto item)
    {
        var es = GetEditState(EntityLevel.Wfl);
        if (es.IsAdd) await CancelAdd(EntityLevel.Wfl, item);
        else await CancelEdit(EntityLevel.Wfl, item);
    }

    private async Task VueDetails(EntityLevel level, object entity)
    {
        var rowguid = MLEntityKeyHelper.GetRowguidAsGuid(entity);
        if (level == EntityLevel.Tiw)
        {
            curTiw = (TiewelDto)entity;
            isTieViewing = true;
            await StartEditTiw(curTiw);
        }
    }

    private async Task VaOpenAdres()
    {
        Actx = new() { Agpe = 3, Itie = 0, Itiw = curTiw.Id, Iefl = 0, Iwfl = 0 };
        isOpenAdres = !isOpenAdres;
    }

    private RenderFragment RenderCategories(IEnumerable<Gpcat> cats) => builder =>
    {
        foreach (var cat in cats.Where(c => c.Eta != 0))
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", cat.Pid == null ? "mb-2" : "form-check ms-3");
            builder.OpenComponent<InputCheckbox>(2);
            builder.AddAttribute(3, "class", "form-check-input checkbox-bordered");
            builder.AddAttribute(4, "Value", cat.IsSelected);
            builder.AddAttribute(5, "ValueChanged", EventCallback.Factory.Create<bool>(this, args =>
            {
                cat.IsSelected = args;
                foreach (var child in cat.Children) child.IsSelected = args;
                CascadeUp(cat.Parent, args);
            }));
            builder.AddAttribute(6, "ValueExpression", (Expression<Func<bool>>)(() => cat.IsSelected));
            builder.CloseComponent();
            builder.OpenElement(7, "label");
            builder.AddAttribute(8, "class", "form-check-label");
            builder.AddContent(9, cat.Liba);
            builder.CloseElement();
            if (cat.Children.Any())
                builder.AddContent(10, RenderCategories(cat.Children));
            builder.CloseElement();
        }
    };

    private void CascadeUp(Gpcat? parent, bool selected)
    {
        if (parent == null) return;
        if (selected)
        {
            parent.IsSelected = true;
            CascadeUp(parent.Parent, true);
        }
        else if (parent.Children.All(c => !c.IsSelected))
        {
            parent.IsSelected = false;
            CascadeUp(parent.Parent, false);
        }
    }

    private void ShowModal() => isModalVisible = true;
