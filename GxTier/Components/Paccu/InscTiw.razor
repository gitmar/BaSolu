@page "/insctiw"
@layout EnrolMenu
@inherits CompUICrudBase

@using System.Linq.Expressions
@using GxShared.GxDtos
@using GxShared.Sess
@using GxShared.Helpers
@using GxShared.Helpers.CrudHelpers
@using GxShared.Interfaces
@using GxTie.Components.Uifrags
@using GxTie.Components.PfrmHelper
@using GxTie.Services
@using Simple.OData.Client
@using GxTie.Components.Apcomp

<PageTitle>Saisie.Enrollement</PageTitle>
<div>@Imessage</div>

@if (isLoading)
{
    <div class="text-center">
        <Spinner Color="SpinnerColor.Primary" Size="SpinnerSize.Medium" />
        <p>Saisie.Enrollement Loading...</p>
    </div>
}

@if (curTiw != null && isModalVisible)
{
    <GlobModal IsVisible="@isModalVisible"
               IsVisibleChanged="@OnModalVisibilityChanged"
               Title="Chargement des documents"
               EntyTiw="@curTiw"
               EntyTie="null"
               LsmVars="@LsVars"
               LsmFixes="@LsFixes"
               Oparent="2">
    </GlobModal>
}

<div class="my-container">
    @if (toChild != null)
    {
        @ChildContent
    }
</div>

@if (!isLoading)
{
    <AuthorizeView>
        <Authorized Context="authtiwcontext">
            @* @if (!isTieViewing)
            { *@
                <div class="d-flex align-items-center gap-2">
                    <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" Class="px-2 py-1 small-btn"
                            Disabled="@(!AllowMultipleEdits && IsAnyRowEditing)"
                            @onclick="StartTiwNew">
                        ➕ Add
                    </Button>
                </div>
            @* } *@

            <div class="container">
                <Tabs>
                    <Tab Title="Membres" Name="TiwTab" onClick="() => OnTabChanged(1)">
                        <Content>
                            <EditForm Context="invform" Model="curTiw">
                                <DataAnnotationsValidator />
                                <ValidationSummary />
                                <PTiwGdHelper Idorg="@curOrga.Idorg" Entity="@curTiw"
                                              Draft="@(GetDraft(EntityLevel.Tiw) as TiewelDto)"
                                              IsEditing="@IsTiwEditing(curTiw)"
                                              EnsTbls="@EnsTbls"
                                              OnConfirm="@(e => ConfirmEdit(EntityLevel.Tiw, e, true))"
                                              OnCancel="@(e => CancelEdit(EntityLevel.Tiw, e))"
                                              WflItems="@WflItems"
                                              IsAflViewing="@isAflViewing"
                                              IsAnyEditing="@IsAnyRowEditing"
                                              IsEditingFn="@(a => IsWflEditing(a))"
                                              GetDraftFn="@(() => GetDraft(EntityLevel.Wfl) as TiwaflDto)"
                                              OnStartEditAfl="@StartEditWfl"
                                              OnConfirmAfl="@ConfirmWfl"
                                              OnCancelAfl="@CancelWfl"
                                              OnDeleteAfl="@(a => StartRowDelete(EntityLevel.Wfl, a.Rowguid))"
                                              GroupOptions="@LsGAfls.Where(af => af.Atyp == Ugpe).ToList()"
                                              SelectedGroup="@IMyGAfl"
                                              SelectedGroupChanged="@(v => IMyGAfl = v)"
                                              OnAddChild="@AddChild" />

                                @if (!IsTiwEditing(curTiw))
                                {
                                    <div class="mt-2">
                                        <Button Color="ButtonColor.Warning" Size="ButtonSize.Small"
                                                Disabled="@IsAnyRowEditing"
                                                @onclick="() => StartEditTiw(curTiw)">
                                            ✏️ Edit
                                        </Button>
                                    </div>
                                }
                            </EditForm>
                        </Content>
                    </Tab>
                    <Tab Title="Plus..." Name="TiwTab" onClick="() => OnTabChanged(2)">
                        <Content>
                            <!-- Additional dynamic attributes -->
                                <label class="fw-bold mt-3 d-block">ATTRIBUT++(s)</label>
                                <div class="card">
                                    <div class="card-body p-3">
                                        @foreach (var ua in EnsAtrs.Where(a => a.Wgpe == 1 && a.Eta == 1))
                                        {
                                            var icatr = curTiw.Tiejatrs.FirstOrDefault(tat => tat.Iatr == ua.Id);
                                            if (icatr == null)
                                            {
                                                icatr = new TiejatrDto
                                                {
                                                    Xadd1 = -1,
                                                    Atyp = ua.Atyp,
                                                    Iatr = ua.Id,
                                                    Itiw = curTiw.Id,
                                                    Aval = "",
                                                    Satyp = ua.Satyp,
                                                    AtState = AEntState.NewAdded
                                                };
                                                curTiw.Tiejatrs.Add(icatr);
                                            }
                                            <div class="row mb-2 align-items-center">
                                                <label class="col-sm-3 col-form-label"><strong>@ua.Liba</strong></label>
                                                <div class="col-sm-9">
                                                    @if (IsTiwEditing(curTiw) && ua.Eta == 1)
                                                    {
                                                        if (ua.Zfro == 2)
                                                        {
                                                            <InputSelect @bind-Value="icatr.AvalAsInt" class="form-select">
                                                                <option value=0>Choisir...</option>
                                                                @foreach (var tob in EnsTbls.FirstOrDefault(t => t.Tenr == 1 && t.Tref == ua.Ztbl)?.TbItems ?? new List<Gtvar>())
                                                                {
                                                                    <option value="@tob.Tref">@tob.Liba</option>
                                                                }
                                                            </InputSelect>
                                                        }
                                                        else if (ua.Satyp == "int")
                                                        {
                                                            <InputNumber TValue="int?" @bind-Value="icatr.AvalAsInt" class="form-control" />
                                                        }
                                                        else if (ua.Satyp == "date")
                                                        {
                                                            <InputDate TValue="DateTime?" @bind-Value="icatr.AvalAsDate" class="form-control" />
                                                        }
                                                        else
                                                        {
                                                            <InputText @bind-Value="icatr.Aval" class="form-control" />
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <div class="form-control-plaintext">@icatr.Aval</div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Additional dynamic Categories -->
                                <label class="fw-bold mt-3 d-block">CATEGORIE++(s)</label>
                                <div class="card-body p-3">
                                    @RenderCategories(EnsCats.Where(c => c.Pid == null))
                                </div>

                            <!-- Addresses -->
                            <div class="row">
                                <div class="col-md-6">
                                    <label class="fw-bold">ADRESSE(++)S</label>
                                    <button @onclick="VaOpenAdres">Adresses plus</button>
                                </div>
                            </div>
                            <div class="row mb-2">
                                @if (isOpenAdres)
                                {
                                    <Gsdadr @bind-NbChanges="_nbChanges" curOrga="@curOrga" _guard="@Guard"
                                            EnsTbls="@EnsTbls" Actx="@Actx" />
                                }
                            </div>
                        </Content>
                    </Tab>
                    @if (!isTieViewing)
                    {
                        <Tab Title="Verification" Name="TiwTab" onClick="() => OnTabChanged(3)">
                            <Content>
                                @if (canbeVerified)
                                {
                                    <div class="container row">
                                        <Grid TItem="TiewelDto" Data="@WaitingTiewels" AllowSelection="true"
                                              SelectionMode="GridSelectionMode.Multiple" Responsive="true">
                                            <GridColumns>
                                                <GridColumn TItem="TiewelDto" HeaderText="No">
                                                    <ChildContent Context="item">
                                                        <span>@(item.Xedt1 == -1 ? item?.Iui : (item?.Iui == 0 ? item?.Iele : item?.Iui))</span>
                                                    </ChildContent>
                                                </GridColumn>
                                                <GridColumn TItem="TiewelDto" HeaderText="Dossier">
                                                    <ChildContent Context="item">@item.Xmatri</ChildContent>
                                                </GridColumn>
                                                <GridColumn TItem="TiewelDto" HeaderText="Nom">
                                                    <ChildContent Context="item">@item.Nom</ChildContent>
                                                </GridColumn>
                                                <GridColumn TItem="TiewelDto" HeaderText="Pnom">
                                                    <ChildContent Context="item">@item.Pnom</ChildContent>
                                                </GridColumn>
                                                <GridColumn TItem="TiewelDto" HeaderText="etat" IsVisible="true">
                                                    <ChildContent Context="item">
                                                        <InputSelect @bind-Value="item.Eta" disabled="true">
                                                            <option class="jchx" value=0>?choisir</option>
                                                            @foreach (var tob in LsFixes.Where(ut => ut.Gvars == 32 && ut.Itb == 1 && ut.Elea != 0))
                                                            {
                                                                <option value=@tob.Elea>@tob.Liba</option>
                                                            }
                                                        </InputSelect>
                                                    </ChildContent>
                                                </GridColumn>
                                                <GridColumn TItem="TiewelDto" HeaderText="Actions" Filterable="false" Class="xcol2 actions-col">
                                                    <ChildContent Context="item">
                                                        <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small"
                                                                @onclick="() => VueDetails(EntityLevel.Tiw, item)">
                                                            Details
                                                        </Button>
                                                    </ChildContent>
                                                </GridColumn>
                                            </GridColumns>
                                        </Grid>
                                    </div>
                                }
                            </Content>
                        </Tab>
                    }
                </Tabs>
            </div>
        </Authorized>
    </AuthorizeView>
}

<style>
    .my-container { background-color: yellow; }
    .small-btn { font-size: 0.75rem; line-height: 1.2; }
</style>

