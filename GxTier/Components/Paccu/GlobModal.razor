    private void HandleFilesSelected(InputFileChangeEventArgs e)
    {
        // Collect all selected files
        selectedFiles = e.GetMultipleFiles().ToList();
    }

    private async Task UploadFiles()
    {
        if (selectedFiles == null || selectedFiles.Count == 0)
        {
            errors = true;
            errorList.Add("❌ No file selected.");
            return;
        }
        if (UploadCtx == null)
        {
            errors = true;
            errorList.Add("❌ Upload context is missing.");
            return;
        }
        try
        {
            var content = new MultipartFormDataContent();

            foreach (var file in selectedFiles)
            {
                var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
                var fileContent = new StreamContent(stream);
                fileContent.Headers.ContentType = new MediaTypeHeaderValue(file.ContentType);

                // IMPORTANT: "File" must match your Web API DTO property name
                content.Add(fileContent, "File", file.Name);
            }

            // Add extra fields
            content.Add(new StringContent(UploadCtx.Idorg.ToString()), "Idorg");
            content.Add(new StringContent(UploadCtx.Itie.ToString()), "Itie");
            content.Add(new StringContent(UploadCtx.Itiw.ToString()), "Itiw");
            content.Add(new StringContent(UploadCtx.Ioper.ToString()), "Ioper");
            content.Add(new StringContent(UploadCtx.Xmatri ?? ""), "Xmatri");

            //_apiClient = _httpfacClient.CreateClient("LocalClient");
            var response = await _apiClient.PostAsync("Lgfileup/upload", content);

            if (response.IsSuccessStatusCode)
            {
                errors = true;
                errorList.Add("✅ Success, File(s) uploaded successfully.");
            }
            else
            {
                errors = true;
                errorList.Add($"❌ Echec, File upload failed. Status: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            errors = true;
            errorList.Add($"❌ Exception during upload: {ex.Message}");
        }
    }

    private async Task AcceptList()
{
    // toggle PeutLister
    PeutLister = !PeutLister;

