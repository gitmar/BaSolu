    private bool SmatriValid;
    private void OnSmatriValidChanged(bool isValid)
    {
        SmatriValid = isValid;
        curTie.Smatri = SmatriValid ? Smatri : "";
    }
    private TierspDto EditTie => EditTarget(EntityLevel.Tie, curTie);

