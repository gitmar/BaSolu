    public VldeTie(IPendingChangesGuard guard) : base(guard) { }

    private bool isLoading = true;
    private string Imessage = "";

    [Parameter] public RenderFragment ChildContent { get; set; }
    [Parameter] public IODataClient _InODaClient { get; set; }
    [Parameter] public GxorgaDto curOrga { get; set; } = new();
    [Parameter] public List<TierspDto> orgTiers { get; set; } = new();
    [Parameter] public ChildVars toChild { get; set; }
    [Parameter] public int Tgpe { get; set; }
    [Parameter] public int Ugpe { get; set; } = 0;
    [Parameter] public int toMenu { get; set; }
    [Parameter] public List<Gtabl> EnsTbls { get; set; }
