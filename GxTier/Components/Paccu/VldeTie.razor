    //[Parameter] public List<Gpcat> EnsCats { get; set; } = new();
    [Parameter] public IPendingChangesGuard _guard { get; set; }
    [Parameter] public EventCallback<PendingState> OnPendingStateChanged { get; set; }
    [Parameter] public int NbChanges { get; set; }
    [Parameter] public EventCallback<int> NbChangesChanged { get; set; }

    //format code rubriques
    private int _lgcdu = 3;
    private string _lgfmt = "";

    private List<Gplan> LsPlans = new();
    private List<Gpfixe> LsFixes = new();
    private List<Gpvar> LsVars = new();

    private List<Gpvar> GpeAfls = new();
    private List<Gpvar> ChldAfls = new();

    //editing workflow
    //adding and editing workflow
    public GridMode GtieMode = GridMode.None;
    public GridMode GaflMode = GridMode.None;
    //public bool AjtState => LocTieAdding || LocTieEditing;
    private AddEdtMode ConfState = AddEdtMode.None;

    private bool IsBusy => IsLevelBusy(EntityLevel.Tie);
    private bool ChildBusy => IsLevelBusy(EntityLevel.Afl);   // an affiliate row is being added or edited

    private HttpClient _dftClient = default!;
    private Acatbag _acatBag = new();
    public List<Gpatr> EnsAtrs = new();
    public List<Gpcat> EnsCats = new();

    //private bool isOpenAdres = false;
    private bool isTieValidate = false;

    //private Modal gTieModal = null;
    private bool isModalVisible = false;
    private bool AllowMultipleEdits { get; set; } = false;

    private int IMyGAfl = 0;
    private int refTab = 1;

    private bool IsProvisional = true;
    private string Sorga = "";
    private string Sgpe = "";
    private string mstrTie = "";
    private string Saffilia = "T";
    public string ChldMatri = "";
