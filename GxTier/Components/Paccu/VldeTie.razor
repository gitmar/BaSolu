<PageTitle>Validation Enrollement</PageTitle>
<div>@Imessage</div>

@if (isLoading)
{
    <div class="text-center">
        <Spinner Color="SpinnerColor.Primary" Size="SpinnerSize.Medium" />
        <p>Chargement Enrollement...</p>
    </div>
}
<p> @curOrga?.Sigle - @curOrga?.Raison </p>
@if (curTie != null && curOrga != null && isModalVisible)
{
    <GlobModal IsVisible="@isModalVisible"
               IsVisibleChanged="@OnModalVisibilityChanged"
               Title="Chargement des documents"
               UploadCtx="@uploadCtx"
               Idorg="@curOrga.Idorg"
               EntyTiw="null"
               EntyTie="@EditTie"
               LsmVars="@LsVars"
               Oparent="1">
    </GlobModal>
}

<div class="my-container">
    @if (toChild != null)
    {
        @ChildContent
    }
</div>

@if (!isLoading)
{
    <AuthorizeView>
        <Authorized Context="authtiecontext">
            <div class="d-flex align-items-center gap-2">
                @if (GtieMode == GridMode.TiersAdding || GtieMode == GridMode.TiersEditing)
                {
                    <Button Color="ButtonColor.Success"
                            Size="ButtonSize.Small"
                            Class="px-2 py-1 small-btn"
                            @onclick="() => ConfirmPerson(curTie)">
                        ✅ Confirm
                    </Button>
                    <Button Color="ButtonColor.Secondary"
                            Size="ButtonSize.Small"
                            Class="px-2 py-1 small-btn"
                            @onclick="() => CancelPerson(curTie)">
                        ❌ Cancel
                    </Button>
                    <Button Color="ButtonColor.Info"
                            Size="ButtonSize.Small"
                            Class="px-2 py-1 small-btn"
                            @onclick="ShowModal">
                        piece(s)
                    </Button>
                }
            </div>
            <div class="container">
                <Tabs>
                    <Tab Title="Enrollé" Name="TieTab" onClick="() => OnTabChanged(1)">
                        <Content>
                            <EditForm Context="invform" Model="curTie">
                                <DataAnnotationsValidator />
                                <ValidationSummary />
                                <!-- Explicit immatriculation "> first -->
                                <RegistrationInput Sorga="@Sorga"
                                                   Ugpe="@Ugpe"
                                                   Sgpe="@Sgpe"
                                                   Saffilia="@Saffilia"
                                                   IsProvisional="true"
                                                   VientDe="2"
                                                   AjtState="@(GtieMode == GridMode.TiersAdding)"
                                                   OnAddNewTie="StartTieNew"
                                                   GenerationMode="MatriculeGenerationMode.Local"
                                                   @bind-Value="Smatri"
                                                   IsBusy="@IsBusy"
                                                   ValidChanged="OnSmatriValidChanged" />

                                <PTieGdHelper Idorg="@curOrga.Idorg" Entity="@curTie"
                                              Draft="@(GetDraft(EntityLevel.Tie) as TierspDto)"
                                              PrefReader="@_prefReader"
                                              IsEditing="@IsTieEditing(curTie)"
                                              ConfState="@ConfState"
                                              EnsTbls="@EnsTbls"
                                              EnsAtrs="@EnsAtrs"
                                              Ugpe="@Ugpe"
                                              OnConfirm="@ConfirmPerson"
                                              OnCancel="@CancelPerson"
                                              AflItems="@AflItems"
                                              ChildBusy="@ChildBusy"
                                              IsEditingFn="@(a => IsAflEditing(a))"
                                              GetDraftFn="@(() => GetDraft(EntityLevel.Afl) as TieaflDto)"
                                              OnStartEditAfl="@StartEditAfl"
                                              OnConfirmAfl="@ConfirmAfl"
                                              OnCancelAfl="@CancelAfl"
                                              OnDeleteAfl="@(a => StartRowDelete(EntityLevel.Afl, a.Rowguid))"
                                              GroupOptions="@ChldAfls.Where(af => af.Atyp == Ugpe && af.Elea is >= 2 and <= 6).ToList()"
                                              SelectedGroup="@IMyGAfl"
                                              ChldMatri="@ChldMatri"
                                              SelectedGroupChanged="@(v => IMyGAfl = v)"
                                              OnAddChild="@AddChild" />
                            </EditForm>
                        </Content>
                    </Tab>
                    <Tab Title="Plus..." Name="TiwTab" onClick="() => OnTabChanged(2)">
                        <Content>
                            <!-- Additional dynamic Categories -->
                            <label class="fw-bold mt-3 d-block">CATEGORIE++(s)</label>
                            <div class="card-body p-3">
                                @RenderCategories(EnsCats.Where(c => c.Pid == null))
                            </div>

                            @if (curOrga != null && canOpenAdres && !string.IsNullOrEmpty(curTie?.Smatri))
                            {
                                <Gstadr @bind-NbChanges="_nbChanges" curOrga="@curOrga" _guard="@Guard"
                                      EnsTbls="@EnsTbls" Actx="@Actx" />
                            }
                            @* </div> *@
                        </Content>
                    </Tab>
                    <Tab Title="Validation" Name="TiwTab" onClick="() => OnTabChanged(3)">
                        <Content>
                            @if (canbeVerified)
                            {
                                <div class="container row">
                                    <Grid TItem="TierspDto" Data="@WaitingTiersps" AllowSelection="true"
                                          SelectionMode="GridSelectionMode.Multiple" Responsive="true">
                                        <GridColumns>
                                            <GridColumn TItem="TierspDto" HeaderText="No">
                                                <ChildContent Context="item">
                                                    <span>@(item.Xedt1 == -1 ? item?.Iui : (item?.Iui == 0 ? item?.Iele : item?.Iui))</span>
                                                </ChildContent>
                                            </GridColumn>
                                            <GridColumn TItem="TierspDto" HeaderText="Matricule">
                                                <ChildContent Context="item">@item.Smatri</ChildContent>
                                            </GridColumn>
                                            <GridColumn TItem="TierspDto" HeaderText="Institution">
                                                <ChildContent Context="item">@item.Xmatri</ChildContent>
                                            </GridColumn>
                                            <GridColumn TItem="TierspDto" HeaderText="Dossier">
                                                <ChildContent Context="item">@item.Zmatri</ChildContent>
                                            </GridColumn>
                                            <GridColumn TItem="TierspDto" HeaderText="Nom">
                                                <ChildContent Context="item">@item.Nom</ChildContent>
                                            </GridColumn>
                                            <GridColumn TItem="TierspDto" HeaderText="Pnom">
                                                <ChildContent Context="item">@item.Pnom</ChildContent>
                                            </GridColumn>
                                            <GridColumn TItem="TierspDto" HeaderText="etat" IsVisible="true">
                                                <ChildContent Context="item">
                                                    <InputSelect @bind-Value="item.Eta" disabled="true">
                                                        <option class="jchx" value=0>?choisir</option>
                                                        @foreach (var tob in LsFixes.Where(ut => ut.Gvars == 32 && ut.Itb == 1 && ut.Elea != 0))
                                                        {
                                                            <option value=@tob.Elea>@tob.Liba</option>
                                                        }
                                                    </InputSelect>
                                                </ChildContent>
                                            </GridColumn>
                                            <GridColumn TItem="TierspDto" HeaderText="Actions" Filterable="false" Class="xcol2 actions-col">
                                                <ChildContent Context="item">
                                                    <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small"
