                        </Content>
                    </Tab>
                    <Tab Title="Carte" Name="TieTab" onClick="() => OnTabChanged(6)">
                        <Content>
                            <span>Carte</span>
                            <RtV11Fic curOrga="@curOrga"
                                      _InODaClient="@_InODaClient"
                                      toChild="@toChild"
                                      curTie="@curTie">
                            </RtV11Fic>
                        </Content>
                    </Tab>
                </Tabs>
            </div>
        </Authorized>
    </AuthorizeView>
}

