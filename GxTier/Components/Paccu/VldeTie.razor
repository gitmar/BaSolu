                                                        Details
                                                    </Button>
                                                </ChildContent>
                                            </GridColumn>
                                        </GridColumns>
                                    </Grid>
                                </div>
                            }
                        </Content>
                    </Tab>
                    <Tab Title="EnAttente" Name="Tietab" onClick="() => OnTabChanged(4)">
                        <Content>
                            Tiewel en attente validation
                        </Content>
                    </Tab>
                    <Tab Title="Contrat" Name="TieTab" onClick="() => OnTabChanged(5)">
                        <Content>
                            <span>Contrat</span>
