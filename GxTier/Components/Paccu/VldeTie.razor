    protected override async Task OnInitializedAsync()
    {
        isLoading = false;
        try
        {
            _dftClient = _clientFactory.CreateClient("AUTHClient");
            if (toChild == null || curOrga == null)
            {
                Console.WriteLine("Missing parent data");
                return;
            }
            LsFixes = toChild.LsFixes;
            LsVars = toChild.LsVars;
            LsPlans = toChild.LsPlans;
            //Ityp:options Oui/Non
            GpeAfls = LsVars.Where(uv => uv.Gvars == 3 && uv.Itb == 5 && uv.Ityp == 1 && uv.Elea != 0).ToList();
            ChldAfls = LsVars.Where(uv => uv.Gvars == 3 && uv.Itb == 6 && uv.Ityp == 1 && uv.Elea != 0).ToList();

            Console.WriteLine("✅ LoadOrgaVariabs done");
            //limites
            _lgcdu = curOrga.Lftrub ?? 3;
            _lgfmt = curOrga.Ftrub ?? "";
            Console.WriteLine($"lsplans {LsPlans.Count} IS NULL");

            //InitializeMyDaPlans();
            //InitializeMyDaRubs();  // If you have this
            //InitializeMyDaFmts();

            //Console.WriteLine($"MyDaPlans initialized: {MyDaPlans.Count}");
            TieItems.Clear();
            if (orgTiers?.Any() == true)
            {
                TieItems.AddRange(orgTiers);
                curTie = TieItems.First();
            }
            int myIdorg = curOrga?.Idorg ?? 0;
            var bgresponse = await _dftClient.GetFromJsonAsync<Acatbag>($"olines/acatbag/{myIdorg}", default);
            if (bgresponse != null)
            {
                Console.WriteLine($"✅ Acatbag loaded: {bgresponse.Natrs.Count} attributes, {bgresponse.Ncats.Count} categories");
                _acatBag = bgresponse;
                EnsAtrs = _acatBag.Natrs;
                EnsCats = _acatBag.Ncats;
            }
            else
            {
                Console.WriteLine("Missing attribut/categories data");
                return;
            }
            BuildHierarchy();
            //atrTitle = "Saisie";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Child crash: {ex.Message}");
            Console.WriteLine($"Stack: {ex.StackTrace}");
            Imessage = $"Erreur chargement: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
        isLoading = false;
        //Imessage = "InscTie charged";
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        Sorga = curOrga?.Idorg.ToString() ?? "";
        Saffilia = "T";

        Sgpe = Ugpe switch
        {
            1 => "1CB",
            2 => "2OP",
            3 => "3CL",
            4 => "4FN",
            5 => "5PA",
            _ => "1CB"
        };
    }

    protected override void SubscribeToGuard() { }

    //build hierarchy
    private void BuildHierarchy()
    {
        var lookup = EnsCats.ToDictionary(c => c.Id);

        foreach (var cat in EnsCats)
        {
            if (cat.Pid != null && lookup.TryGetValue(cat.Pid.Value, out var parent))
            {
                cat.Parent = parent;
                parent.Children.Add(cat);
            }
        }
    }

    private void OnTabChanged(int tabIndex)
    {
        refTab = tabIndex;
        canOpenAdres = false;
        if (refTab == 2 && curOrga != null)
        {
            Actx = new()
            {
                Agpe = Ugpe, //tie
                Orig = 2, //enreg..1tiw2tie 9orga
                Itie = curTie.Id,
                Itiw = 0,
                Iefl = 0,
                Iwfl = 0
            };
            canOpenAdres = true;
        }
    }
    private async Task StartTieNew(string? matricule)
    {
        var newTie = new TierspDto
        {
            Rowguid = Guid.NewGuid(),
            Idorg = curOrga.Idorg,
            Utyp = Ugpe,
            Smatri = matricule ?? "",
            Xmatri = "",
            Zmatri = "",
            Nom = "",
            Pnom = "",
            Datc = DateTime.Now,
            Eta = 1
        };

        await StartRowAdd(
            EntityLevel.Tie,
            newTie,
            TieItems,
            d => SetDraft(EntityLevel.Tie, d));

        curTie = newTie;

        GtieMode = GridMode.TiersAdding;

        SetRowState(
            EntityLevel.Tie,
            newTie.Rowguid,
            RowState.AddPending);
    }

    private async Task StartEditTie(TierspDto item)
        => await StartRowEdit(EntityLevel.Tie, item, _edTieOriginals, d => SetDraft(EntityLevel.Tie, d));

    private async Task StartEditAfl(TieaflDto item)
        => await StartRowEdit(EntityLevel.Afl, item, _edAflOriginals, d => SetDraft(EntityLevel.Afl, d));
    // Affiliates of a saved person are tracked on their own; those of a new person ride in its insert.
    protected override bool TrackOnItsOwn(EntityLevel level, object entity)
    {
        if (level != EntityLevel.Afl || entity is not TieaflDto a) return true;
        var parent = TieItems.FirstOrDefault(t => t.Rowguid == a.Prowguid) ?? curTie;
        return parent.Id > 0;
    }
    // OlneInsc only:  protected override bool TrackOnItsOwn(EntityLevel l, object e) => false;

    // Keep curTie.Tieafls in step, but only for a new person (the payload needs it; display uses WflItems)
    protected override void OnLocalCollectionMutated(EntityLevel level, CollectionMutation mutation, object entity)
    {
        if (level != EntityLevel.Afl || entity is not TieaflDto a) return;
        var parent = TieItems.FirstOrDefault(t => t.Rowguid == a.Prowguid) ?? curTie;
        if (parent.Id > 0) return;

        if (mutation == CollectionMutation.Added && !parent.Tieafls.Any(x => x.Rowguid == a.Rowguid))
            parent.Tieafls.Add(a);
        else if (mutation == CollectionMutation.Removed)
            parent.Tieafls.RemoveAll(x => x.Rowguid == a.Rowguid);
    }

    private async Task ConfirmPerson(TierspDto person)
    {
        if (ChildBusy)
        {
            Imessage = "Terminez ou annulez l'affilié en cours avant de valider la personne.";
            return;
        }
        if (GetEditState(EntityLevel.Tie).IsAdd)
        {
            await ConfirmAdd(EntityLevel.Tie, person, true);
            ConfState = AddEdtMode.AddPConfirmed;
        }
        else
        {
            await ConfirmEdit(EntityLevel.Tie, person, true);
            ConfState = AddEdtMode.EdtPConfirmed;
        }
        GtieMode = GaflMode = GridMode.None;
    }

    private async Task CancelPerson(TierspDto person)
    {
        if (ChildBusy && GetDraft(EntityLevel.Afl) is TieaflDto d
            && AflItems.FirstOrDefault(a => a.Rowguid == d.Rowguid) is { } open)
            await CancelAfl(open);                                   // its draft belongs to this person

        var wasAdd = GetEditState(EntityLevel.Tie).IsAdd;
        if (wasAdd) await CancelAdd(EntityLevel.Tie, person);
        else await CancelEdit(EntityLevel.Tie, person);

        if (wasAdd) AflItems.RemoveAll(w => w.Prowguid == person.Rowguid && w.Id == 0);   // children of a person that never existed
        GtieMode = GaflMode = GridMode.None;
    }

    private async Task AddChild(int selectedGroup)
    {
        var parent = curTie;
        if (string.IsNullOrEmpty(curTie.Smatri))
        {
            Imessage = "Matricule tiers obligatoire";
            return;
        }
        ChldMatri = "";
        var s2afilia = "";
        s2afilia = selectedGroup switch
        {
            1 => "T",
            2 => "C",
            3 => "P",
            4 => "E",
            5 => "G",
            6 => "F",
            _ => "T"
        };
        try
        {
            var cgenmatri = await _mordService.GenerateOrdreAsync(
                Sorga, Ugpe, Sgpe, s2afilia,
                MatriculeGenerationMode.Local, default);
            ChldMatri =
                $"PV-{Sorga}-{Sgpe}-{cgenmatri}{s2afilia}";
            Console.WriteLine($"[StartTieNew] Generated matricule: '{s2afilia}'");
        }
        catch (Exception ex)
        {

        }
        var newAfl = new TieaflDto
        {
            Rowguid = Guid.NewGuid(),
            Prowguid = parent.Rowguid,
            Itie = parent.Id,                                         // 0 while the person is new
            Tyafl = selectedGroup,
            Smatri = ChldMatri,
            Xmatri = "",
            Zmatri = "",
            Irang = NextSeq(AflItems.Where(a => a.Prowguid == parent.Rowguid), p => p.Iui),
            Nom = "",
            Pnom = "",
            Datc = DateTime.Now,
            Eta = 1
        };
        GaflMode = GridMode.AflsAdding;
        //curTie.Tieafls.Add(newAfl); // Add the new child to the parent collection
        await StartRowAdd(EntityLevel.Afl, newAfl, AflItems, d => SetDraft(EntityLevel.Afl, d));
        // no curTie.Tieafls.Add here: the hook adds it when the affiliate is confirmed
        Console.WriteLine($"[AddChild] AflItems={AflItems.Count}, add-state={GetEditState(EntityLevel.Afl).IsAdd}");
    }
    public async Task<List<string>> ValidateForSaveAsync()
    {
        static string Who(string? nom, string? pnom, string fallback)
            => string.IsNullOrWhiteSpace($"{nom} {pnom}") ? fallback : $"{nom} {pnom}".Trim();

        // Only inserts and updates need checking; a pending delete must not be blocked.
        bool NeedsCheck(EntityLevel level, Guid rowguid)
            => GetOpInfo(level, rowguid)?.OpType is PendingOpType.Insert or PendingOpType.Update;

        bool Include(EntityLevel level, object e, Guid rowguid)
            => !TrackOnItsOwn(level, e) || NeedsCheck(level, rowguid);

        var items = new List<(EntityLevel Level, ColPrefContext Ctx, object Model, string Title)>();

        foreach (var tie in TieItems.Where(t => Include(EntityLevel.Tie, t, t.Rowguid)))
            items.Add((EntityLevel.Tie, ColumnContexts.Person(Ugpe), EditTarget(EntityLevel.Tie, tie), Who(tie.Nom, tie.Pnom, "Personne")));

        foreach (var afl in AflItems.Where(a => Include(EntityLevel.Afl, a, a.Rowguid)))
            items.Add((EntityLevel.Afl, ColumnContexts.Affiliate(afl.Tyafl), EditTarget(EntityLevel.Afl, afl), "Affilié " + Who(afl.Nom, afl.Pnom, "")));
        foreach (var tie in TieItems.Where(t => NeedsCheck(EntityLevel.Tie, t.Rowguid)))
            items.Add((EntityLevel.Tie, ColumnContexts.Person(Ugpe), tie,
                       Who(tie.Nom, tie.Pnom, "Personne")));

        var problems = await _colValidator.ValidateManyAsync(
            curOrga.Idorg, items.Select(i => (i.Ctx, i.Model, i.Title)));

        // Business rules (minimum lengths...). Skipped if you don't override Validate(level, entity).
        foreach (var (level, _, model, title) in items)
            if (!Validate(level, model))
                problems.Add($"{title} : {Imessage}");

        return problems;
    }
    private async Task ConfirmAfl(TieaflDto item)
    {
        var es = GetEditState(EntityLevel.Afl);
        if (es.IsAdd) await ConfirmAdd(EntityLevel.Afl, item, true);
        else await ConfirmEdit(EntityLevel.Afl, item, true);
    }

    private async Task CancelAfl(TieaflDto item)
    {
        var es = GetEditState(EntityLevel.Afl);
        if (es.IsAdd) await CancelAdd(EntityLevel.Afl, item);
        else await CancelEdit(EntityLevel.Afl, item);
    }

    private async Task ConfirmDeleteAfl(TieaflDto a)
    {
        if (a.Id == 0)   // never saved: nothing to delete on the server
        {
            RemoveByRowguid(EntityLevel.Afl, a.Rowguid);
            ResetRowState(EntityLevel.Afl, a.Rowguid);
            return;
        }
        await ConfirmDelete(EntityLevel.Afl, a, true);
    }

    private async Task VueDetails(EntityLevel level, object entity)
    {
        var rowguid = MLEntityKeyHelper.GetRowguidAsGuid(entity);
        if (level == EntityLevel.Tie)
        {
            //mstrTie = "";
            curTie = (TierspDto)entity;
            if (curTie != null)
            {
                //mstrTie = curTie.Zmatri + "/" + curTie.Nom + " " + curTie.Pnom;
            }

            // if (gTieModal != null)
