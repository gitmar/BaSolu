@using GxShared.Others
@using GxShared.Helpers
@using GxShared.GxDtos
@using GxShared.Sess
@using GxShared.Cols.Models
@using GxTie.Components
@using GxTie.Components.Cols
@using Newtonsoft.Json

<div class="card">
    <div class="card-body p-3">
        @if (_error is not null)
        {
            <div class="alert alert-danger py-1">@_error</div>
        }

        @foreach (var wfl in SubAfls)
        {
            var editing = IsEditingFn(wfl);
            var model = editing ? (GetDraftFn() ?? wfl) : wfl;
            var itemCtx = ColumnContexts.Affiliate(model.Tyafl);

            <div class="border-bottom pb-2 mb-2" @key="wfl.Rowguid">
                @if (editing)
                {
                    <ColDrivenFields @ref="_editingFields" Idorg="@Idorg" PColCtx="@itemCtx"
                                     PrefReader="@PrefReader" Model="@model"
                                     EnsTbls="@EnsTbls" IsEditing="true" />
                     <div class="d-flex gap-2 mt-1">
                        <Button Color="ButtonColor.Success" Size="ButtonSize.Small"
                                @onclick="() => ConfirmAsync(wfl)">✅Confirm</Button>
                        <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small"
                                @onclick="() => CancelAsync(wfl)">✖Cancel</Button>
                    </div>
                }
                else if (IsDeletingFn(wfl))
                {
                    <ColDrivenFields Idorg="@Idorg" PColCtx="@itemCtx" PrefReader="@PrefReader"
                        Model="@model" EnsTbls="@EnsTbls" IsEditing="false" />
                    <div class="d-flex gap-2 mt-1">
                        <Button Color="ButtonColor.Danger" Size="ButtonSize.Small"
                            @onclick="() => OnConfirmDelete.InvokeAsync(wfl)">⚠️ Confirmer la suppression</Button>
                        <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small"
                            @onclick="() => OnCancelDelete.InvokeAsync(wfl)">❎ Annuler</Button>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public int Idorg { get; set; }
    [Parameter, EditorRequired] public TiewelDto CurTiw { get; set; } = default!;
    [Parameter, EditorRequired] public List<TiwaflDto> WflItems { get; set; } = new();
    [Parameter, EditorRequired] public List<Gtabl> EnsTbls { get; set; } = new();

    [Parameter] public IColumnPreferencesReader? PrefReader { get; set; }

    //[Parameter] public bool IsViewing { get; set; }

    [Parameter] public bool IsAnyEditing { get; set; }
    [Parameter, EditorRequired] public Func<TiwaflDto, bool> IsEditingFn { get; set; } = default!;
    [Parameter, EditorRequired] public Func<TiwaflDto?> GetDraftFn { get; set; } = default!;

    [Parameter] public EventCallback<TiwaflDto> OnStartEdit { get; set; }
    [Parameter] public EventCallback<TiwaflDto> OnConfirm { get; set; }
    [Parameter] public EventCallback<TiwaflDto> OnCancel { get; set; }
    [Parameter] public EventCallback<TiwaflDto> OnDelete { get; set; }
    [Parameter] public Func<TiwaflDto, bool> IsDeletingFn { get; set; } = _ => false;
    [Parameter] public EventCallback<TiwaflDto> OnConfirmDelete { get; set; }
    [Parameter] public EventCallback<TiwaflDto> OnCancelDelete { get; set; }

    private ColDrivenFields? _editingFields;

    [Parameter] public int SelectedGroup { get; set; } //affilie
    private string? _error;

    private List<TiwaflDto> SubAfls => WflItems
        .Where(w => w.Prowguid == CurTiw.Rowguid || (CurTiw.Id > 0 && w.Itiw == CurTiw.Id))
        .ToList();

    private async Task ConfirmAsync(TiwaflDto wfl)
    {
        if (_editingFields is not null && !_editingFields.Validate())
        {
            _error = "Champs obligatoires : " + string.Join(", ", _editingFields.MissingLabels);
            return;
        }
        //a verifier: si ajout d'affilie, il faut ajouter l'affilie à la liste des affiliés du parent (CurTiw)
        _error = null;
        await OnConfirm.InvokeAsync(wfl);
    }

    private async Task CancelAsync(TiwaflDto wfl)
    {
        _error = null;
        await OnCancel.InvokeAsync(wfl);
    }
}