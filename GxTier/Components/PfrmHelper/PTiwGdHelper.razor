@using GxShared.Others
@using GxShared.Helpers
@using GxShared.GxDtos
@using GxShared.Sess
@using GxShared.Cols.Models
@using GxTie.Components
@using GxTie.Components.Cols
@using Newtonsoft.Json

<!-- Person -->
<div class="card mb-3">
    <div class="card-body p-3">
        <ColDrivenFields @ref="_fields" PrefReader="@PrefReader" Idorg="@Idorg" PColCtx="@Ctx"
                         Model="@CurrentPerson" EnsTbls="@EnsTbls" IsEditing="@IsEditing" />
        <div>
            @* EnsAtrs.Count = @EnsAtrs.Count
            <br />
            Ugpe = @Ugpe
            <br />
            Matching = @EnsAtrs.Count(a => a.Totyp == Ugpe && a.Eta == 1)
            totyp foreach :
            @foreach (var a in EnsAtrs.Where(a => a.Eta == 1))
            {
                <div>@a.Totyp et @a.Liba</div>
            } *@
        </div>
        <PlusAttributeFields Definitions="@EnsAtrs.AttributesFor((int)Ugpe)"
                             Values="@CurrentPerson.Tiejatrs"
                             EnsTbls="@EnsTbls" IsEditing="@IsEditing" />

        @if (_error is not null)
        {
            <div class="alert alert-danger py-1">@_error</div>
        }

        @if (IsEditing)
        {
            <div class="d-flex align-items-center gap-2 mt-2">
                <Button Color="ButtonColor.Success" Disabled="@ChildBusy" Size="ButtonSize.Small" @onclick="ConfirmAsync">✅ Confirm</Button>
                <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small" @onclick="CancelAsync">✖ Cancel</Button>
                @if (ChildBusy)
                {
                    @* <small class="text-muted">Terminez ou annulez l'affilié en cours.</small> *@
                }
            </div>
        }
    </div>
</div>

<!-- Affiliates -->
@if (ShowAffiliates)
{
    <!-- Generated matricule -->
    <div class="matricule-row">
        <label class="fw-bold">Affiliés</label>
        <span class="fw-bold text-nowrap">
            @ChldMatri
        </span>
    </div>
    @if (CanAddEdtChild)
    {
        <div class="d-flex align-items-center gap-2 mb-2">
            <label>Groupe :</label>
            <InputSelect TValue="int" Value="SelectedGroup"
                         ValueChanged="EventCallback.Factory.Create<int>(this, OnGroupChanged)"
                         ValueExpression="@(() => SelectedGroup)">
                <option value="0">Sélectionner...</option>
                @foreach (var g in GroupOptions) 
                {
                    <option value="@g.Elea">@g.Liba</option>
                }
            </InputSelect>
            <Button Color="ButtonColor.Primary" Size="ButtonSize.Small"
                    Disabled="@(SelectedGroup < 1 || ChildBusy)"
                    @onclick="() => OnAddChild.InvokeAsync(SelectedGroup)">
                ➕ Ajt Affilié
            </Button>
        </div>
    }

    <CTiwGdHelper Idorg="@Idorg" CurTiw="@Entity" WflItems="@WflItems" EnsTbls="@EnsTbls"
                  SelectedGroup="@SelectedGroup"
                  PrefReader="@PrefReader"
                  IsAnyEditing="@ChildBusy"
                  IsEditingFn="@IsEditingFn"
                  GetDraftFn="@GetDraftFn"
                  IsDeletingFn="@IsDeletingFn"
                  OnStartEdit="@OnStartEditAfl"
                  OnConfirm="@OnConfirmAfl"
                  OnCancel="@OnCancelAfl"
                  OnDelete="@OnDeleteAfl"
                  OnConfirmDelete="@OnConfirmDeleteAfl"
                  OnCancelDelete="@OnCancelDeleteAfl" />
}
else
{
    <div class="text-muted small">
        Affiliés non disponibles :
        @if (!HasMatricule) { <text>saisissez d'abord le matricule.</text> }
        else { <text>aucun groupe d'affiliés configuré pour cette catégorie.</text> }
    </div>
}
<!-- Affiliates — folded in, no separate tab -->
@* <p>matricule arrive : @Entity?.Zmatri</p>
<p>groupes options : @GroupOptions.Count</p> *@

@code {
    // --- Person-level ---
    [Parameter, EditorRequired] public int Idorg { get; set; }
    [Parameter, EditorRequired] public TiewelDto Entity { get; set; } = default!;
    [Parameter] public TiewelDto? Draft { get; set; }
    [Parameter] public IColumnPreferencesReader? PrefReader { get; set; }

    [Parameter, EditorRequired] public List<Gtabl> EnsTbls { get; set; } = new();
    [Parameter, EditorRequired] public List<Gpatr> EnsAtrs { get; set; } = new();
    [Parameter] public int Ugpe { get; set; }
    [Parameter] public bool IsEditing { get; set; }
    [Parameter] public bool ChildBusy { get; set; }    

    //[Parameter] public PublicColumnFormValidator L1PrefReader { get; set; } = default!;
    [Parameter] public EventCallback<TiewelDto> OnConfirm { get; set; }
    [Parameter] public EventCallback<TiewelDto> OnCancel { get; set; }

    // --- Affiliate-level passthrough ---
    [Parameter, EditorRequired] public List<TiwaflDto> WflItems { get; set; } = new();
    [Parameter, EditorRequired] public Func<TiwaflDto, bool> IsEditingFn { get; set; } = default!;
    [Parameter, EditorRequired] public Func<TiwaflDto?> GetDraftFn { get; set; } = default!;
    [Parameter] public EventCallback<TiwaflDto> OnStartEditAfl { get; set; }
    [Parameter] public EventCallback<TiwaflDto> OnConfirmAfl { get; set; }
    [Parameter] public EventCallback<TiwaflDto> OnCancelAfl { get; set; }
    [Parameter] public EventCallback<TiwaflDto> OnDeleteAfl { get; set; }
    [Parameter] public Func<TiwaflDto, bool> IsDeletingFn { get; set; } = _ => false;
    [Parameter] public EventCallback<TiwaflDto> OnConfirmDeleteAfl { get; set; }
    [Parameter] public EventCallback<TiwaflDto> OnCancelDeleteAfl { get; set; }

    // --- Add-child controls ---
    [Parameter] public List<Gpvar> GroupOptions { get; set; } = new();
    [Parameter] public int SelectedGroup { get; set; }
    [Parameter, EditorRequired] public string? ChldMatri { get; set; }
    [Parameter] public EventCallback<int> SelectedGroupChanged { get; set; }
    [Parameter] public EventCallback<int> OnAddChild { get; set; }
    //[Parameter] public bool AjtState { get; set; }
    [Parameter] public AddEdtMode ConfState { get; set; } = AddEdtMode.None;
    
    // private bool CanEditChildren => AjtState &&
    //     !string.IsNullOrEmpty((IsEditing ? (Draft ?? Entity) : Entity).Zmatri) && GroupOptions.Any();

    private async Task OnGroupChanged(int value) => await SelectedGroupChanged.InvokeAsync(value);
    private ColDrivenFields _fields = default!;
    private string? _error;

    //private string ASorga = "";
    //private string ASafilia = "";
    //private string ASgpe = "";

    private TiewelDto CurrentPerson => IsEditing ? (Draft ?? Entity) : Entity;
    private ColPrefContext Ctx => ColumnContexts.Person(Ugpe);

    private bool HasMatricule => !string.IsNullOrEmpty(CurrentPerson.Zmatri);
    private bool HasAffiliates => WflItems.Any(w => w.Prowguid == Entity.Rowguid
                                             || (Entity.Id > 0 && w.Itiw == Entity.Id));
    private bool ShowAffiliates => HasMatricule && (GroupOptions.Any() || HasAffiliates);
    
    private bool CanAddEdtChild => (ConfState == AddEdtMode.AddPConfirmed || ConfState == AddEdtMode.EdtPConfirmed) 
          && !string.IsNullOrEmpty((IsEditing? (Draft ?? Entity) : Entity).Zmatri) && GroupOptions.Any();
    
    //private TiwaflDto SelectedAfil = new();
    
    private async Task ConfirmAsync()
    {
        if (!_fields.Validate())
        {
            _error = "Champs obligatoires : " + string.Join(", ", _fields.MissingLabels);
            return;
        }
        _error = null;
        await OnConfirm.InvokeAsync(Entity);
    }

    private async Task CancelAsync()
    {
        _error = null;
        await OnCancel.InvokeAsync(Entity);
    }
}