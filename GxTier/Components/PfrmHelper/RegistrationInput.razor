@using System.Text.RegularExpressions
@using GxTie.Services
@using GxShared.Sess

@inject IClientMatriculeOrdreService OrdreService

<div class="matricule-row">
    @if (VientDe == 1)
    {
    <span class="fw-bold text-nowrap">
        @(IsProvisional ? "PV-" : "")@Sorga-@Sgpe-
    </span>
    }
    else if (VientDe == 2)
    {
        <span class="fw-bold text-nowrap">
            @(IsProvisional ? "PV-" : "")@Sorga-@Sgpe-
        </span>
    }
    <input class="form-control matricule-input"
           value="@_ordre"
           @oninput="OnOrdreInput"
           maxlength="1"
           disabled="@IsReadOnly || IsBusy" />

    <span class="fw-bold text-nowrap">
        @Saffilia
    </span>
    @if (VientDe == 1)
    {
    <Button Color="ButtonColor.Primary"
            Size="ButtonSize.Small"
            Disabled="@AjtState"
            @onclick="AddNewTiwAsync">
        ➕ Ajt
    </Button>
    } else if (VientDe == 2)
    {
        <Button Color="ButtonColor.Primary"
            Size="ButtonSize.Small"
            Disabled="@AjtState"
            @onclick="AddNewTieAsync">
            ➕ Ajt
        </Button>
    }
</div>
<style>
.matricule-row {
    display: flex;
    align-items: center;
    gap: .5rem;
    flex-wrap: nowrap;
}

.matricule-input {
    width: 130px;
    min-width: 130px;
    max-width: 130px;
    text-align: center;
}

.matricule-row .btn {
    width: auto;
    white-space: nowrap;
}
</style>
@code {
    private bool _isValid;
    private bool _isGenerating;
    private string _errorMessage = string.Empty;

    [Parameter] public int VientDe { get; set; } = 0;
    [Parameter] public bool AjtState { get; set; } = false;

    [Parameter] public string Sorga { get; set; } = string.Empty;
    [Parameter] public int? Ugpe { get; set; } = 0;
    [Parameter] public string Sgpe { get; set; } = string.Empty;
    [Parameter] public string Saffilia { get; set; } = "T";
    [Parameter] public bool IsProvisional { get; set; } = true;

    [Parameter]
    public MatriculeGenerationMode GenerationMode { get; set; }
        = MatriculeGenerationMode.Local;

    [Parameter] public string? Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public EventCallback<bool> ValidChanged { get; set; }
    [Parameter] public EventCallback<string> OnAddNewTiw { get; set; }
    [Parameter] public EventCallback<string> OnAddNewTie { get; set; }

    [Parameter] public bool IsReadOnly { get; set; }
    [Parameter] public bool IsBusy { get; set; }
    //[Parameter] public bool InAddingMode { get; set; }

    private bool IsGenerating
    {
        get => _isGenerating;
        set => _isGenerating = value;
    }

    //private bool PeutGenerer => InAddingMode;
    private string _ordre = string.Empty;

    private int IvGroup => Ugpe ?? 0;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(Value))
        {
            ExtractOrdreFromValue();
        }

        Validate();
    }
    protected override async Task OnAfterRenderAsync(bool FirstRender)
    {
        if (FirstRender && VientDe == 2) //Onlne
        {
            await GenerateAsync();
        }
    }
    private void ExtractOrdreFromValue()
    {
        var parts = Value!.Split('-', StringSplitOptions.RemoveEmptyEntries);

        // PV-10001-1CB-1234567890T => index 3
        // 10001-1CB-1234567890T    => index 2
        var ordrePart = IsProvisional
            ? parts.ElementAtOrDefault(3)
            : parts.ElementAtOrDefault(2);

        if (string.IsNullOrWhiteSpace(ordrePart) || ordrePart.Length < 2)
        {
            _ordre = string.Empty;
            return;
        }

        // Remove the final affiliate letter: 1234567890T => 1234567890
        _ordre = ordrePart[..^1];
    }
    private async Task AddNewTiwAsync()
    {
        // Generate first
        await GenerateAsync();

        // Then notify parent
        await OnAddNewTiw.InvokeAsync(Value);
    }
    private async Task AddNewTieAsync()
    {
        // Generate first
        await GenerateAsync();

        // Then notify parent
        await OnAddNewTie.InvokeAsync(Value);
    }
    private async Task OnOrdreInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;

        var digits = new string(raw.Where(char.IsDigit).ToArray());

        if (_ordre == digits)
        {
            return;
        }

        _ordre = digits;

        await UpdateValueAsync();
    }

    private async Task GenerateAsync()
    {
        if (IsReadOnly || IsBusy || IsGenerating)
        {
            return;
        }
        _isGenerating = true;
        //IsGenerating = true;
        _errorMessage = string.Empty;

        try
        {
            _ordre = await OrdreService.GenerateOrdreAsync(
                Sorga,
                IvGroup,
                Sgpe,
                Saffilia,
                GenerationMode);

            await UpdateValueAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            IsGenerating = false;
        }
    }

    private async Task UpdateValueAsync()
    {
        Value = BuildMatricule();
        Console.WriteLine($"[Child] Value='{Value}'");

        await ValueChanged.InvokeAsync(Value);

        await ValidateAsync();
    }
    private string BuildMatricule()
    {
        if (string.IsNullOrWhiteSpace(_ordre))
        {
            return string.Empty;
        }

        return IsProvisional
            ? $"PV-{Sorga}-{Sgpe}-{_ordre}{Saffilia}"
            : $"{Sorga}-{Sgpe}-{_ordre}{Saffilia}";
    }

    private async Task ValidateAsync()
    {
        var isValid = IsValid();

        if (isValid == _isValid)
        {
            return;
        }

        _isValid = isValid;

        await ValidChanged.InvokeAsync(_isValid);
    }

    private void Validate()
    {
        var isValid = IsValid();

        if (isValid != _isValid)
        {
            _isValid = isValid;
            _ = ValidChanged.InvokeAsync(_isValid);
        }
    }

    private bool IsValid()
    {
        _errorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(_ordre))
        {
            _errorMessage = "Ordre is required.";
            return false;
        }

        if (!Regex.IsMatch(_ordre, @"^\d{10}$"))
        {
            _errorMessage = "Ordre must contain exactly 10 digits.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(Sorga))
        {
            _errorMessage = "Organization is required.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(Sgpe))
        {
            _errorMessage = "UGPE is required.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(Saffilia))
        {
            _errorMessage = "Affiliate is required.";
            return false;
        }

        var expected = IsProvisional
            ? $@"^PV-{Regex.Escape(Sorga)}-{Regex.Escape(Sgpe)}-\d{{10}}[A-Z]$"
            : $@"^{Regex.Escape(Sorga)}-{Regex.Escape(Sgpe)}-\d{{10}}[A-Z]$";

        if (string.IsNullOrWhiteSpace(Value) ||
            !Regex.IsMatch(Value!, expected))
        {
            _errorMessage = "Invalid matricule format.";
            return false;
        }

        var affiliate = Value![^1..];

        if (!string.Equals(affiliate, Saffilia, StringComparison.OrdinalIgnoreCase))
        {
            _errorMessage = $"Affiliate must be {Saffilia}.";
            return false;
        }

        return true;
    }
}