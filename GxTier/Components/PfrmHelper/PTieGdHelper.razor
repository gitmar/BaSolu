<!-- Person -->
<div class="card mb-3">
    <div class="card-body p-3">
        <ColDrivenFields @ref="_fields" PrefReader="@PrefReader" Idorg="@Idorg" PColCtx="@Ctx"
                         Model="@CurrentPerson" EnsTbls="@EnsTbls" Tgpe="@Ugpe" IsEditing="@IsEditing" />
        <div>
             EnsAtrs.Count = @EnsAtrs.Count
            <br />
            @*Ugpe = @Ugpe
            <br />
            Matching = @EnsAtrs.Count(a => a.Totyp == Ugpe && a.Eta == 1)
            totyp foreach :
            @foreach (var a in EnsAtrs.Where(a => a.Eta == 1))
            {
                <div>@a.Totyp et @a.Liba</div>
            } *@
        </div>
        <PlusAttributeFields Definitions="@EnsAtrs.AttributesFor((int)Ugpe)"
                             Values="@CurrentPerson.Tiejatrs" Tgpe="@Ugpe"
                             EnsTbls="@EnsTbls" IsEditing="@IsEditing" />

        @if (_error is not null)
        {
            <div class="alert alert-danger py-1">@_error</div>
        }
    </div>
</div>

<!-- Affiliates -->
@if (ShowAffiliates)
{
    <!-- Generated matricule -->
    <div class="matricule-row">
        <label class="fw-bold">Affiliés</label>
        <span class="fw-bold text-nowrap">
            @ChldMatri
        </span>
        @* <p>Zmatri-> @(Entity.Zmatri)</p>
        <p>Confstate -> @ConfState</p>
        <p>HasMatricule -> @HasMatricule</p>
        <p>HasAffiliates -> @HasAffiliates</p>
        <p>ShowAffiliates -> @ShowAffiliates</p> *@
    </div>
        
    <div class="d-flex align-items-center gap-2 mb-2">
        <label>Groupe :</label>
        <InputSelect TValue="int" Value="SelectedGroup"
                     ValueChanged="EventCallback.Factory.Create<int>(this, OnGroupChanged)"
                     ValueExpression="@(() => SelectedGroup)">
            <option value="0">Sélectionner...</option>
            @foreach (var g in GroupOptions)
            {
                <option value="@g.Elea">@g.Liba</option>
            }
        </InputSelect>
        <Button Color="ButtonColor.Primary" Size="ButtonSize.Small"
                Class="px-2 py-1 small-btn"
                Disabled="@(SelectedGroup < 1 || ChildBusy)"
                @onclick="() => OnAddChild.InvokeAsync(SelectedGroup)">
            ➕ Ajt Affilié
        </Button>
        @if (ChildBusy)
        {
            <Button Color="ButtonColor.Info" Size="ButtonSize.Small"
                    Class="px-2 py-1 small-btn"
                    disabled="!ChildBusy"
                    @onclick="ShowModal">
                pièce(s)
            </Button>
            <div class="d-flex align-items-center gap-2 mt-2">
                <Button Color="ButtonColor.Success" Disabled="@(!ChildBusy)" Size="ButtonSize.Small" 
                    Class="px-2 py-1 small-btn" 
                    @onclick="ConfirmAsync">
                    ✅ Confirm
                </Button>
                <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small" 
                    Class="px-2 py-1 small-btn" 
                    @onclick="CancelAsync">
                    ❌ Cancel
                </Button>
            </div>
        }
        @if (!ChildBusy)
        {
                <Button Color="ButtonColor.Success" Disabled="@ChildBusy" 
                    Size="ButtonSize.Small" 
                    Class="px-2 py-1 small-btn"
                    @onclick="ConfirmAsync">
                    ✅ Confirm
                </Button>
                <Button Color="ButtonColor.Secondary" 
                    Size="ButtonSize.Small"
                    Class="px-2 py-1 small-btn"
                    @onclick="CancelAsync">
                    ❌ Cancel
                </Button>
        }
    </div>
    <CTieGdHelper Idorg="@Idorg" CurTie="@Entity"
                  AflItems="@AflItems"
                  SelectedGroup="@SelectedGroup"
                  PrefReader="@PrefReader"
                  IsAnyEditing="@ChildBusy"
                  IsEditingFn="@IsEditingFn"
                  EnsTbls="@EnsTbls"
                  Kgpe="@Ugpe"
                  Efrm="@Efrm"
                  GetDraftFn="@GetDraftFn"
                  IsDeletingFn="@IsDeletingFn"
                  OnStartEdit="@OnStartEditAfl"
                  OnConfirm="@OnConfirmAfl"
                  OnCancel="@OnCancelAfl"
                  OnDelete="@OnDeleteAfl"
                  OnConfirmDelete="@OnConfirmDeleteAfl"
                  OnCancelDelete="@OnCancelDeleteAfl" />
}
else
{
    <div class="text-muted small">
        Affiliés non disponibles :
        @if (!HasMatricule) { <text>saisissez d'abord le matricule.</text> }
        else { <text>aucun groupe d'affiliés configuré pour cette catégorie.</text> }
    </div>
}

@code {
    // --- Person-level ---
    [Parameter] public int Efrm { get; set; } = ColumnContexts.TiewelEfrm;
    [Parameter, EditorRequired] public int Idorg { get; set; }
    [Parameter, EditorRequired] public TierspDto Entity { get; set; } = default!;
    [Parameter] public TierspDto? Draft { get; set; }
    [Parameter] public IColumnPreferencesReader? PrefReader { get; set; }

    [Parameter, EditorRequired] public List<Gtabl> EnsTbls { get; set; } = new();
    [Parameter, EditorRequired] public List<Gpatr> EnsAtrs { get; set; } = new();
    [Parameter, EditorRequired] public List<Gpvar> EnsVars { get; set; } = new();
    
    [Parameter] public int Ugpe { get; set; }
    [Parameter] public bool IsEditing { get; set; }
    [Parameter] public bool ChildBusy { get; set; }

    //[Parameter] public PublicColumnFormValidator L1PrefReader { get; set; } = default!;
    [Parameter] public EventCallback<TierspDto> OnConfirm { get; set; }
    [Parameter] public EventCallback<TierspDto> OnCancel { get; set; }

    // --- Affiliate-level passthrough ---
    [Parameter, EditorRequired] public List<TieaflDto> AflItems { get; set; } = new();
    [Parameter, EditorRequired] public Func<TieaflDto, bool> IsEditingFn { get; set; } = default!;
    [Parameter, EditorRequired] public Func<TieaflDto?> GetDraftFn { get; set; } = default!;
    [Parameter] public EventCallback<TieaflDto> OnStartEditAfl { get; set; }
    [Parameter] public EventCallback<TieaflDto> OnConfirmAfl { get; set; }
    [Parameter] public EventCallback<TieaflDto> OnCancelAfl { get; set; }
    [Parameter] public EventCallback<TieaflDto> OnDeleteAfl { get; set; }
    [Parameter] public Func<TieaflDto, bool> IsDeletingFn { get; set; } = _ => false;
    [Parameter] public EventCallback<TieaflDto> OnConfirmDeleteAfl { get; set; }
    [Parameter] public EventCallback<TieaflDto> OnCancelDeleteAfl { get; set; }

    // --- Add-child controls ---
    [Parameter] public List<Gpvar> GroupOptions { get; set; } = new();
    [Parameter] public int SelectedGroup { get; set; }
    [Parameter] public TieaflDto curAfl { get; set; }

    [Parameter, EditorRequired] public string? ChldMatri { get; set; }
    [Parameter] public EventCallback<int> SelectedGroupChanged { get; set; }
    [Parameter] public EventCallback<int> OnAddChild { get; set; }
    //[Parameter] public bool AjtState { get; set; }
    [Parameter] public AddEdtMode ConfState { get; set; } = AddEdtMode.None;

    // private bool CanEditChildren => AjtState &&
    //     !string.IsNullOrEmpty((IsEditing ? (Draft ?? Entity) : Entity).Zmatri) && GroupOptions.Any();

    private async Task OnGroupChanged(int value) => await SelectedGroupChanged.InvokeAsync(value);
    private ColDrivenFields _fields = default!;
    private string? _error;

    //private string ASorga = "";
    //private string ASafilia = "";
    //private string ASgpe = "";

    private TierspDto CurrentPerson => IsEditing ? (Draft ?? Entity) : Entity;
    //private ColPrefContext Ctx => ColumnContexts.Person(Ugpe);
    private ColPrefContext Ctx => ColumnContexts.Person(Ugpe, Efrm);  

    private bool HasMatricule => !string.IsNullOrEmpty(CurrentPerson.Zmatri);
    private bool HasAffiliates => AflItems.Any(w => w.Prowguid == Entity.Rowguid
                                             || (Entity.Id > 0 && w.Itie == Entity.Id));
    private bool ShowAffiliates => HasMatricule && (GroupOptions.Any() || HasAffiliates);

    // private bool CanAddEdtChild => (ConfState == AddEdtMode.AddPConfirmed || ConfState == AddEdtMode.EdtPConfirmed)
    //           && !string.IsNullOrEmpty((IsEditing ? (Draft ?? Entity) : Entity).Zmatri) && GroupOptions.Any();
    private bool AddEditingAffile => (ConfState == AddEdtMode.AddPConfirmed || ConfState == AddEdtMode.EdtPConfirmed)
          && !string.IsNullOrEmpty((IsEditing ? (Draft ?? Entity) : Entity).Zmatri) && GroupOptions.Any();

    private bool isAflModalVisible = false;

    public UplCxtDto uploadCtx { get; set; } = new();
    //private TieaflDto SelectedAfil = new();

    private async Task ConfirmAsync()
    {
        if (!_fields.Validate())
        {
            _error = "Champs obligatoires : " + string.Join(", ", _fields.MissingLabels);
            return;
        }
        _error = null;
        await OnConfirm.InvokeAsync(Entity);
    }

    private async Task CancelAsync()
    {
        _error = null;
        await OnCancel.InvokeAsync(Entity);
    }
    private void ShowModal() => isAflModalVisible = true;
    private Task OnAflModalVisibilityChanged(bool isVisible) { isAflModalVisible = isVisible; return Task.CompletedTask; }
}