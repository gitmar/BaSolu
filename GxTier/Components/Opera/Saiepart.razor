    private async Task OnLoadResetAsync()
    {
        if (!CanLoad)
            return;

        isBusy = true;
        try
        {
            var ctx = BuildSingleContext();
            if (ctx is null || ctx.Program is null || ctx.Tier is null)
                return;

            // Create a fresh SAIE session (no DB load here, just initialization)
            Session = await _workflowService.CreateSaieSessionAsync(
                ctx.Program,
                ctx.Tier,
                ctx.EnsTbls ?? new List<Gtabl>()
            );

            _saieSession = Session;

            EnsureRubVarRowsAndDetails(Session);
            BindLocalStateFromSession(Session); // rebuilds CalcContext from session

            _hasUserInput = false;
            _hasCalculated = false;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task OnCalculateAsync(bool isRecompute = false)
    {
        if (!CanCalc || _calcContext is null || Session is null)
            return;

        isBusy = true;
        try
        {
            // Step 1: Calculate via workflow
            Console.WriteLine("A COMMENCE");
            Session = await _workflowService.CalculateSaieAsync(_calcContext, Session);
            _saieSession = Session;
            Console.WriteLine("A FINI");
            // Step 2: Sync UI state from session
            BindLocalStateFromSession(Session);
            SyncSessionToGrid(Session);

            _hasCalculated = true;

            if (!isRecompute)
                Imessage = "Passe3";
        }
        finally
        {
            isBusy = false;
        }
    }

    private void SyncSessionToGrid(SaieSession session)
    {
        // Sync RubVarRows from Actsaies
        foreach (var act in session.Actsaies)
        {
            var row = session.RubVarRows.FirstOrDefault(r => r.Irub == act.Irub);
            if (row is not null)
            {
                row.Vgpe = act.Vgpe;
                row.Aval = act.Aval;
                row.Iraw = act.Iraw ?? string.Empty;
                row.InputValue = act.Inptvalue ?? row.InputValue;
            }
        }

        // Sync RubFmtRows (details) from Actdets
        foreach (var det in session.Actdets)
        {
            var master = session.RubVarRows.FirstOrDefault(r => r.Irub == det.Irub);
            if (master is null)
                continue;

            var detail = master.Details.FirstOrDefault(d => d.Ifmt == det.Ifmt);
            if (detail is not null)
            {
                detail.Vgpe = det.Vgpe;
                detail.Aval = det.Aval;
                detail.Iraw = det.Iraw ?? string.Empty;
                detail.InputValue = det.Inptvalue ?? detail.InputValue;
            }
        }
    }

    private IEnumerable<ProgramLine> GetSaieProgramLines(RubvarDto rubvar, IReadOnlyCollection<RubfmtDto> rubfmts)
    {
        var lines = _myLineParser.ParseProgramLines(rubvar?.Frsrc);
        return EnrichRubvarProgramLines(lines, rubvar, rubfmts);
    }

    private List<ProgramLine> EnrichRubvarProgramLines(
        List<ProgramLine> lines,
        RubvarDto rubvar,
        IReadOnlyCollection<RubfmtDto> rubfmts)
    {
        var fmtByLine = rubfmts
            .Select(x => new { Item = x, Ok = int.TryParse(x.Zcdrub, out var n), Num = n })
            .Where(x => x.Ok)
            .GroupBy(x => x.Num)
            .ToDictionary(g => g.Key, g => g.First().Item);

        foreach (var line in lines)
        {
            fmtByLine.TryGetValue(line.LineNumber ?? 0, out var rubfmt);

            line.Irub = rubvar.Id;
            line.Ifmt = rubfmt?.Id;
            line.Type = ProgramLineTypeMapper.MapType(line.Meta, rubvar, rubfmt);
            line.Liba = rubfmt?.Liba ?? rubvar.Liba;
            line.SaveDetail = ProgramLineTypeMapper.ShouldSaveDetail(line.Meta, rubvar, rubfmt);
        }

        return lines;
    }

    private void HandleVarInput(RubVarRow row, string val)
    {
        row.InputValue = val;
        _hasUserInput = true;
        _hasCalculated = false;
