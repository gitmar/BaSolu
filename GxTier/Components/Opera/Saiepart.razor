@inject MyAuthStateProvider _authprovider
@inject ILocalStorageService _localStorage
@inject IBlazorDownloadFileService DownloadService
@inject HttpClientService _cliemanager
@inject FormulaEvaluationService _myFService
@inject ICalculationPersistence _calcPersistence
@inject FormulaEngine _myFEngine
@inject RendAgres _rendAgres
@inject ICalculationService _calcService
@inject ICalculationWorkflow _workflowService
@inject IProgramLineParser _myLineParser
@inject IJSRuntime _jsRun

@* <h3>Saiepart</h3> *@
<PageTitle>Saisie Offline</PageTitle>
@if (!string.IsNullOrEmpty(Imessage))
{
    <div>@Imessage</div>
}

<div class="my-container">
    @if (toChild != null)
    {
        @ChildContent
    }
</div>

@if (isLoading)
{
    <div>Loading...</div>
}
else
{
    if (CanSaie)
    {
        <div class="d-flex align-items-center gap-3 mb-2 ms-2">
            <div class="col-auto"><label>Période :</label></div>
            <div class="col-auto">
                <InputSelect @bind-Value="SessionMonth" @bind-Value:after="OnSessionDateChanged">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m">@m</option>
                    }
                </InputSelect>
            </div>
            <div class="col-auto">
                <InputSelect @bind-Value="SessionYear" @bind-Value:after="OnSessionDateChanged">
                    @for (int y = DateTime.Today.Year - 3; y <= DateTime.Today.Year + 1; y++)
                    {
                        <option value="@y">@y</option>
                    }
                </InputSelect>
            </div>
            <div class="col-auto"><label>Override :</label></div>
            <div class="col-auto"><InputDate @bind-Value="GroupOverrideEddat" /></div>
            <div class="col-auto"><InputDate @bind-Value="GroupOverrideEfdat" /></div>
            <div class="col-auto">
                <Button Size="ButtonSize.Small"
                    @onclick="() => { GroupOverrideEddat = null; GroupOverrideEfdat = null; }">
                        Réinitialiser
                </Button>
            </div>
        </div>
        <div class="d-flex align-items-center gap-3 mb-2 ms-2">
            <!-- Label -->
            <label class="me-2">Personne :</label>
            <!-- AutoComplete -->
            <AutoComplete TItem="TierspDto"
                  @bind-Value="InTSaie"
                  DataProvider="LoadPreTiers"
                  PropertyName="@(displayMode == DisplayMode.Matricule ? "Xmatri" : "Nom")"
                  Placeholder="@(displayMode == DisplayMode.Matricule ? "Enter matricule..." : "Enter name...")"
                  OnChanged="OnMatriChhanged">
            </AutoComplete>
            <!-- Radio toggle -->
            <InputRadioGroup @bind-Value="displayMode" Orientation="Horizontal" class="d-flex flex-row gap-2">
                <InputRadio Value="DisplayMode.Matricule">Matricule</InputRadio>
                <InputRadio Value="DisplayMode.Name">Nom/Prenom</InputRadio>
            </InputRadioGroup>
            <!-- Dropdown -->
            <InputSelect @bind-Value="ImyTie" @bind-Value:after="OnTierChanged">
                <option value="0">-- Sélectionner --</option>
                @foreach (var tie in PreTiers)
                {
                    <option value="@tie.Id">@GetTierLabel(tie)</option>
                }
            </InputSelect>
        </div>
    }

    @if (isFicheVisible)
    {
        <RtS11Fic @ref="myfsaie"
            curOrga="@curOrga"
            toChild="@toChild"
            _curTier="@_curTier"
            _EdtODaClient="@_MyODaClient">
            <ChildContent>
                <h2 class="child-box">Fiche de @curProg.Liba</h2>
            </ChildContent>
        </RtS11Fic>
    }
    @if (CanSaie)
    {
    <Grid TItem="RubVarRow" Data="@WorkSession.RubVarRows" AllowPaging="true" Responsive="true">
        <GridColumns>
            <GridColumn TItem="RubVarRow" HeaderText="Code">
                <ChildContent Context="r">@r.Scdrub</ChildContent>
            </GridColumn>
            <GridColumn TItem="RubVarRow" HeaderText="Label">
                <ChildContent Context="r">@r.Liba</ChildContent>
            </GridColumn>
            <GridColumn TItem="RubVarRow" HeaderText="InpValue">
                <ChildContent Context="r">
                    @if (r.Atyp != 1)
                    {
                        <ValidateInput Atyp="@r.Atyp"
                                       @bind-Value="r.InputValue"
                                       ErrorMessage="Invalid value"
                                       OnValidInput="val => HandleVarInput(r, val?.ToString() ?? string.Empty)" />
                    }
                    else
                    {
                        @r.InputValue
                    }
                </ChildContent>
            </GridColumn>
            <GridColumn TItem="RubVarRow" HeaderText="Aval">
                <ChildContent Context="r">
                    @if (r.Atyp == 1)
                    {
                        <ValidateInput Atyp="@r.Atyp"
                                       @bind-Value="r.Aval"
                                       ErrorMessage="Invalid value"
                                       OnValidInput="val => HandleVarInput(r, val?.ToString() ?? string.Empty)" />
                    }
                    else
                    {
                        @r.Aval
                    }
                </ChildContent>
            </GridColumn>
            <GridColumn TItem="RubVarRow" HeaderText="">
                <HeaderContent>
                    <div class="d-flex align-items-center gap-2">
                        <Button Color="ButtonColor.Primary" Size="ButtonSize.Small"
                                disabled="@(!CanCalc)"
                                @onclick="() => OnCalculateAsync()">
                            Calculer
                        </Button>
                        <Button Color="ButtonColor.Success" Size="ButtonSize.Small"
                                disabled="@(!CanSave)"
                                @onclick="OnSaveAsync">
                            Accepter
                        </Button>
                    </div>
                </HeaderContent>
            </GridColumn>
        </GridColumns>
        <GridDetailView TItem="RubVarRow">
            <Grid TItem="RubFmtRow" Data="@context.Details" AllowPaging="false" Responsive="true">
                <GridColumns>
                    <GridColumn TItem="RubFmtRow" HeaderText="Code">
                        <ChildContent Context="d">@d.Scdfmt</ChildContent>
                    </GridColumn>
                    <GridColumn TItem="RubFmtRow" HeaderText="Label">
                        <ChildContent Context="d">@d.Liba</ChildContent>
                    </GridColumn>
                    <GridColumn TItem="RubFmtRow" HeaderText="InpValue">
                        <ChildContent Context="d">
                            @if (d.Atyp != 1)
                            {
                                <ValidateInput Atyp="@d.Atyp"
                                               @bind-Value="d.InputValue"
                                               ErrorMessage="Invalid value"
                                               OnValidInput="val => HandleFmtInput(context, d, val?.ToString() ?? string.Empty)" />
                            }
                            else
                            {
                                @d.InputValue
                            }
                        </ChildContent>
                    </GridColumn>
                    <GridColumn TItem="RubFmtRow" HeaderText="Aval">
                        <ChildContent Context="d">
                            @if (d.Atyp == 1)
                            {
                                <ValidateInput Atyp="@d.Atyp"
                                               @bind-Value="d.Aval"
                                               ErrorMessage="Invalid value"
                                               OnValidInput="val => HandleFmtInput(context, d, val?.ToString() ?? string.Empty)" />
                            }
                            else
                            {
                                @d.Aval
                            }
                        </ChildContent>
                    </GridColumn>
                </GridColumns>
            </Grid>
        </GridDetailView>
    </Grid>
    }
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public GxorgaDto curOrga { get; set; } = new();
    [Parameter] public ChildVars toChild { get; set; } = new();
    [Parameter] public int ImyDiv { get; set; }
    [Parameter] public int ChxGpe { get; set; }
    [Parameter] public List<TierspDto> PreTiers { get; set; } = new();
    [Parameter] public bool SessOpen { get; set; }

    [Parameter] public IPendingChangesGuard _guard { get; set; }
    [Parameter] public PendingSaveMode inSaveMode { get; set; }
    [Parameter] public SaieSession? _saieSession { get; set; }
    [Parameter] public DateTime? _sessionDate { get; set; }
    [Parameter] public CalcContext? _calcContext { get; set; }
    [Parameter] public IODataClient _MyODaClient { get; set; }
    [Parameter] public PlngenDto curProg { get; set; }

    // Parent-owned group filtering — Saiepart just consumes the result.
    [Parameter] public List<RubvarDto> SelectedRubvars { get; set; } = new();
    [Parameter] public List<Gpgrid> InsGpdata { get; set; } = new();
    //[Parameter] public int? SelectedGroupId { get; set;} = new();
    [Parameter] public DateTime? GroupOverrideEddat { get; set; } = new();
    [Parameter] public DateTime? GroupOverrideEfdat { get; set; } = new();

    [Parameter] public int NbChanges { get; set; }
    [Parameter] public EventCallback<int> NbChangesChanged { get; set; }

    [Inject] public IActsaieDataService _actsaieData { get; set; }  // new injection needed in Saiepart

    private RtS11Fic myfsaie;
    private TierspDto? _curTier;
    private int ImyTie = 0;
    private string InTSaie = "";

    // Period selection (org-decided granularity assumed monthly for now — see note below)
    private int SessionYear = DateTime.Today.Year;
    private int SessionMonth = DateTime.Today.Month;
    private DateTime SessionDate => new DateTime(SessionYear, SessionMonth, 1);

    // Group-level override — persists across tier changes until explicitly reset
    // or the selected group changes.
    private SaieSession WorkSession { get; set; } = new();
    private DisplayMode displayMode = DisplayMode.Matricule;
    public enum DisplayMode
    {
        Matricule = 1,
        Name = 2
    }

    ///private DateTime SessionDate = DateTime.Today;

    private List<RubvarDto>? _lastSelectedRubvars;

    private bool Yatier => ImyTie != 0;
    private bool CanSaie => SessOpen && ImyDiv != 0 && GroupOverrideEddat != null && GroupOverrideEfdat != null;
    private bool CanLoad => CanSaie && Yatier && !isBusy;
    private bool CanInput => WorkSession is not null && WorkSession.RubVarRows.Any();
    private bool CanCalc => CanInput && _hasUserInput && !isBusy;
    private bool CanSave => CanInput && _hasCalculated && !isBusy;

    private bool _hasUserInput;
    private bool _hasCalculated;

    private string Imessage = "";
    private string stopenFich = "OuvrirFiche";

    private int SaieDir = 1;
    private int _lgcdu = 3;

    private bool isLoading = true;
    private bool isBusy = false;
    private bool isFicheVisible = false;

    protected override async Task OnInitializedAsync()
    {
        isLoading = false; 
    }

    protected override Task OnParametersSetAsync()
    {
        if (_saieSession is not null)
        {
            WorkSession = _saieSession;
            BindLocalStateFromSession(WorkSession);
        }

        // Detect a change in the parent-selected group and rebuild rows accordingly.
        if (WorkSession is not null && !ReferenceEquals(SelectedRubvars, _lastSelectedRubvars))
        {
            _lastSelectedRubvars = SelectedRubvars;
            EnsureRubVarRowsAndDetails(WorkSession, forceRebuild: true);
        }

        return Task.CompletedTask;
    }
    private async Task RendsTier(int idtie)
    {
        if (idtie == 0)
        {
            _curTier = new TierspDto();
            if (WorkSession is not null)
                WorkSession.RubVarRows = new List<RubVarRow>();
        }
        else
        {
            _curTier = PreTiers.FirstOrDefault(t => t.Id == idtie) ?? new TierspDto();
            await OnLoadResetAsync();
        }
    }
    
    private async Task OnLoadResetAsync()
    {
        if (!CanLoad)
            return;

        isBusy = true;
        try
        {
            var ctx = BuildSingleContext();
            if (ctx is null || ctx.Program is null || ctx.Tier is null)
                return;

            // Per-tier fetch, replacing the old org-wide orgActs.
            var rubvarIds = ctx.Program.Rubvars.Select(r => r.Id).ToList();
            var (actsaies, actdets) = await _actsaieData.LoadForTierAsync(
                ctx.Tier.Id, curOrga.Idorg, SessionDate, rubvarIds);

            ctx.Actsaies = actsaies;
            ctx.Actdets = actdets;

            WorkSession = await _workflowService.CreateSaieSessionAsync(
                ctx.Program, ctx.Tier, ctx.EnsTbls ?? new List<Gtabl>(), InsGpdata ?? new List<Gpgrid>()
            );

            WorkSession.Actsaies = actsaies;
            WorkSession.Actdets = actdets;

            _saieSession = WorkSession;

            EnsureRubVarRowsAndDetails(WorkSession, forceRebuild: true); // forceRebuild since Actsaies/Actdets just changed
            BindLocalStateFromSession(WorkSession);

            _hasUserInput = false;
            _hasCalculated = false;
        }
        finally
        {
            isBusy = false;
        }
    }
    //private (DateTime Eddat, DateTime Efdat) ResolveRangeForCurrentGroup()
    //{
    //    if (GroupOverrideEddat.HasValue && GroupOverrideEfdat.HasValue)
    //        return (GroupOverrideEddat.Value, GroupOverrideEfdat.Value);

    //    var eddat = new DateTime(SessionYear, SessionMonth, 1);
    //    var efdat = new DateTime(SessionYear, SessionMonth, DateTime.DaysInMonth(SessionYear, SessionMonth));
    //    return (eddat, efdat);
    //}
    private async Task OnCalculateAsync(bool isRecompute = false)
    {
        if (!CanCalc || _calcContext is null || WorkSession is null)
            return;

        isBusy = true;
        try
        {
            WorkSession = await _workflowService.CalculateSaieAsync(_calcContext, WorkSession);
            _saieSession = WorkSession;

            BindLocalStateFromSession(WorkSession);
            SyncSessionToGrid(WorkSession);

            _hasCalculated = true;
        }
        finally
        {
            isBusy = false;
        }
    }
    

    private void OnSessionDateChanged()
    {
        // Period changed — re-fetch this tier's data for the new period, same as a group change.
        if (_curTier is not null && _curTier.Id != 0)
            _ = OnLoadResetAsync();
    }
    //private void OnPerioReInit()
    //{
    //    var curGpe = SelectedGroupId;
    //    SelectedGroupId = -1;
    //    SelectedGroupId = curGpe;
    //}
    private void SyncSessionToGrid(SaieSession session)
    {
        foreach (var act in session.Actsaies)
        {
            var row = session.RubVarRows.FirstOrDefault(r => r.Irub == act.Irub);
            if (row is not null)
            {
                row.Vgpe = act.Vgpe;
                row.Aval = act.Aval;
                row.Iraw = act.Iraw ?? string.Empty;
                row.InputValue = act.Inptvalue ?? row.InputValue;
            }
        }

        foreach (var det in session.Actdets)
        {
            var master = session.RubVarRows.FirstOrDefault(r => r.Irub == det.Irub);
            if (master is null)
                continue;

            var detail = master.Details.FirstOrDefault(d => d.Ifmt == det.Ifmt);
            if (detail is not null)
            {
                detail.Vgpe = det.Vgpe;
                detail.Aval = det.Aval;
                detail.Iraw = det.Iraw ?? string.Empty;
                detail.InputValue = det.Inptvalue ?? detail.InputValue;
            }
        }
    }

    private void HandleVarInput(RubVarRow row, string val)
    {
        row.InputValue = val;
        _hasUserInput = true;
        _hasCalculated = false;
    }

    private void HandleFmtInput(RubVarRow master, RubFmtRow detail, string val)
    {
        detail.InputValue = val;
        _hasUserInput = true;
        _hasCalculated = false;
    }

    private async Task OnSaveAsync()
    {
        if (!CanSave || _calcContext is null || WorkSession is null)
            return;

        isBusy = true;
        try
        {
            await _calcPersistence.TrackSaieChangesAsync(_calcContext, WorkSession);
        }
        finally
        {
            isBusy = false;
        }
    }

    private void EnsureRubVarRowsAndDetails(SaieSession session, bool forceRebuild = false)
    {
        session.RubVarRows ??= new List<RubVarRow>();

        var actByRub = session.Actsaies
            .Where(x => x.Irub.HasValue)
            .GroupBy(x => x.Irub!.Value)
            .ToDictionary(g => g.Key, g => g.First());

        var detByRubFmt = session.Actdets
            .Where(x => x.Irub.HasValue && x.Ifmt.HasValue)
            .GroupBy(x => (x.Irub!.Value, x.Ifmt!.Value))
            .ToDictionary(g => g.Key, g => g.First());

        if (forceRebuild || session.RubVarRows.Count == 0)
        {
            session.RubVarRows = SelectedRubvars
                .Select(rubvar =>
                {
                    actByRub.TryGetValue(rubvar.Id, out var act);

                    var details = rubvar.Rubfmts
                        .Select(rubfmt =>
                        {
                            detByRubFmt.TryGetValue((rubvar.Id, rubfmt.Id), out var det);

                            return new RubFmtRow
                            {
                                Id = rubfmt.Id,
                                Irub = rubvar.Id,
                                Vgpe = rubfmt.Vgpe,
                                Atyp = rubfmt.Ztyp ?? 0,
                                Ifmt = rubfmt.Id,
                                Scdfmt = rubfmt.Zcdrub,
                                Liba = rubfmt.Liba,
                                Ftsrc = rubfmt.Ftsrc,
                                InputValue = det?.Inptvalue ?? string.Empty,
                                Aval = det?.Aval,
                                Iraw = det?.Iraw?.ToString() ?? string.Empty
                            };
                        })
                        .ToList();

                    return new RubVarRow
                    {
                        Id = rubvar.Id,
                        Irub = rubvar.Id,
                        Vgpe = rubvar.Vgpe,
                        Atyp = rubvar.Atyp ?? 0,
                        Scdrub = rubvar.Scdrub,
                        Liba = rubvar.Liba,
                        Abg = rubvar.Liba,
                        InputValue = act?.Inptvalue ?? string.Empty,
                        Aval = act?.Aval,
                        Iraw = act?.Iraw?.ToString() ?? string.Empty,
                        Details = details
                    };
                })
                .ToList();
        }
        else
        {
            foreach (var row in session.RubVarRows)
            {
                if (row.Irub.HasValue && actByRub.TryGetValue(row.Irub.Value, out var act))
                {
                    row.InputValue = act?.Inptvalue ?? row.InputValue;
                    row.Aval = act?.Aval ?? row.Aval;
                    row.Iraw = act?.Iraw?.ToString() ?? row.Iraw;
                }

                row.Details ??= new List<RubFmtRow>();

                foreach (var detRow in row.Details)
                {
                    if (!detRow.Irub.HasValue || !detRow.Ifmt.HasValue)
                        continue;

                    if (detByRubFmt.TryGetValue((detRow.Irub.Value, detRow.Ifmt.Value), out var det))
                    {
                        detRow.InputValue = det?.Inptvalue ?? detRow.InputValue;
                        detRow.Aval = det?.Aval ?? detRow.Aval;
                        detRow.Iraw = det?.Iraw?.ToString() ?? detRow.Iraw;
                    }
                }
            }
        }
    }

    private void BindLocalStateFromSession(SaieSession session)
{
    //var (eddat, efdat) = ResolveRangeForCurrentGroup();

    _calcContext = new CalcContext
    {
        Program = session.Program,
        Tier = session.Tier,
        EnsTbls = session.EnsTbls,
        EnsGrls = InsGpdata,
        SessionDate = SessionDate,
        GroupEddat = GroupOverrideEddat,
        GroupEfdat = GroupOverrideEfdat,
        IsTestMode = false
    };

    _hasUserInput = false;
    _hasCalculated = false;
}

    private CalcContext? BuildSingleContext()
    {
        var tier = PreTiers.FirstOrDefault(t => t.Id == ImyTie);
        var prog = curOrga.Plngens.FirstOrDefault(p => p.Id == curProg.Id);

        if (tier is null || prog is null)
            return null;

        return new CalcContext
        {
            CurOrga = curOrga,
            Program = prog,
            Tier = tier,
            EnsTbls = _saieSession?.EnsTbls ?? new List<Gtabl>(),
            SessionDate = _sessionDate,
            EnsGrls = InsGpdata ?? new List<Gpgrid>(),
            IsTestMode = false
        };
    }

    private async Task OuvrirFiche(int orig)
    {
        isFicheVisible = !isFicheVisible;
        stopenFich = isFicheVisible ? "FermerFiche" : "OuvrirFiche";
        await InvokeAsync(StateHasChanged);
    }

    private async Task<AutoCompleteDataProviderResult<TierspDto>> LoadPreTiers(
        AutoCompleteDataProviderRequest<TierspDto> request)
    {
        var searchText = request.Filter?.Value ?? "";
        IEnumerable<TierspDto> items;

        if (displayMode == DisplayMode.Matricule)
        {
            items = PreTiers
                .Where(t => string.IsNullOrEmpty(searchText) ||
                            t.Xmatri.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                .OrderBy(t => t.Xmatri);
        }
        else
        {
            items = PreTiers
                .Where(t => string.IsNullOrEmpty(searchText) ||
                            t.Nom.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                            t.Pnom.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                            $"{t.Nom} {t.Pnom}".Contains(searchText, StringComparison.OrdinalIgnoreCase))
                .OrderBy(t => t.Nom)
                .ThenBy(t => t.Pnom);
        }

        return await Task.FromResult(new AutoCompleteDataProviderResult<TierspDto>
        {
            Data = items,
            TotalCount = items.Count()
        });
    }
    
    private async Task OnMatriChhanged(TierspDto selected)
    {
        if (selected is null)
            return;

        ImyTie = selected.Id;
        InTSaie = displayMode == DisplayMode.Matricule
            ? selected.Xmatri
            : $"{selected.Nom} {selected.Pnom}";

        await RendsTier(ImyTie);
    }

    private async Task OnTierChanged()
    {
        await RendsTier(ImyTie);
    }

    private string GetTierLabel(TierspDto tie)
    {
        if (displayMode == DisplayMode.Matricule)
            return tie.Xmatri;

        return $"{tie.Nom} - {tie.Pnom} - {tie.Xmatri}";
    }
    private void SyncSessionSaieToGrid(SaieSession session)
    {
        foreach (var act in session.Actsaies)
        {
            var row = session.RubVarRows.FirstOrDefault(r => r.Irub == act.Irub);
            if (row != null)
            {
                row.InputValue = act.Inptvalue ?? row.InputValue;
                row.Aval = act.Aval ?? row.Aval;
                row.Iraw = act.Iraw ?? row.Iraw;
                row.Vgpe = act.Vgpe;
            }
        }

        foreach (var det in session.Actdets)
        {
            var master = session.RubVarRows.FirstOrDefault(r => r.Irub == det.Irub);
            if (master == null) continue;

            var detail = master.Details.FirstOrDefault(d => d.Irub == det.Irub && d.Ifmt == det.Ifmt);
            if (detail != null)
            {
                detail.InputValue = det.Inptvalue ?? detail.InputValue;
                detail.Aval = det.Aval ?? detail.Aval;
                detail.Iraw = det.Iraw ?? detail.Iraw;
                detail.Vgpe = det.Vgpe;
            }
        }
    }
    private async Task HandleLostFocus(FocusEventArgs args)
    {
        if (string.IsNullOrWhiteSpace(InTSaie))
            return;

        if (displayMode == DisplayMode.Matricule && InTSaie.Length >= 5)
        {
            var selected = PreTiers.FirstOrDefault(t =>
                t.Xmatri.Equals(InTSaie, StringComparison.OrdinalIgnoreCase));
            if (selected != null)
            {
                ImyTie = selected.Id;
                await RendsTier(ImyTie);
            }
        }
        else if (displayMode == DisplayMode.Name)
        {
            var selected = PreTiers.FirstOrDefault(t =>
                t.Nom.Equals(InTSaie, StringComparison.OrdinalIgnoreCase) ||
                t.Pnom.Equals(InTSaie, StringComparison.OrdinalIgnoreCase) ||
                $"{t.Nom} {t.Pnom}".Equals(InTSaie, StringComparison.OrdinalIgnoreCase));
            if (selected != null)
            {
                ImyTie = selected.Id;
                await RendsTier(ImyTie);
            }
        }
    }
}