}

<div class="my-container">
    @if (toChild != null)
    {
        @ChildContent
    }
</div>

@if (isLoading)
{
    <div>Loading...</div>
}
else
{
    if (SessOpen)
    {
<div class="d-flex align-items-center gap-2 ms-2">
    <InputRadioGroup @bind-Value="CalcDir" onchange="OnCalcDirChanged" class="d-flex flex-row gap-2">
        <div class="form-check">
            <InputRadio class="form-check-input border-1 border-dark" Value="1" />
            <label class="form-check-label">All</label>
        </div>
        <div class="form-check">
            <InputRadio class="form-check-input border-1 border-dark" Value="2" />
            <label class="form-check-label">From</label>
        </div>
    </InputRadioGroup>

    <InputSelect @bind-Value="Ditie" disabled="@(CalcDir != 2)">
        @foreach (var tie in PreTiers)
        {
            <option value="@tie.Id">@tie.Smatri - @tie.Nom - @tie.Pnom</option>
        }
    </InputSelect>

    <span>To</span>

    <InputSelect @bind-Value="Fitie" disabled="@(CalcDir != 2)">
        @foreach (var tie in PreTiers)
        {
            <option value="@tie.Id">@tie.Smatri - @tie.Nom - @tie.Pnom</option>
        }
    </InputSelect>

</div>


    @* <div class="d-flex align-items-center g-2">
        <InputRadioGroup @bind-Value="CalcDir" onchange="OnCalcDirChanged">
    <div class="col-3">
