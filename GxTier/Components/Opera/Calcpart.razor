</div>
@if (isLoading)
{
    <div>Loading...</div>
}
else
{
    <div class="d-flex align-items-center g-2">
        <InputRadioGroup @bind-Value="CalcDir">
            <div class="col-2">
                <div class="form-check">
                    <InputRadio class="form-check-input border-1 border-dark" Value="1" />
                    <label class="form-check-label">All</label>
                </div>
            </div>
            <div class="col-auto">
                <div class="form-check">
                    <InputRadio class="form-check-input border-1 border-dark" Value="2" />
                    <label class="form-check-label">From</label>
                </div>
            </div>
        </InputRadioGroup>
        <div class="col-auto">
            <InputSelect @bind-Value="Ditie"
                         disabled="@(CalcDir != 2)">
                @foreach (var tie in PreTiers)
                {
                    <option value=@tie.Id>@tie.Smatri - @tie.Nom - @tie.Pnom</option>
                }
            </InputSelect>
        </div>
        <div class="col-auto">
            <span>To</span>
        </div>
        <div class="col-auto">
            <InputSelect @bind-Value="Fitie"
                         disabled="@(CalcDir != 2)">
                @foreach (var tie in PreTiers)
                {
                    <option value=@tie.Id>@tie.Smatri - @tie.Nom - @tie.Pnom</option>
                }
            </InputSelect>
        </div>
    </div>
    <div class="d-flex align-items-center gap-2">
        @if (CanCalc)
        {
            @if (inSaveMode == PendingSaveMode.Immediate)
            {
                @* <Button class="btn btn-sm btn-secondary btn me-2"
                        @onclick="() => OnRunAsync()">
                </Button> *@
            }
            <Button class="btn btn-warning btn-sm me-2" @onclick="() => OuvrirFiche(CalcDir)">@stopenFich</Button>
            <Button class="btn btn-sm btn-secondary btnsz me-2"
                    @onclick="() => OnSaveAsync()">
                Calculer
            </Button>
        }
    </div>
    <!--VISIBLE SAISIE-->
    @if (isFicheVisible)
    {
        <!--VISIBLE SAISIE-->
        @if (isFicheVisible)
        {
            <RtC11Fic @ref="myfcalc"
                      curOrga="@curOrga"
                      toChild="@toChild"
                      _curTier="@_curTier"
                      _EdtODaClient="@_MyODaClient">
                <ChildContent>
                    <h2 class="child-box">Fiche de @curProg.Liba</h2>
                </ChildContent>
            </RtC11Fic>
        }
    }
   @*  <div class="d-flex gap-2 mb-2">
        <button class="btn btn-primary btn-sm" @onclick="OnCalculateGroupAsync" disabled="@isBusy">Calculer</button>
        <button class="btn btn-primary btn-sm" @onclick="OnRunAsync" disabled="@isBusy">Run</button>
        <button class="btn btn-success btn-sm" @onclick="OnSaveAsync" disabled="@isBusy">Save</button>
    </div> *@

    <div class="row">
        <div class="col-md-4">
            <h6>Resdon</h6>
            @foreach (var x in Session.Resdons)
            {
                <div>@x.Ipln - @x.Aval</div>
            }
        </div>
        <div class="col-md-4">
            <h6>Resbro</h6>
            @foreach (var x in Session.Resbros)
            {
                <div>@x.Ipln - @x.Aval</div>
            }
        </div>
        <div class="col-md-4">
            <h6>Resdet</h6>
            @foreach (var x in Session.Resdets)
            {
                <div>@x.Ires - @x.Aval</div>
            }
        </div>
    </div>
}
