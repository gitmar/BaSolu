    private List<ActsaieDto> ActsaieOutputs { get; set; } = new();
    private List<ResdonDto> ResdonOutputs { get; set; } = new();
    private List<ResbroDto> ResbroOutputs { get; set; } = new();
    private List<ResdetDto> ResdetOutputs { get; set; } = new();
    private List<OutDataLineStream> FinalOutputs { get; set; } = new();

