@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public GxorgaDto curOrga { get; set; } = new();
    [Parameter] public ChildVars toChild { get; set; } = new();
    [Parameter] public int ImyDiv { get; set; }
    [Parameter] public int ChxGpe { get; set; }
    [Parameter] public List<TierspDto> PreTiers { get; set; } = new();
    [Parameter] public bool SessOpen { get; set; }

    [Parameter] public IPendingChangesGuard _guard { get; set; }
    [Parameter] public PendingSaveMode inSaveMode { get; set; }

    [Parameter] public SaieSession? SaieSession { get; set; }
    [Parameter] public PlngenDto curProg { get; set; }
    [Parameter] public IODataClient _MyODaClient { get; set; }
    [Parameter] public bool IsTestMode { get; set; }
    [Parameter] public List<Gpgrid> InsGpdata { get; set; }

    [Parameter] public int NbChanges { get; set; }
    [Parameter] public EventCallback<int> NbChangesChanged { get; set; }
    [Parameter] public DateTime _sessionDate { get; set; }
    [Parameter] public DateTime DayDate { get; set; }

    private CalcSession Session { get; set; } = new();
    private bool HasResults => Session.Resdons.Count > 0 || Session.Resbros.Count > 0 || Session.Resdets.Count > 0;
    private bool CanCalc => SessOpen && CalcDir != 0 && ImyDiv != 0 && Ditie != 0 && Fitie != 0;
    private string Imessage = "";

    private List<string> AvailableScdrubs = new();
    private HashSet<string> SelectedScdrubs = new();
    private List<CalcGridRow> PreviewRows = new();
    
    private RtC11Fic myfcalc;
    private TierspDto? _curTier;
    private string stopenFich = "OuvrirFiche";

    // Mode / selection
    private int CalcDir = 1;
    private int Ditie = 0, Fitie = 0;

    // Loading / UI state
    private bool isLoading = true;
    private bool isBusy = false;
    private bool isFicheVisible = false;

    // Tiers sorted by the human-meaningful key (Smatri), Id stays a pure PK — no sync needed.
    //private List<TierspDto> SortedTiers =>
    //    PreTiers.OrderBy(t => t.Smatri, StringComparer.Ordinal).ToList();

    protected override Task OnInitializedAsync()
    {
        isLoading = true;
        //as CalcDir = 1 //tous
        if (PreTiers.Any())
        {
            OnCalcDirChanged(1); //tous
            //Ditie = PreTiers.FirstOrDefault()?.Id ?? 0;
            //Fitie = PreTiers.LastOrDefault()?.Id ?? 0;
        } else 
        {
            Ditie = 0;
            Fitie = 0;
        }
        isLoading = false;
        return Task.CompletedTask;
    }   

    private Task OuvrirFiche(int orig)
    {
        isFicheVisible = !isFicheVisible;
        stopenFich = isFicheVisible ? "FermerFiche" : "OuvrirFiche";
        return Task.CompletedTask;
    }

    // Single unified tier-resolution: CalcDir only changes the filter,
    // never the pipeline — "one person" is just a range/list of size 1.
    private async Task<List<TierspDto>> ResolveSelectedTiers()
    {
        if (CalcDir == 1) // All
            return PreTiers.ToList();

        var from = PreTiers.FirstOrDefault(t => t.Id == Ditie);
        var to = PreTiers.FirstOrDefault(t => t.Id == Fitie);
        if (from is null || to is null)
            return new List<TierspDto>();

        var lo = string.CompareOrdinal(from.Smatri, to.Smatri) <= 0 ? from.Smatri : to.Smatri;
        var hi = string.CompareOrdinal(from.Smatri, to.Smatri) <= 0 ? to.Smatri : from.Smatri;

        return PreTiers
            .Where(t => string.CompareOrdinal(t.Smatri, lo) >= 0
                     && string.CompareOrdinal(t.Smatri, hi) <= 0)
            .ToList();
    }

    
    private void ToggleScdrub(string scdrub, bool isChecked)
    {
        if (isChecked) SelectedScdrubs.Add(scdrub);
        else SelectedScdrubs.Remove(scdrub);
        BuildPreviewRows();
    }
    private async Task<CalcContext?> BuildContextAsync(TierspDto tier, PlngenDto prog)
    {
        var rubvarIds = prog.Rubvars.Select(r => r.Id).ToList();

        // Loads Actsaie/Actdet already produced by Saiepart for this tier,
        // filtered to the session date per Vgpe validity rules (session/moment/always/echeancier).
        var (actsaies, actdets) = await _actsaieData.LoadForTierAsync(
            tier.Id, curOrga.Idorg, _sessionDate, rubvarIds);

        return new CalcContext
        {
            CurOrga = curOrga,
            Idorg = curOrga.Idorg,
            Program = prog,
            Ipln = prog.Id,
            Tier = tier,
            Itie = tier.Id,
            SessionDate = _sessionDate,
            Actsaies = actsaies,
            Actdets = actdets,
            EnsGrls = InsGpdata ?? new List<Gpgrid>(),   // <-- same list, reused for every tier
            IsTestMode = IsTestMode
        };
    }
    private async Task<List<CalcContext>> BuildCalcContextsAsync()
    {
        var prog = curOrga.Plngens.FirstOrDefault(p => p.Id == curProg.Id);
        if (prog is null)
            return new List<CalcContext>();

        var tiers = await ResolveSelectedTiers();
        var contexts = new List<CalcContext>();

        foreach (var t in tiers)
        {
            var ctx = await BuildContextAsync(t, prog);
            if (ctx is not null)
                contexts.Add(ctx);
        }

        return contexts;
    }
    private async Task OnRunAsync()
    {
        var contexts = await BuildCalcContextsAsync();
        if (contexts.Count == 0)
        {
            Imessage = "No tier(s) with input data found for calculation.";
            return;
        }

        isBusy = true;
        Imessage = "";

        var resdons = new List<ResdonDto>();
        var resbros = new List<ResbroDto>();
        var resdets = new List<ResdetDto>();
        _lastContexts = contexts; // kept for OnSaveAsync — see note below

        foreach (var ctx in contexts)
        {
            var incalcSession = new CalcSession { Program = ctx.Program, Tier = ctx.Tier };
            incalcSession = await _programCalculator.RunCalcAsync(ctx, incalcSession);

            resdons.AddRange(incalcSession.Resdons);
            resbros.AddRange(incalcSession.Resbros);
            resdets.AddRange(incalcSession.Resdets);

            // stash per-tier results back so OnSaveAsync can persist per context
            _lastSessionsByTier[ctx.Itie ?? 0] = incalcSession;
        }

        Session = new CalcSession { Resdons = resdons, Resbros = resbros, Resdets = resdets };
        isBusy = false;
        Imessage = $"Calculation completed for {contexts.Count} tier(s).";
    }

    // Kept between Run and Save so Save doesn't have to recompute/re-fetch.
    private List<CalcContext> _lastContexts = new();
    private Dictionary<int, CalcSession> _lastSessionsByTier = new();

    private void LoadAvailableScdrubs(PlngenDto prog)
    {
        var lines = _myLineParser.ParseProgramLines(prog.Fpsrc);
        AvailableScdrubs = lines
            .Where(l => l.LineNumber.HasValue)
            .Select(l => l.LineNumber!.Value.ToString())
            .Distinct()
            .ToList();
    }
    private void BuildPreviewRows()
    {
        if (SelectedScdrubs.Count == 0)
        {
            PreviewRows = new List<CalcGridRow>();
            return;
        }

        PreviewRows = Session.Resdons
            .Where(r => r.Scdrub != null && SelectedScdrubs.Contains(r.Scdrub))
            .Select(r =>
            {
                var tier = PreTiers.FirstOrDefault(t => t.Id == r.Itie);
                return new CalcGridRow
                {
                    Itie = r.Itie ?? 0,
                    Smatri = tier?.Smatri ?? string.Empty,
                    Nom = tier?.Nom ?? string.Empty,
                    Pnom = tier?.Pnom ?? string.Empty,
                    Scdrub = r.Scdrub!,
                    Aval = r.Aval
                };
            })
            .ToList();
    }
    private async Task OnCalcDirChanged(int newValue)
    {
        CalcDir = newValue;
        Ditie = PreTiers.FirstOrDefault()?.Id ?? 0;
        Fitie = PreTiers.LastOrDefault()?.Id ?? 0;
        if (CalcDir == 1)
        {
            await ResolveSelectedTiers(); //ensure all tiers are been selected
        }
    }

    private async Task OnSaveAsync()
    {
        if (!HasResults || _lastContexts.Count == 0)
            return;

        isBusy = true;
        try
        {
            foreach (var ctx in _lastContexts)
            {
                if (_lastSessionsByTier.TryGetValue(ctx.Itie ?? 0, out var incalcSession))
                {
                    await _calcPersistence.TrackCalcChangesAsync(ctx, incalcSession);
                }
            }
            Imessage = "Results saved.";
        }
        finally
        {
            isBusy = false;
        }
    }
}