    }
    <div class="d-flex align-items-center gap-2">
        @if (CanCalc)
        {
            <Button class="btn btn-warning btn-sm me-2" @onclick="() => OuvrirFiche(CalcDir)">@stopenFich</Button>
            <Button class="btn btn-sm btn-secondary btnsz me-2"
                    disabled="@isBusy"
                    @onclick="() => OnRunAsync()">
                Calculer
            </Button>
            <Button class="btn btn-success btn-sm me-2"
                    disabled="@(isBusy || !HasResults)"
                    @onclick="() => OnSaveAsync()">
                Confirmer
            </Button>
        }
    </div>
    <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
        <label>Aperçu (Scdrub) :</label>
        @foreach (var s in AvailableScdrubs)
        {
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox"
                       checked="@SelectedScdrubs.Contains(s)"
                       @onchange="e => ToggleScdrub(s, (bool)e.Value!)" />
                <label class="form-check-label">@s</label>
            </div>
        }
    </div>

    @if (PreviewRows.Count > 0)
    {
        <table class="table table-sm">
            <thead>
                <tr><th>Matricule</th><th>Nom</th><th>Prénom</th><th>Scdrub</th><th>Valeur</th></tr>
            </thead>
            <tbody>
                @foreach (var row in PreviewRows)
                {
                    <tr><td>@row.Smatri</td><td>@row.Nom</td><td>@row.Pnom</td><td>@row.Scdrub</td><td>@row.Aval</td></tr>
