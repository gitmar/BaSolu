    private async Task OnCalculateGroupAsync()
    {
        var contexts = BuildMassContexts();
        if (contexts.Count == 0)
            return;

        isBusy = true;
        CalcSessions = await _workflowService.CalculateCalcAsync(contexts);
        isBusy = false;
    }
    private List<CalcContext> BuildMassContexts()
    {
        var prog = curOrga.Plngens.FirstOrDefault(p => p.Id == curProg.Id);
        if (prog is null)
            return new List<CalcContext>();

        return PreTiers
            .Where(t => t is not null)
            .Select(t => new CalcContext
            {
                CurOrga = curOrga,
                Program = prog,
                Tier = t,
                IsTestMode = false
            })
            .ToList();
    }
    private async Task RunMassCalcAsync()
    {
        var contexts = BuildMassContexts();
        if (contexts.Count == 0)
            return;

        foreach (var ctx in contexts)
        {
            var session = new CalcSession
            {
                Program = ctx.Program,
                Tier = ctx.Tier
            };

            session = await _calcService.RunCalcAsync(ctx, session);
            // await _calcService.SaveCalcAsync(ctx, session);
        }
    }
    private async Task OnRunAsync()
    {
        isBusy = true;
        Session.Program = await LoadProgramAsync(curProg.Id);
        Session.Tier = await LoadTierAsync(Ditie);
        Session = await _calcService.RunCalcAsync(CalcContext, CalcSession);
        isBusy = false;
    }

    private async Task OnSaveAsync()
    {
        // isBusy = true;
        // await _calcService.SaveCalcAsync(CalcContext, CalcSession);
        // isBusy = false;
    }

    private Task<PlngenDto> LoadProgramAsync(int id) => Task.FromResult(new PlngenDto { Id = id });
    private Task<TierspDto> LoadTierAsync(int id) => Task.FromResult(new TierspDto { Id = id });
}
@* @code {
    private bool isLoading = true;
