    private async Task LoadSessionAsync()
    {
        message = "Session loaded.";
        await Task.CompletedTask;
    }

    private async Task RunAllAsync()
    {
        if (Program is null || CurrentTier is null)
        {
            message = "Missing Program or Tier.";
            return;
        }

        isRunning = true;
        message = "Running calculation...";
        ActdetOutputs.Clear();
        ActsaieOutputs.Clear();
        ResdonOutputs.Clear();
        ResbroOutputs.Clear();
        ResdetOutputs.Clear();
        FinalOutputs.Clear();

        try
        {
            var evalContext = BuildContext();
            var rubfmtResult = await EvaluateRubfmtAsync(CurrentTier, evalContext);
            ActdetOutputs.AddRange(rubfmtResult.Actdet);
            Outputs.AddRange(rubfmtResult.OutLines);

            var rubvarResult = await EvaluateRubvarAsync(CurrentTier, evalContext, ActdetOutputs);
            ActsaieOutputs.AddRange(rubvarResult.Actsaie);
            Outputs.AddRange(rubvarResult.OutLines);

            var programResult = await EvaluateProgramAsync(CurrentTier, evalContext, ActsaieOutputs);
            ResdetOutputs.AddRange(programResult.Resdet);
            if (IsTestMode)
                ResbroOutputs.AddRange(programResult.FinalBro);
            else
                ResdonOutputs.AddRange(programResult.FinalDon);

            FinalOutputs.AddRange(programResult.OutLines);

            message = "Calculation completed successfully.";
        }
        catch (Exception ex)
        {
            message = $"Calculation failed: {ex.Message}";
        }
        finally
        {
            isRunning = false;
            StateHasChanged();
        }
    }

    private FormulaEvaluationContext BuildContext()
    {
        return new FormulaEvaluationContext
        {
            Itie = CurrentTier?.Id ?? 0,
            InputData = Inputs,
            PreviousLines = Outputs,
            SessionDate = DateTime.Today
        };
    }

    private Task<(List<ActdetDto> Actdet, List<OutDataLineStream> OutLines)> EvaluateRubfmtAsync(
        TierspDto tier,
        FormulaEvaluationContext context)
    {
        var actdet = new List<ActdetDto>();
        var outLines = new List<OutDataLineStream>();

        foreach (var rubvar in Program?.Rubvars ?? Enumerable.Empty<RubvarDto>())
        {
            foreach (var fmt in rubvar.Rubfmts ?? Enumerable.Empty<RubfmtDto>())
            {
                if (fmt == null)
                    continue;

                var result = EvaluateRubfmtRow(fmt, rubvar, tier, context);
                if (result is null)
                    continue;

                var line = new OutDataLineStream
                {
                    LineNumber = fmt.Scdfmt,
                    SourceFormulaId = fmt.Id,
                    Itie = tier.Id,
                    Etyp = SourceType.Actdet,
                    Scdrub = fmt.Scdrub,
                    Irub = rubvar.Id,
                    Result = result,
                    Ddeb = context.SessionDate,
                    Dfin = context.SessionDate,
                    Trust = result.Trust,
                    EvaluationTime = DateTime.Now
                };

                actdet.Add(new ActdetDto
                {
                    Id = fmt.Id,
                    //Iact = rubvar.Id,
                    Irub = rubvar.Id,
                    Scdrub = fmt.Scdfmt,
                    Ecmount = result.Value,
                    Evala = result.Raw
                });

                outLines.Add(line);
            }
        }

        return Task.FromResult((actdet, outLines));
    }

    private Task<(List<ActsaieDto> Actsaie, List<OutDataLineStream> OutLines)> EvaluateRubvarAsync(
        TierspDto tier,
        FormulaEvaluationContext context,
        List<ActdetDto> actdetInputs)
    {
        var actsaie = new List<ActsaieDto>();
        var outLines = new List<OutDataLineStream>();

        foreach (var rubvar in Program?.Rubvars ?? Enumerable.Empty<RubvarDto>())
        {
            var result = EvaluateRubvarRow(rubvar, tier, context, actdetInputs);
            if (result is null)
                continue;

            var line = new OutDataLineStream
            {
                LineNumber = rubvar.LineNumber,
                SourceFormulaId = rubvar.Id,
                Itie = tier.Id,
                Etyp = SourceType.Actsaie,
                Scdrub = rubvar.Scdrub,
                Irub = rubvar.Id,
                Result = result,
                Ddeb = context.SessionDate,
                Dfin = context.SessionDate,
                Trust = result.Trust,
                EvaluationTime = DateTime.Now
            };

            actsaie.Add(new ActsaieDto
            {
                Id = rubvar.Id,
                Irub = rubvar.Id,
                Scdrub = rubvar.Scdrub,
                Ecmount = result.Value,
                Evala = result.Raw
            });

            outLines.Add(line);
        }

        return Task.FromResult((actsaie, outLines));
    }

    private Task<(List<ResdonDto> FinalDon, List<ResbroDto> FinalBro, List<ResdetDto> Resdet, List<OutDataLineStream> OutLines)> EvaluateProgramAsync(
        TierspDto tier,
        FormulaEvaluationContext context,
        List<ActsaieDto> actsaieInputs)
    {
        var resdon = new List<ResdonDto>();
        var resbro = new List<ResbroDto>();
        var resdet = new List<ResdetDto>();
        var outLines = new List<OutDataLineStream>();

        foreach (var line in Program?.Lines ?? Enumerable.Empty<FormulaLine>())
        {
            if (string.IsNullOrWhiteSpace(line.Formula))
                continue;

            var result = EvaluateProgramLine(line, tier, context, actsaieInputs);
            if (result is null)
                continue;

            if (IsTestMode)
            {
                resbro.Add(new ResbroDto
                {
                    Id = line.Id,
                    LineNumber = line.LineNumber,
                    Scdrub = line.Scdrub,
                    Result = result.Value,
                    Raw = result.Raw
                });
            }
            else
            {
                resdon.Add(new ResdonDto
                {
                    Id = line.Id,
                    LineNumber = line.LineNumber,
                    Scdrub = line.Scdrub,
                    Result = result.Value,
                    Raw = result.Raw
                });
            }

            outLines.Add(new OutDataLineStream
            {
                LineNumber = line.LineNumber,
                SourceFormulaId = line.Id,
                Itie = tier.Id,
                Etyp = IsTestMode ? TableType.Resbro : TableType.Resdon,
                Scdrub = line.Scdrub,
                Irub = line.Irub,
                Result = result,
                Ddeb = context.SessionDate,
                Dfin = context.SessionDate,
                Trust = result.Trust,
                EvaluationTime = DateTime.Now
            });

            if (line.SaveDetail)
            {
                resdet.Add(new ResdetDto
                {
                    Id = line.Id,
                    LineNumber = line.LineNumber,
                    Scdrub = line.Scdrub,
                    Raw = result.Raw
                });
            }
        }

        return Task.FromResult((resdon, resbro, resdet, outLines));
    }

    private FormulaResult? EvaluateRubfmtRow(RubfmtDto row, RubvarDto parent, TierspDto tier, FormulaEvaluationContext context)
    {
        if (row.Mode == RubfmtMode.Input)
        {
            return new FormulaResult
            {
                Value = row.InputValue,
                Raw = row.InputValue?.ToString(),
                Type = _myFEngine.ResolveType(row.Atyp ?? 0),
                Trust = TrustLevel.Valid
            };
        }

        if (row.Mode == RubfmtMode.Constant)
        {
            return new FormulaResult
            {
                Value = row.DefaultValue,
                Raw = row.DefaultValue?.ToString(),
                Type = _myFEngine.ResolveType(row.Atyp ?? 0),
                Trust = TrustLevel.Valid
            };
        }

        return _myFEngine.EvaluateFormula(row.Ftsrc, context);
    }

    private FormulaResult? EvaluateRubvarRow(RubvarDto row, TierspDto tier, FormulaEvaluationContext context, List<ActdetDto> actdetInputs)
    {
        if (row.IsInputOnly)
        {
            return new FormulaResult
            {
                Value = row.InputValue,
                Raw = row.InputValue?.ToString(),
                Type = _myFEngine.ResolveType(row.Atyp ?? 0),
                Trust = TrustLevel.Valid
            };
        }

        if (row.IsExternalValue)
        {
            return new FormulaResult
            {
                Value = row.ExternalValue,
                Raw = row.ExternalValue?.ToString(),
                Type = _myFEngine.ResolveType(row.Atyp ?? 0),
                Trust = TrustLevel.Valid
            };
        }

        return _myFEngine.EvaluateFormula(row.Frsrc, context);
    }

    private FormulaResult? EvaluateProgramLine(FormulaLine line, TierspDto tier, FormulaEvaluationContext context, List<ActsaieDto> actsaieInputs)
    {
        return _myFEngine.EvaluateFormula(line.Formula, context);
    }

    private Task SaveResultsAsync()
    {
        message = "Results saved.";
        return Task.CompletedTask;
    }

    private void ToggleDetails()
    {
        showDetails = !showDetails;
    }
} *@