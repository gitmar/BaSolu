<PageTitle>Saisie Offline</PageTitle>
<div>
    @Imessage
</div>
<div class="my-container">
    @if (toChild != null)
    {
        @ChildContent
    }
</div>
<!--tiers/search et/ou creation? -->
@if (isLoading)
{
    <div class="text-center">
        <Spinner Color="SpinnerColor.Primary" Size="SpinnerSize.Medium" />
        <p>Calculs/Calcul Loading...</p>
    </div>
}
else
{
    <div class="d-flex align-items-center g-2">
        <InputRadioGroup @bind-Value="CalcDir">
            <div class="col-2">
                <div class="form-check">
                    <InputRadio class="form-check-input border-1 border-dark" Value="1" />
                    <label class="form-check-label">All</label>
                </div>
            </div>
            <div class="col-auto">
                <div class="form-check">
                    <InputRadio class="form-check-input border-1 border-dark" Value="2" />
                    <label class="form-check-label">From</label>
                </div>
            </div>
        </InputRadioGroup>
        <div class="col-auto">
            <InputSelect @bind-Value="IdebTier"
                         disabled="@(CalcDir != 2)">
                @foreach (var tie in PreTiers)
                {
                    <option value=@tie.Smatri>@tie.Smatri - @tie.Nom - @tie.Pnom</option>
                }
            </InputSelect>
        </div>
        <div class="col-auto">
            <span>To</span>
        </div>
        <div class="col-auto">
            <InputSelect @bind-Value="IfinTier"
                         disabled="@(CalcDir != 2)">
                @foreach (var tie in PreTiers)
                {
                    <option value=@tie.Smatri>@tie.Smatri - @tie.Nom - @tie.Pnom</option>
                }
            </InputSelect>
        </div>
    </div>
    <div class="d-flex align-items-center g-2">
            @if (CanCalc)
            {
                <Button class="btn btn-sm btn-secondary btnsz me-2"
                        @onclick="() => CalcDraftAsync()">
                    Calculer
                </Button>
                @if (CalcMarked && autoSave)
                {
                    <Button class="btn btn-sm btn-secondary btn me-2"
                            @onclick="() => SaveResultAsync()">
                        
                    </Button>
                }
                <Button class="btn btn-warning btn-sm me-2" @onclick="() => OuvrirFiche(CalcDir)">@stopenFich</Button>
            }
    </div>
}
<!--Actsaie Portrait-->
@if (!isLoading)
{
    <!--VISIBLE SAISIE-->
@if (isFicheVisible)
{
        <!--VISIBLE SAISIE-->
        @if (isFicheVisible)
        {
            <RtC11Fic @ref="myfcalc"
                      curOrga="@curOrga"
                      toChild="@toChild"
                      CalcTiers="@CalcTiers"
                      _EdtODaClient="@_InODaClient">
                <ChildContent>
                    <h2 class="child-box">Fiche de @curProg.Liba</h2>
                </ChildContent>
            </RtC11Fic>
        }
}
    <div class="d-flex flex-row">
       <div class="p-1" style="max-height: 400px; overflow-y: auto;">
                    <Grid TItem="CalcGridRow"
                          Data="@CalcGridRows"
                          AllowFiltering="@isFilteringEnabled"
                          AllowPaging="true"
                          Responsive="true">
                        <GridColumns>
                        <GridColumn TItem="CalcGridRow" HeaderText="No">
                                <ChildContent Context="item">@item.Id</ChildContent>
                            </GridColumn>
                        <GridColumn TItem="CalcGridRow" HeaderText="Matricule">
                                @* IsVisible="@(ImyOpti == 2)"> *@
                                <ChildContent Context="item">@item.Smatri</ChildContent>
                            </GridColumn>
                        <GridColumn TItem="CalcGridRow" HeaderText="Nom">
                                @* IsVisible="@(ImyOpti == 2)"> *@
                                <ChildContent Context="item">@item.Nom</ChildContent>
                            </GridColumn>
                            <GridColumn TItem="CalcGridRow" HeaderText="PNom">
                                @* IsVisible="@(ImyOpti == 2)"> *@
                                <ChildContent Context="item">@item.Pnom</ChildContent>
                            </GridColumn>
                            <GridColumn TItem="CalcGridRow" HeaderText="Code"> @* IsVisible="@(ImyOpti == 1)"> *@
                                <ChildContent Context="item">@item.LineNumber</ChildContent>
                            </GridColumn>
                            <GridColumn TItem="CalcGridRow" HeaderText="Designation"> @* IsVisible="@(ImyOpti == 1)"> *@
                                <ChildContent Context="item">@item.Liba</ChildContent>
                            </GridColumn>
                            <GridColumn TItem="CalcGridRow" HeaderText="MtCalcule">
                                <ChildContent Context="item">
                                    @item.Result
                                </ChildContent>
                            </GridColumn>
                        </GridColumns>
                    </Grid>
                </div>
    </div>
}
<style>
