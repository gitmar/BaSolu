        _templateLines = FormulaLoader.LoadFormulaSet(infpscr, orig);
    }

    private List<InDataLineStream> BuildInputsForTier(TierspDto tie)
    {
        var inputs = new List<InDataLineStream>();

        foreach (var act in tie.Actsaies)
        {
            LineType vtyp = LineType.String;

            inputs.Add(new InDataLineStream
            {
                Itie = tie.Id,
                Etyp = TableType.Actsaie,
                Scdrub = act.Scdrub,
                Irub = act.Irub ?? 0,
                Vtyp = _myFEngine.ResolveType(act.Atyp ?? 0),
                Result = new FormulaResult
                {
                    Value = act.Ecmount,
                    Raw = act.Ecmount?.ToString(),
                    Type = _myFEngine.ResolveType(act.Atyp ?? 0),
                }
            });
        }

        foreach (var res in tie.Resdons)
        {
            inputs.Add(new InDataLineStream
            {
                Itie = tie.Id,
                Etyp = TableType.Resdon,
                Scdrub = res.Scdrub,
                Irub = res.Irub ?? 0,
                Vtyp = _myFEngine.ResolveType(res.Atyp ?? 0),
                Result = new FormulaResult
                {
                    Value = res.Evala,
                    Raw = res.Evala?.ToString(),
                    Type = _myFEngine.ResolveType(res.Atyp ?? 0)
                }
            });
        }

        return inputs;
    }
    private FormulaSession CreateSession(TierspDto tie)
    {
        return new FormulaSession
        {
            Itie = tie.Id,
            SessionDate = DateTime.Today,
            Inputs = BuildInputsForTier(tie),
            Lines = new List<FormulaLine>(_templateLines)
        };
    }
