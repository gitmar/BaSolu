</div>
<!--tiers/search et/ou creation? -->
@if (isLoading)
{
    <div class="text-center">
        <Spinner Color="SpinnerColor.Primary" Size="SpinnerSize.Medium" />
        <p>Calculs/Calcul Loading...</p>
    </div>
}
else
{
    <div class="d-flex align-items-center g-2">
        <InputRadioGroup @bind-Value="SaieDir">
            <div class="col-2">
                <div class="form-check">
                    <InputRadio class="form-check-input border-1 border-dark" Value="1" />
                    <label class="form-check-label">All</label>
                </div>
            </div>
            <div class="col-auto">
                <div class="form-check">
                    <InputRadio class="form-check-input border-1 border-dark" Value="2" />
                    <label class="form-check-label">From</label>
                </div>
            </div>
        </InputRadioGroup>
        <div class="col-auto">
            <InputSelect @bind-Value="IdebTier"
                         disabled="@(SaieDir != 2)">
                @foreach (var tie in PreTiers)
                {
                    <option value=@tie.Smatri>@tie.Smatri - @tie.Nom - @tie.Pnom</option>
                }
            </InputSelect>
        </div>
        <div class="col-auto">
            <span>To</span>
        </div>
        <div class="col-auto">
            <InputSelect @bind-Value="IfinTier"
                         disabled="@(SaieDir != 2)">
                @foreach (var tie in PreTiers)
                {
                    <option value=@tie.Smatri>@tie.Smatri - @tie.Nom - @tie.Pnom</option>
                }
            </InputSelect>
        </div>
    </div>
    <div class="d-flex align-items-center g-2">
        @if (CanSaie)
        {
            <Button class="btn btn-sm btn-secondary btnsz me-2"
                    @onclick="() => CalcDraftAsync()">
                Calculer
            </Button>
            @if (CalcMarked && autoSave)
            {
                <Button class="btn btn-sm btn-secondary btn me-2"
                        @onclick="() => SaveResultAsync()">
                </Button>
            }
            <Button class="btn btn-warning btn-sm me-2" @onclick="() => OuvrirFiche(SaieDir)">@stopenFich</Button>
        }
    </div>
}
<!--Actsaie Portrait-->
@if (!isLoading)
{
    <!--VISIBLE SAISIE-->
    @if (isFicheVisible)
    {
        <!--VISIBLE SAISIE-->
        @if (isFicheVisible)
        {
            <RtS11Fic @ref="myfsaie"
                      curOrga="@curOrga"
                      toChild="@toChild"
                      _curTier="@_curTier"
                      _EdtODaClient="@_InODaClient">
                <ChildContent>
                    <h2 class="child-box">Fiche de @curProg.Liba</h2>
                </ChildContent>
            </RtS11Fic>
        }
    }
    <div class="d-flex flex-row">
        <div class="p-1" style="max-height: 400px; overflow-y: auto;">
            <Grid TItem="RubGridRow"
                  Data="@RubGridRows"
                  AllowFiltering="@isFilteringEnabled"
                  AllowPaging="true"
                  Responsive="true">
                <GridColumns>
                    <GridColumn TItem="RubGridRow" HeaderText="No">
                        <ChildContent Context="item">@item.Id</ChildContent>
                    </GridColumn>
                    <GridColumn TItem="RubGridRow" HeaderText="Code">
                        <ChildContent Context="item">@item.Scdrub</ChildContent>
                    </GridColumn>
                    <GridColumn TItem="RubGridRow" HeaderText="Designation">
                        <ChildContent Context="item">@item.Liba</ChildContent>
                    </GridColumn>
                    <GridColumn TItem="RubGridRow" HeaderText="Abrege">
                        <ChildContent Context="item">@item.Abg</ChildContent>
                    </GridColumn>
                    <GridColumn TItem="RubGridRow" HeaderText="MtCalcule">
                        <ChildContent Context="item">@item.CalcValue</ChildContent>
                    </GridColumn>
                    <GridColumn TItem="RubGridRow" HeaderText="MtSaisie">
                        <ChildContent Context="item">
                            <ValidatedInput Atyp="2"
                                            @bind-Value="item.InputValue"
                                            ErrorMessage="Please enter a valid integer"
                                            OnValidInput="val => HandleValidInput(item, val)" />
                        </ChildContent>
                    </GridColumn>
                </GridColumns>
                <GridDetailView TItem="RubGridRow">
                    <div class="p-2">
                        <h6 class="mb-2">Détails Rubfmt</h6>
                        <Grid TItem="RubFmtRow"
                              Data="@RubFmtRows"
                              AllowFiltering="false"
                              AllowPaging="false"
                              Responsive="true">
                            <GridColumns>
                                <GridColumn TItem="RubFmtRow" HeaderText="Code">
                                    <ChildContent Context="f">@f.Scdfmt</ChildContent>
                                </GridColumn>
                                <GridColumn TItem="RubFmtRow" HeaderText="Designation">
                                    <ChildContent Context="f">@f.Liba</ChildContent>
                                </GridColumn>
                                <GridColumn TItem="RubFmtRow" HeaderText="MtSaisie">
                                    <ChildContent Context="f">
                                        <ValidatedInput Atyp="2"
                                                        @bind-Value="f.InputValue"
                                                        ErrorMessage="Please enter a valid integer"
                                                        OnValidInput="val => HandleRubfmtInput(context, f, val)" />
                                        @* OnValidInput="val => HandleRubfmtInput(context, f, val)" *@
                                    </ChildContent>
                                </GridColumn>
                                <GridColumn TItem="RubFmtRow" HeaderText="MtCalc">
                                    <ChildContent Context="f">@f.CalcValue</ChildContent>
                                </GridColumn>
                            </GridColumns>
                        </Grid>
                    </div>
                </GridDetailView>
            </Grid>
        </div>
    </div>
}
<style>
    .inputfl {
