    private List<InDataLineStream> BuildInputsForTier(TierspDto tie)
    {
        var inputs = new List<InDataLineStream>();
        inputs.AddRange(BuildInputs(
            tie,
            tie.Actsaies,
            TableType.Actsaie,
            act => act.Scdrub,
            act => act.Irub,
            act => act.Atyp,
            act => act.Ecmount));

        inputs.AddRange(BuildInputs(
            tie,
            tie.Resdons,
            TableType.Resdon,
            res => res.Scdrub,
            res => res.Irub,
            res => res.Atyp,
            res => res.Evala));

        return inputs;
    }

    private IEnumerable<InDataLineStream> BuildInputs<T>(
        TierspDto tie,
        IEnumerable<T> items,
        TableType etyp,
        Func<T, string?> scdrubSelector,
        Func<T, int?> irubSelector,
        Func<T, int?> atypSelector,
        Func<T, object?> valueSelector)
    {
        foreach (var item in items)
        {
            var type = _myFEngine.ResolveType(atypSelector(item) ?? 0);
            var value = valueSelector(item);

            yield return new InDataLineStream
            {
                Itie = tie.Id,
                Etyp = etyp,
                Scdrub = scdrubSelector(item),
                Irub = irubSelector(item) ?? 0,
                Vtyp = type,
                Result = new FormulaResult
                {
                    Value = value,
                    Raw = value?.ToString(),
                    Type = type
                }
            };
        }
    }
