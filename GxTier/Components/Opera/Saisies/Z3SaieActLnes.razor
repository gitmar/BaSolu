        @ChildContent
    }
</div>
<!--tiers/search et/ou creation? -->
@if (isLoading)
{
    <div class="text-center">
        <Spinner Color="SpinnerColor.Primary" Size="SpinnerSize.Medium" />
        <p>Saisies/Saisie Loading...</p>
    </div>
}
@if (!isLoading)
{
    <div class="d-flex align-items-center g-2">
        <InputRadioGroup @bind-Value="SaieDir">
            <div class="col-2">
                <div class="form-check">
                    <InputRadio class="form-check-input border-1 border-dark" Value="1" />
                    <label class="form-check-label">Personne</label>
                </div>
            </div>
            <div class="col-2">
                <div class="form-check">
                    <InputRadio class="form-check-input border-1 border-dark" Value="2" />
                    <label class="form-check-label">Rubrique</label>
                </div>
            </div>
        </InputRadioGroup>
    </div>
        @if (CanSaie)
        {
            <div class="d-flex align-items-center gap-2">
                <Button class="btn btn-sm btn-secondary btnsz"
                        style="@(!allEnable ? "" : "display:none;")"
                        @onclick="() => PrepOpeSaie(SaieDir)">
                    OuvrirSaisie 
                </Button>
                @if (FinPreparer == true)
                {
                    <!--en saisie et peut soumettre a save
                        et peut revenir continuer a saisir 
                        et a saved -->
                    <Button class="btn btn-sm btn-secondary btnsz"
                            style="@(!allEnable ? "" : "display:none;")"
                        @onclick="() => CalcAndSaveAsync()">
                        Enregistrer
                    </Button>
                }
            <button class="btn btn-warning btn-sm" @onclick="() => OuvrirFiche(SaieDir)">@stopenFich</button>
        </div>
        }
}
<!--Actsaie Portrait-->
@if (!isLoading)
{
