                <h2 class="child-box">Fiche de @curProg.Liba</h2>
            </ChildContent>
        </RtS11Fic>
    }
        <div class="d-flex flex-row">
            <EditForm Context="invform" Model="curOrga">
                <DataAnnotationsValidator />
                <ValidationSummary />
            <div class="p-1" style="max-height: 400px; overflow-y: auto;">
               @if (SaieDir == 2)
                { // par rubrique
                    <InputSelect @bind-Value="ImyRubr"
                                 disabled="@(SaieDir != 2)">
                        @foreach (var rub in PreRubs)
                        {
                            <option value=@rub.Id>@rub.Scdrub</option>
                        }
                    </InputSelect>
                    <InputSelect @bind-Value="ImyRubr"
                                 disabled="@(SaieDir != 2)">
                        @foreach (var rub in PreRubs)
                        {
                            <option value=@rub.Id>@rub.Abg - @rub.Liba</option>
                        }
                    </InputSelect>
                    <Grid TItem="FormulaLine"
                    Data="@MissionLines"
                    AllowFiltering="@isFilteringEnabled"
                    AllowPaging="true"
                    Responsive="true">
                        <GridColumns>
                            <GridColumn TItem="FormulaLine" HeaderText="No">
                                <ChildContent Context="item">@item.Id</ChildContent>
                            </GridColumn>
                          @* <GridColumn TItem="FormulaLine" HeaderText="Matricule">
                              <ChildContent Context="item">@item.Smatri</ChildContent>
                          </GridColumn>
                          <GridColumn TItem="FormulaLine" HeaderText="Nom">
                              <ChildContent Context="item">@item.Nom</ChildContent>
                          </GridColumn>
                          <GridColumn TItem="FormulaLine" HeaderText="PNom">
                              <ChildContent Context="item">@item.Pnom</ChildContent>
                          </GridColumn> *@
                            @* <GridColumn TItem="FormulaLine" HeaderText="Code" IsVisible="@(ImyOptRT == 1)">
                                <ChildContent Context="item">@item.LineNumber</ChildContent>
                            </GridColumn>
                            <GridColumn TItem="FormulaLine" HeaderText="Designation" IsVisible="@(ImyOptRT == 1)">
                                <ChildContent Context="item">@item.Liba</ChildContent>
                            </GridColumn> *@
                            <GridColumn TItem="FormulaLine" HeaderText="MtCalcule">
                                <ChildContent Context="item">
                                    @item.Result
                                </ChildContent>
                            </GridColumn>
                            <GridColumn TItem="FormulaLine" HeaderText="MtSaisie">
                                <ChildContent Context="item">
                                    <ValidatedInput Atyp="2"
                                    @bind-Value="item.Rsaie"
                                    ErrorMessage="Please enter a valid integer"
                                    OnValidInput="val => HandleValidInput(item, val)" />
                                </ChildContent>
                            </GridColumn>
                        </GridColumns>
                    </Grid>
                }
                else
                { // par personne
                    <div class="d-flex align-items-center gap-2">
                        <InputSelect @bind-Value="ImyTier"
                                disabled="@(SaieDir != 1)">
                            @foreach (var tie in PreTiers)
                            {
                                <option value=@tie.Id>@tie.Smatri</option>
                            }
                        </InputSelect>
                        <InputSelect @bind-Value="ImyTier"
                                     disabled="@(SaieDir != 1)">
                            @foreach (var tie in PreTiers)
                            {
                                <option value=@tie.Id>@tie.Nom - @tie.Pnom</option>
                            }
                        </InputSelect>
                    </div>
                    <Grid TItem="FormulaLine"
                    Data="@MissionLines"
                    AllowFiltering="@isFilteringEnabled"
                    AllowPaging="true"
                    Responsive="true">
                        <GridColumns>
                            <GridColumn TItem="FormulaLine" HeaderText="No">
                                <ChildContent Context="item">@item.Id</ChildContent>
                            </GridColumn>
                            <GridColumn TItem="FormulaLine" HeaderText="Code">
                                <ChildContent Context="item">@item.LineNumber</ChildContent>
                            </GridColumn>
                            @* <GridColumn TItem="FormulaLine" HeaderText="Abrege">
                                <ChildContent Context="item">@item.Abg</ChildContent>
                            </GridColumn>
                            <GridColumn TItem="FormulaLine" HeaderText="Designation">
                                <ChildContent Context="item">@item.Liba</ChildContent>
                            </GridColumn> *@
                            <GridColumn TItem="FormulaLine" HeaderText="MtCalcule">
                                <ChildContent Context="item">
                                    @item.Rresu
                                </ChildContent>
                            </GridColumn>
                            <GridColumn TItem="FormulaLine" HeaderText="MtSaisie">
                                <ChildContent Context="item">
                                    <ValidatedInput Atyp="2"
                                    @bind-Value="item.Rsaie"
                                    ErrorMessage="Please enter a valid integer"
                                    OnValidInput="val => HandleValidInput(item, val)" />
                                </ChildContent>
                            </GridColumn>
                        </GridColumns>
                    </Grid>
                }
            </div>
            </EditForm>
        </div>
    }
