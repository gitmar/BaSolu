    private async Task PrepOpeSaie(int opt)
    { //preparation
        CalcLines.Clear();
        FinPreparer = false;
        SaieTiers = PreTiers;
        if (opt == 1)
        { //par personne/_curTier <-- ONE LINE PARSING
            foreach (var uru in PreRubs)
            {
                //var saielines = FormulaResolver.FormulaParser.ParseFormulaBlock(uru.Frsrc, _rubvarResolver);
                //_calcService.SetLineTable(saielines);
                //var saielines = FormulaParser.ParseFormulaBlock(uru.Frsrc, _rubvarResolver);
                //var parsedLine = FormulaService.EvaluateWithLog(uru);
                //var parsedLine = saielines.FirstOrDefault(l => l.LineNumber == Convert.ToInt32(uru.Scdrub));
                //var rubvar = FormulaResolver.ResolveScdrub(Convert.ToInt32(uru.Scdrub));

                SaieLnes.Add(new FormulaLine
                {
                    Irub = uru?.Id ?? 0,
                    Scdrub = uru?.Scdrub ?? uru.Scdrub,
                    LineNumber = uru?.Scdrub,
                    Itie = _curTier.Id,
                    ///Liba = uru?.Liba ?? "",
                    ///Abg = uru?.Abg ?? "",
                    ///Nom = _curTier.Nom,
                    ///Pnom = _curTier.Pnom,
                    //Formula = uru.Frsrc ?? "",
                    //Formula = parsedLine?.Formula ?? "", // ✅ critical
                    Rresu = "",
                    Rsaie = ""
                });
            }
        }
        if (opt == 2)
        { //par rubrique/_curRub --> MULTILINES PARSING
            //var saielines = orgRubsFormulaParser.ParseFormulaBlock(_curRub.Frsource, _rubvarResolver);
            //_calcService.SetLineTable(saielines);

            foreach (var tie in SaieTiers)
            {
                foreach (var uru in PreRubs)
                {
