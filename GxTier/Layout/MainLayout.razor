@inherits LayoutComponentBase

@using System.Text.RegularExpressions
@using Blazored.LocalStorage
@using GxTie.Services
@using GxShared.Identity
@using GxShared.Helpers
@using GxShared.Others
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

@inject ILocalStorageService _localStorage
@inject IConfiguration _iconfig
@inject NavigationManager _navManager
@inject SessionContextService _sessionContext
@inject MyAuthStateProvider _authProvider
@inject IHttpClientFactory  _httpClientFactory
@inject ClieAppState _appState
@inject IJSRuntime _JsRun

@if (_layoutReady)
{
    <div class="page-wrapper @(_sidebarCollapsed ? "sidebar-collapsed" : "")">

        <!-- SIDEBAR -->
        <div class="sidebar">
            <NavMenu />
        </div>

        <!-- MAIN -->
        <div class="main-content-wrapper d-flex flex-column">

            <!-- ================= TOP BAR ================= -->
            <div class="bg-light border-bottom">
                <div class="d-flex align-items-center px-3 py-2 flex-nowrap" style="min-width: 0;">

                    <!-- SIDEBAR TOGGLE -->
                    @* <button class="btn btn-sm btn-outline-secondary me-2 flex-shrink-0"
                            @onclick="ToggleSidebar"
                            title="Toggle sidebar">
                        <span class="bi @(_sidebarCollapsed ? "bi-chevron-right" : "bi-chevron-left")"></span>
                    </button> *@
                    <button class="sidebar-toggle btn btn-sm p-1 m-0 border-0 shadow-none"
                            type="button"
                            @onclick="ToggleSidebar"
                            aria-label="Toggle sidebar">
                        <span></span>
                        <span></span>
                        <span></span>
                    </button>
                    <!-- LEFT GROUP -->
                    <div class="d-flex align-items-center flex-nowrap gap-2" style="min-width: 0;">
                        <AuthorizeView>
                            <Authorized>
                                <span>&nbsp;&nbsp;&nbsp;</span>
                                <button class="btn btn-sm fw-bold text-dark m-0 p-0 flex-shrink-0"
                                    @onclick="NavigateToIdentityPage">
                                        PrivateRoom
                                </button>
                                <div class="d-flex align-items-center gap-2 flex-nowrap" style="min-width: 0;">
                                    <div class="truncated-text">
                                        @_appState.ogRaison
                                    </div>

                                    <div class="truncated-text text-muted">
                                        @_appState.usFulnom
                                    </div>
                                </div>
                            </Authorized>
                        </AuthorizeView>
                    </div>

                    <!-- RIGHT SIDE -->
                    <div class="ms-auto d-flex align-items-center gap-3 flex-shrink-0">
                        <label class="mb-0">Help ?</label>

                        <AuthorizeView>
                            <Authorized>
                                <a href="logout">
                                    <span class="bi bi-door-closed-fill" style="vertical-align:middle"></span>
                                    Logout
                                </a>
                            </Authorized>
                            <NotAuthorized>
                                <a href="login">
                                    <span class="bi bi-door-open" style="vertical-align:middle"></span>
                                    Login
                                </a>
                            </NotAuthorized>
                        </AuthorizeView>
                    </div>
                </div>

                <!-- USER MENU BELOW BAR -->
                <AuthorizeView>
                    <Authorized>
                        @if (collapseUserMenu)
                        {
                            @* <div class="px-3 py-2 border-top bg-white">
                                <UsrMenu />
                            </div> *@
                        }
                    </Authorized>
                </AuthorizeView>
            </div>
            <!-- ================= END TOP BAR ================= -->
            <!-- ================= MAIN CONTENT ================= -->
            <main class="flex-fill overflow-auto">
                <article class="content px-4">
                    @Body
                </article>
            </main>
        </div>
    </div>
}
else
{
    <div class="d-flex justify-content-center align-items-center" style="height: 100vh;">
        <span>Loading session...</span>
    </div>
}

<style>
    .page-wrapper {
        display: flex;
        height: 100vh;
        min-width: 0;
    }

    .sidebar {
        width: 250px;
        background: linear-gradient(180deg, rgb(5, 39, 103) 0%, #3a0647 70%);
        overflow: hidden;
        transition: width 0.25s ease, opacity 0.25s ease;
        flex-shrink: 0;
    }

    .page-wrapper.sidebar-collapsed .sidebar {
        width: 0;
        opacity: 0;
    }

        .page-wrapper.sidebar-collapsed .sidebar * {
            pointer-events: none;
        }

    .main-content-wrapper {
        flex: 1;
        min-width: 0;
    }

    .truncated-text {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 180px;
        min-width: 0;
        display: block;
    }

    .flex-nowrap {
        flex-wrap: nowrap;
    }

    .sidebar-toggle {
        width: 34px;
        height: 28px;
        display: inline-flex;
        flex-direction: column;
        justify-content: center;
        gap: 4px;
        background: transparent;
    }

        .sidebar-toggle span {
            display: block;
            width: 18px;
            height: 2px;
            background-color: black;
            border-radius: 3px;
    }
    </style>

@code {
    private bool _layoutReady = false;
    private bool isLoading = false;

    private bool collapseUserMenu = false;
    private bool canAdminLog = false;

    private bool isHelpLogin = false;
    private ClaimsPrincipal authUser = new ClaimsPrincipal();
    private bool isAuthenticated = false;
    private HttpClient _apiClient = new HttpClient(); // Initialize the HttpClient

    private bool _sidebarCollapsed = true;

    //private AuthenticationStateChangedEventHandler? _authStateChangedHandler;
    private AuthenticationStateChangedHandler? _authStateChangedHandler;
    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("[MainLayout] 1. Initialization started");

        canAdminLog = false;
        isLoading = false;

        _apiClient = _httpClientFactory.CreateClient("AUTHClient");
        _appState.OnChange += StateHasChanged;

        Console.WriteLine("[MainLayout] 2. Before reading local storage");

        try
        {
            var token = await _localStorage.GetItemAsync<string>("blazToken");

            Console.WriteLine(
                $"[MainLayout] 3. Local storage returned. Token exists: {!string.IsNullOrWhiteSpace(token)}");

            if (string.IsNullOrWhiteSpace(token))
            {
                Console.WriteLine("[MainLayout] No token found — skipping session sync.");
                _layoutReady = true;
                return;
            }

            Console.WriteLine("[MainLayout] 4. Before SessionContext.InitializeAsync");

            await _sessionContext.InitializeAsync();

            Console.WriteLine("[MainLayout] 5. SessionContext initialized");

            var authState = await _authProvider.GetAuthenticationStateAsync();

            Console.WriteLine("[MainLayout] 6. Authentication state retrieved");

            authUser = authState.User;
            isAuthenticated = authUser.Identity?.IsAuthenticated ?? false;

            if (!isAuthenticated)
            {
                Console.WriteLine("[MainLayout] Authentication failed");
                await _authProvider.NotifyUserLogout();
            }
            else
            {
                canAdminLog =
                    authUser.IsInRole("Support") ||
                    authUser.IsInRole("Admin") ||
                    authUser.IsInRole("Developper");

                Console.WriteLine("[MainLayout] Authentication succeeded");
            }

            _authStateChangedHandler = task =>
            {
                _ = HandleAuthStateChangedAsync(task);
            };

            _authProvider.AuthenticationStateChanged += _authStateChangedHandler;

            Console.WriteLine("[MainLayout] 7. Initialization completed");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Initialization error: {ex}");
        }
        finally
        {
            _layoutReady = true;
            isLoading = false;

            Console.WriteLine("[MainLayout] Initialization finished");
        }
    }

    private void ToggleSidebar()
    {
        _sidebarCollapsed = !_sidebarCollapsed;
    }

    
    private async Task HandleAuthStateChangedAsync(Task<AuthenticationState> task)
    {
        var authState = await task;
        authUser = authState.User;
        isAuthenticated = authUser.Identity?.IsAuthenticated ?? false;
        await InvokeAsync(StateHasChanged);
    }
    private async Task NavigateToIdentityPage()
    {
        var currentUri = new Uri(_navManager.Uri);

        // Identity returnUrl (local path, safe for Identity redirect)
        var returnUrl = currentUri.PathAndQuery;

        // Full WASM origin (used later in Manage page "Return" button)
        var clientReturnUrl = currentUri.GetLeftPart(UriPartial.Authority);

        var request = new BridgeRequest
        {
            ReturnUrl = currentUri.PathAndQuery,              // local path for Identity
            ClientReturnUrl = currentUri.GetLeftPart(UriPartial.Authority) // full WASM origin
        };

        var resp = await _apiClient.PostAsJsonAsync("Authbridge/ticket", request);
        resp.EnsureSuccessStatusCode();

        var result = await resp.Content.ReadFromJsonAsync<TicketResult>();

        // Navigate to the ticket URL (signin endpoint)
        _navManager.NavigateTo(result!.Url, forceLoad: true);
    }

    
    public void Dispose()
    {
        _appState.OnChange -= StateHasChanged;

        if (_authStateChangedHandler is not null)
        {
            _authProvider.AuthenticationStateChanged -= _authStateChangedHandler;
        }
    }
}
